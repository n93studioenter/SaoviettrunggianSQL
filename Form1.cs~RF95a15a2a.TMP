        public void SetIsImport2()
        {
            BindingList<FileImport> bdList = chkDauvao.Checked ? lstImportVao : lstImportRa;
            if (bdList.Count > 0)
            {
                //Cập nhật lại cho tất cả hoá đơn IsImport=0
                string query = @"UPDATE tbimport SET  IsImport =?";
                var parameters = new OleDbParameter[]
                 {
                        new OleDbParameter("?","0")
                 };
                int rowsAffected = ExecuteQueryResult(query, parameters);

                //Cập nhật cho các hoá đơn dc check
                foreach(var item in bdList)
                {
                    if (item.Checked)
                    {
                         query = @"UPDATE tbimport SET  IsImport =? where ID=? ";
                         parameters = new OleDbParameter[]
                         {
                            new OleDbParameter("?","1"),
                            new OleDbParameter("?",item.ID.ToString())
                         };
                         rowsAffected = ExecuteQueryResult(query, parameters);
                    }
                }
            }
        }
        public void SetIsImport()
        {
            BindingList<FileImport> bdList = chkDauvao.Checked ? lstImportVao : lstImportRa;
            if (bdList.Count == 0) return;

            using (OleDbConnection conn = new OleDbConnection(connectionString))
            {
                conn.Open();
                using (OleDbTransaction tran = conn.BeginTransaction())
                {
                    try
                    {
                        // 1️⃣ Reset IsImport = 0
                        using (OleDbCommand cmd = new OleDbCommand(
                            "UPDATE tbimport SET IsImport = 0", conn, tran))
                        {
                            cmd.ExecuteNonQuery();
                        }

                        // 2️⃣ Lấy danh sách ID được check
                        var checkedIds = bdList
                            .Where(x => x.Checked)
                            .Select(x => x.ID)
                            .ToList();

                        if (checkedIds.Count > 0)
                        {
                            // OleDb không hỗ trợ @param IN, phải build chuỗi
                            string idList = string.Join(",", checkedIds);

                            string query = $"UPDATE tbimport SET IsImport = 1 WHERE ID IN ({idList})";
                            using (OleDbCommand cmd = new OleDbCommand(query, conn, tran))
                            {
                                cmd.ExecuteNonQuery();
                            }
                        }

                        tran.Commit();
                    }
                    catch
                    {
                        tran.Rollback();
                        throw;
                    }
                }
            }
        }
        public void UpdateStatusImportVao_Safe(BindingList<FileImport> lstImportVao)
        {
            if (lstImportVao.Count == 0) return;

            var allIds = lstImportVao.Select(x => x.ID).ToList();
            var checkedIds = lstImportVao.Where(x => x.Checked).Select(x => x.ID).ToList();

            string allIdList = string.Join(",", allIds);
            string checkedIdList = checkedIds.Count > 0
                ? string.Join(",", checkedIds)
                : "NULL"; // tránh lỗi SQL

            using (OleDbConnection conn = new OleDbConnection(connectionString))
            {
                conn.Open();
                using (OleDbTransaction tran = conn.BeginTransaction())
                {
                    try
                    {
                        // 1️⃣ Set Status = 3 cho các ID trong danh sách
                        string sqlReset = $@"
                    UPDATE tbimport 
                    SET Status = 3 
                    WHERE ID IN ({allIdList})";

                        using (OleDbCommand cmd = new OleDbCommand(sqlReset, conn, tran))
                        {
                            cmd.ExecuteNonQuery();
                        }

                        // 2️⃣ Set Status = 0 cho các ID được check
                        if (checkedIds.Count > 0)
                        {
                            string sqlChecked = $@"
                        UPDATE tbimport 
                        SET Status = 0 
                        WHERE ID IN ({checkedIdList})";

                            using (OleDbCommand cmd = new OleDbCommand(sqlChecked, conn, tran))
                            {
                                cmd.ExecuteNonQuery();
                            }
                        }

                        tran.Commit();
                    }
                    catch
                    {
                        tran.Rollback();
                        throw;
                    }
                }
            }
        }

