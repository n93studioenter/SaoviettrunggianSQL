            tbImport =  ExecuteQuery(queryip);
            //Lấy danh sách tbimport
            var getlistImportvao = tbImport.AsEnumerable().Where(m =>m.Field<DateTime>("NLap").Month == monthToDelete).ToList();
            progressPanel1.Visible = true;
            Application.DoEvents();
            foreach (var item in getlistImportvao)
            {
                //Xoá cha
                var queryDelete = @"DELETE FROM tbimport WHERE ID=?";
