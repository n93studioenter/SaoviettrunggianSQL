                                string tkCo = "";
                                tkCo = itemDetail["TKCo"].ToString();

                                //Thiết lập mặc định danh mục vật tư


                                FileImportDetail fileImportDetail = new FileImportDetail(int.Parse(itemDetail["ID"].ToString()), Helpers.ConvertVniToUnicode(itemDetail["Ten"].ToString()), int.Parse(itemDetail["ParentId"].ToString()), itemDetail["SoHieu"].ToString(), double.Parse(itemDetail["SoLuong"].ToString()), double.Parse(itemDetail["DonGia"].ToString()), Helpers.ConvertVniToUnicode(itemDetail["DVT"].ToString()), itemDetail["MaCT"].ToString(), itemDetail["TKNo"].ToString(), tkCo, double.Parse(itemDetail["TTien"].ToString()), itemDetail["Percent"].ToString(), int.Parse(itemDetail["Tchat"].ToString()));
                                fileImportDetail.ID = int.Parse(itemDetail["ID"].ToString());
                                fileImport.fileImportDetails.Add(fileImportDetail);
                                Matdinhdanhmucvattu(fileImportDetail);

                            }
                        }
                        else
                        {
                           
                            GetdetailXML2(mstcty, item["KHHDon"].ToString(), item["SHDon"].ToString(), tokken, int.Parse(item["InvoiceType"].ToString()), fileImport, item.Field<string>("Khmshdon"));
                          

                            //if (string.IsNullOrEmpty(item["Path"].ToString()))
                            //{
                            //    GetdetailXML3(mstcty, item["KHHDon"].ToString(), item["SHDon"].ToString(), tokken, int.Parse(item["InvoiceType"].ToString()), fileImport);
                            //}
                            var parame = new OleDbParameter[]
                        {
                            new OleDbParameter("?",int.Parse(item["ID"].ToString()))
                        };
                            var kq3 = ExecuteQuery(queryCheckVatTu, parame);
                            foreach (DataRow itemDetail in kq3.Rows)
                            {
                                FileImportDetail fileImportDetail = new FileImportDetail(int.Parse(itemDetail["ID"].ToString()), Helpers.ConvertVniToUnicode(itemDetail["Ten"].ToString()), int.Parse(itemDetail["ParentId"].ToString()), itemDetail["SoHieu"].ToString(), double.Parse(itemDetail["SoLuong"].ToString()), double.Parse(itemDetail["DonGia"].ToString()), Helpers.ConvertVniToUnicode(itemDetail["DVT"].ToString()), itemDetail["MaCT"].ToString(), itemDetail["TKNo"].ToString(), itemDetail["TKCo"].ToString(), double.Parse(itemDetail["TTien"].ToString()), itemDetail["Percent"].ToString(), int.Parse(itemDetail["Tchat"].ToString()));
                                fileImportDetail.ID = int.Parse(itemDetail["ID"].ToString());
                                fileImport.fileImportDetails.Add(fileImportDetail);
                                Matdinhdanhmucvattu(fileImportDetail);
                            }
                        }

                        //Mật định danh mục vật tư

                        lstImportRa.Add(fileImport);
                    }

                    progressPanel2.Visible = true;
                    Application.DoEvents();
                    bindingSource.DataSource = lstImportRa;
                    gridControl2.DataSource = bindingSource;
                    gridControl2.RefreshDataSource();
                    gridView3.OptionsDetail.EnableMasterViewMode = true;
                    Application.DoEvents();
                }
                //load matdinhtaikhoan
                foreach (DataRow it in kq.Rows)
                {
                    FileImport item = lstImportRa.Where(m => m.ID == int.Parse(it["ID"].ToString())).FirstOrDefault();
                    if (item != null)
                    {
                        ApplyDefaultAndRuleBasedAccounts(item, tbDinhDanhtaikhoan, tbDinhDanhtaikhoanUuTien,2);
                        if (item.fileImportDetails.Count > 0 && string.IsNullOrEmpty(item.Noidung))
                        {
                            item.Noidung = item.fileImportDetails.FirstOrDefault().Ten;
                        }
                    }
                    //Xử lý loại bỏ tk 5211
                    var find5211 = item.fileImportDetails.Where(m => m.Tchat==3).FirstOrDefault();
                    if (find5211!=null)
                    {
                        //Kiểm tra xem trong ds có tk 5113 không
                        Capnhattk5211(item);
                    }
                }
                progressPanel1.Visible = false; // Ẩn progressPanel
            }

            SetGridViewOptions(gridView1);
            SetGridViewOptions(gridView3);
        }
        public void Capnhattk5211(FileImport fileImport)
        {
            string quer = "SELECT * FROM License";
            var getLcv = ExecuteQuery(quer, null);
            //Trường hợp có check chọn
            if (getLcv.Rows[0].Field<string>("col711ra") == "1")
            {
                //Trường hợp có 5113
                var kiemtra5113 = fileImport.fileImportDetails.Where(m => m.TKCo.Contains("5113")).FirstOrDefault();
                if (kiemtra5113 != null)
                {
                    var find5211 = fileImport.fileImportDetails.Where(m => m.Tchat == 3).ToList();
                    if (find5211 != null && find5211.Count>0)
                    { 
                        //Cập nhật giảm trừ cho tk 5113 đầu tiên
                        kiemtra5113.TTien -= find5211.Sum(m=>m.TTien);
                        //Cập nhật trong database
                        string query = @"UPDATE tbimportdetail SET TTien=?  WHERE ID=?";
                        var parameters = new OleDbParameter[]
                         {
                            new OleDbParameter("?",kiemtra5113.TTien),
                             new OleDbParameter("?",kiemtra5113.ID),
                         };
                        int rowsAffected = ExecuteQueryResult(query, parameters);

                        //Thực hiện xoá dòng 5211
                        foreach(var r52 in find5211)
                        {
                            query = @"delete from tbimportdetail  WHERE ID=?";
                            parameters = new OleDbParameter[]
                             {
                             new OleDbParameter("?",r52.ID),
                             };
                            rowsAffected = ExecuteQueryResult(query, parameters);
                            fileImport.fileImportDetails.Remove(r52);
                        }
                      
                        return;
                    }
                }
            }


            // Define the account codes to check in order of priority
            var accountCodes = new[] { "5113", "5112", "5111" };

            // Check for each account code
            foreach (var code in accountCodes)
            {
                if (fileImport.fileImportDetails.Any(m => m.TKCo.Contains(code)))
                {
                    // Find the first item with an empty TKCo
                    var find5211 = fileImport.fileImportDetails.Where(m => m.Tchat == 3).ToList();
                    //Xoá và gộp 5211
                    var first5211 = find5211.FirstOrDefault();
                    var lst5211remain = find5211.Where(m => m.ID != first5211.ID).ToList();
                    //Cập nhật first5211

                    if (first5211 != null)
                    {
                        first5211.TTien += lst5211remain.Sum(m => m.TTien);
                        first5211.TKNo = fileImport.fileImportDetails
                            .FirstOrDefault(m => m.TKCo.Contains(code))?.TKCo;
                        first5211.TKCo = "";
                        string query = @"UPDATE tbimportdetail SET TKNo=?,TKCo=?,TTien=?  WHERE ID=?";
                        var parameters = new OleDbParameter[]
                 {
                         new OleDbParameter("?",first5211.TKNo),
                         new OleDbParameter("?",""),
                         new OleDbParameter("?",first5211.TTien),
                         new OleDbParameter("?",first5211.ID),
                 };
                        int rowsAffected = ExecuteQueryResult(query, parameters);
                    }

                    //Xoá remain
                    foreach(var it in lst5211remain)
                    {
                     var   query = @"delete from tbimportdetail  WHERE ID=?";
                       var parameters = new OleDbParameter[]
                         {
                             new OleDbParameter("?",it.ID),
                         };
                       var  rowsAffected = ExecuteQueryResult(query, parameters);
                        fileImport.fileImportDetails.Remove(it);
                    }
                    return;
                }
            }
        }
