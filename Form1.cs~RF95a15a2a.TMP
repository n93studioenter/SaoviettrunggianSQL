                                                var findcus = tbKhachhang.AsEnumerable().Where(m => m["MaSo"].ToString() == idkhachhang.ToString()).FirstOrDefault();
                                                if (findcus != null)
                                                {
                                                    makh = findcus["SoHieu"].ToString();
                                                }
                                            }


                                            if (makh != "0")
                                                TT += double.Parse(item["SoPS"].ToString());
                                        }
                                        var findct2 = getlist.Where(m => m["MaKH"].ToString() != "0").FirstOrDefault();
                                        while (findct2 == null && countwhile > 0)
                                        {
                                            string snumber2 = "0" + number2.ToString();
                                            findct2 = existingTbChungtu.AsEnumerable().Where(m => m.Field<string>("SoHieu").Contains(snumber2)).FirstOrDefault();
                                            countwhile -= 1;
                                        }
                                        var findct = getlist.Where(m => m["MaKH"].ToString() != "0").FirstOrDefault();
                                        // makh = findct["MaKH"].ToString();
                                    }



                                    if (countwhile > 0)
                                    {

                                        //Kiểm tra tổng tiền trước
                                        if ((nganhang.ThanhTien > 0 && TT == nganhang.ThanhTien) || (nganhang.ThanhTien2 > 0 && TT == nganhang.ThanhTien2))
                                        {

                                            var kh = tbKhachhang.AsEnumerable().Where(m => m.Field<string>("SoHieu").ToString().Contains(makh)).FirstOrDefault();
                                            string tenkh = Helpers.ConvertVniToUnicode(kh["Ten"].ToString());
                                            string getMaSo = Helpers.ConvertVniToUnicode(kh["Ten"].ToString());
                                            //nganhang.MaKH = tenkh + " | " + getMaSo;
                                            nganhang.MaKH = getMaSo;
                                            var getTk131 = existingTbHeThongTK.AsEnumerable().Where(m => m.Field<string>("SoHieu").StartsWith("131")).ToList();
                                            if (getTk131.Count == 1)
                                            {
                                                if (nganhang.ThanhTien2 > 0)
                                                {
                                                    nganhang.TKCo = "131";
                                                }
                                            }
                                            else
                                            {
                                                if (nganhang.ThanhTien2 > 0)
                                                {
                                                    nganhang.TKCo = "1311";
                                                }
                                            }
                                            //Tìm tk 3311
                                            var getTk331 = existingTbHeThongTK.AsEnumerable().Where(m => m.Field<string>("SoHieu").StartsWith("331")).ToList();
                                            if (getTk331.Count == 1)
                                            {
                                                if (nganhang.ThanhTien > 0)
                                                {
                                                    nganhang.TKNo = "331";
                                                }
                                            }
                                            else
                                            {
                                                if (nganhang.ThanhTien > 0)
                                                {
                                                    nganhang.TKNo = "3311";
                                                }
                                            }

                                        }

                                    }
                                }
                            }
                            
                            //Kiểm tra có ghi chú mặc định không
                            if (!string.IsNullOrEmpty(tbMatdinhghichu.Rows[0]["TK"].ToString()) && chkMatdinhghichu.Checked)
                            {
                                if (nganhang.TKCo.Contains(tbMatdinhghichu.Rows[0]["TK"].ToString()))
                                {
                                    if (!string.IsNullOrEmpty(tbMatdinhghichu.Rows[0]["Noidung"].ToString()))
                                    {
                                        nganhang.Diengiai = Helpers.ConvertVniToUnicode(tbMatdinhghichu.Rows[0]["Noidung"].ToString());
                                        //Lấy tên khách hàng
                                        var getNameKH = tbKhachhang.AsEnumerable().Where(m => m.Field<string>("SoHieu").ToLower().Equals(nganhang.MaKH.ToLower())).FirstOrDefault()["Ten"].ToString();
                                        if (!string.IsNullOrEmpty(getNameKH))
                                            nganhang.Diengiai = nganhang.Diengiai.Replace("MaKH", Helpers.ConvertVniToUnicode(getNameKH));
                                    }
                                }
                            } 
                        }

                        lstNganhan.Add(nganhang);
                       
                    }
                  
                }
                var bindingList = new BindingList<Nganhang>(lstNganhan);
                gridControl7.DataSource = bindingList;
                gridView11.Columns["Stt"].SortOrder = ColumnSortOrder.Ascending;


            }
        }
        private void btnDocfileExcel_Click(object sender, EventArgs e)
        {
            progressPanel4.Visible = true;
            typeBank = 1;
            OpenFileDialog openFileDialog = new OpenFileDialog();

            // Thiết lập các thuộc tính của OpenFileDialog
            openFileDialog.Title = "Chọn file Excel";
            openFileDialog.Filter = "Excel Files (*.xls;*.xlsx)|*.xls;*.xlsx|All Files (*.*)|*.*";
            openFileDialog.InitialDirectory = Environment.GetFolderPath(Environment.SpecialFolder.MyDocuments);
            string excelilePath = "";
            // Hiển thị hộp thoại và kiểm tra người dùng có chọn file không
            if (openFileDialog.ShowDialog() == DialogResult.OK)
            {
                excelilePath = openFileDialog.FileName;
                DocfileNganhangExcel(excelilePath);
               // ReadFileExcelNganhang(excelilePath);
            }
            progressPanel4.Visible = false;
        }

        private void btnThemdong_Click(object sender, EventArgs e)
        {
            //Lấy stt của dòng hiện tại
            if (typeBank == 1)
            {
                int currentSTT = int.Parse(gridCurrent.GetRowCellValue(currentIndex, "Stt").ToString());
                var currentitem = lstNganhan.Where(m => m.Stt == currentSTT).FirstOrDefault();
                Nganhang nh = new Nganhang();
                nh.Maso = currentitem.Maso;
                nh.Stt = currentSTT + 1; // STT của phần tử mới
                nh.NgayGD = currentitem.NgayGD;
                nh.Checked = true;
                nh.TKCo = currentitem.TKCo;
                nh.TKNo = currentitem.TKNo;
                // Tăng STT cho các phần tử còn lại
                foreach (var item in lstNganhan.Where(m => m.Stt > (currentSTT)).ToList())
                {
                    item.Stt++;
                }
                lstNganhan.Add(nh);
                gridControl3.DataSource = lstNganhan.OrderBy(m => m.Stt).ToList();
                gridControl3.RefreshDataSource();
            }
        }
        public class Hoadon
        {
            public int Id { get; set; }
            public DateTime NgayMua { get; set; }
            public string SoHieu { get; set; }
            public string TenKH { get; set; }
            public string MaSoHH { get; set; }
            public string TenHH { get; set; }
            public double SL { get; set; }
            public double DonGia { get; set; }
            public double ThanhTien { get; set; }
            public int Hinhthuc { get; set; }
            public string TKNo { get; set; }
            public string TKCo { get; set; }
            public string TKThue { get; set; }
        }
        List<Hoadon> lstHoadon;
        List<FileImport2> lstFileImporthd = new List<FileImport2>();
        private void backupimport()
        {
            progressPanel1.Visible = true;
            Application.DoEvents();
            lstHoadon = new List<Hoadon>();
            OpenFileDialog openFileDialog = new OpenFileDialog();

            // Thiết lập các thuộc tính của OpenFileDialog
            openFileDialog.Title = "Chọn file Excel";
            openFileDialog.Filter = "Excel Files (*.xlsx)|*.xlsx|All Files (*.*)|*.*";

            openFileDialog.InitialDirectory = Environment.GetFolderPath(Environment.SpecialFolder.MyDocuments);
            string excelilePath = "";

            // Hiển thị hộp thoại và kiểm tra người dùng có chọn file không
            if (openFileDialog.ShowDialog() == DialogResult.OK)
            {
                excelilePath = openFileDialog.FileName;
                bool hople = false;
                int rowcountHople = 0;
                Hoadon hd = new Hoadon();
                FileImport2 fileImport = null;
                FileImportDetail2 fileImportDetail2 = null;
                using (var workbook = new XLWorkbook(excelilePath))
                {
                    var worksheet = workbook.Worksheet(1); // Lấy worksheet đầu tiên
                    int rowCount = worksheet.LastRowUsed().RowNumber(); // Lấy số lượng hàng đã sử dụng

                    int indexTenHH = 0;
                    int indexSL = 0;
                    int indexDG = 0;
                    int indexTT = 0;
                    string currentSohieu = "";
                    string currentSohieuHH = "";
                    string currentName = "";
                    int currentHT = 0;
                    int stt = 1;
                    DateTime currentDate = new DateTime();
                    for (int rowIndex = 1; rowIndex <= rowCount; rowIndex++)

                    {

                        var row = worksheet.Row(rowIndex); // Lấy hàng hiện tại

                        for (int i = 2; i <= 6; i++)
                        {
                            var cellValue = row.Cell(i).GetString(); // Lấy giá trị ô dưới dạng chuỗi

                            //Xử lý row đầu
                            if (rowcountHople == 0)
                            {

                                if (cellValue.Trim() == "Tên hàng hóa" || cellValue.Trim() == "Tên HH")
                                {
                                    //Trường hợp ko có data
                                    if (string.IsNullOrEmpty(row.Cell(i - 1).GetString()))
                                    {
                                        hople = false;
                                        break;
                                    }

                                    indexTenHH = i;
                                    var nextRow = worksheet.Row(rowIndex + 1);
                                    string tenkh = nextRow.Cell(1).GetString();
                                    //Kiểm tra khách hàng trong database
                                    var check = tbKhachhang.AsEnumerable().Where(m => m["Ten"].ToString().ToLower().Contains(Helpers.ConvertUnicodeToVni(tenkh).ToLower())).FirstOrDefault();
                                    if (check != null)
                                    {
                                        hd.SoHieu = check["SoHieu"].ToString();
                                        currentSohieu = hd.SoHieu;
                                    }
                                    var next2Row = worksheet.Row(rowIndex + 2);
                                    var vlnr1 = next2Row.Cell(1).GetString();
                                    int hthuc = vlnr1 == "Tiền mặt" ? 1 : 0;
                                    currentHT = hd.Hinhthuc;

                                    // fileImport = new FileImport2("", "NK/" + stt, "1", DateTime.Parse(row.Cell(i - 1).GetString()), tenkh, "Nhập kho hào lá", "156", "1111", 1331, check["MST"].ToString(), 0, 0, currentHT, "", true, 0, 0, 0, true, 3, 0, 0, 0, 0, 0);

                                    hople = true;
                                }
                                if (cellValue.Trim() == "Số lượng" || cellValue.Trim() == "SL")
                                {
                                    indexSL = i;
                                }
                                if (cellValue.Trim() == "đơn giá" || cellValue.Trim() == "DG")
                                {
                                    indexDG = i;
                                }
                                if (cellValue.Trim() == "Thành tiền")
                                {
                                    indexTT = i;
                                    rowcountHople += 1;
                                    break;
                                }
                            }

                            //Xử lý các row sau
                            if (rowcountHople > 0)
                            {
                                if (rowIndex == 31)
                                {
                                    int a = 10;
                                }
                                if (i == indexTenHH)
                                {
                                    if (string.IsNullOrEmpty(cellValue))
                                        continue;
                                    if (fileImportDetail2 == null)
                                    {
                                        fileImportDetail2 = new FileImportDetail2();
                                    }
                                    fileImportDetail2.ParentId = fileImport.ID;
                                    //Trường hợp hết hàng hoá
                                    if (cellValue == "Công tiền hàng")
                                    {
                                        hople = false;
                                        rowcountHople = 0;
                                        if (fileImport.fileImportDetails.Count > 0)
                                            lstFileImporthd.Add(fileImport);
                                        break;
                                    }
                                    fileImportDetail2.Ten = cellValue;
                                    //Tìm hàng hoá
                                    var check = lstvt.Where(m => m.TenVattu.ToLower().Contains(cellValue.ToLower())).FirstOrDefault();
                                    if (check != null)
                                    {

                                        fileImportDetail2.SoHieu = check.SoHieu;
                                    }
                                }

                                double sl = 0;
                                if (i == indexSL)
                                {

                                    if (double.TryParse(cellValue, out sl))
                                    {
                                        fileImportDetail2.Soluong = sl; // Gán giá trị đã phân tích thành công
                                    }
                                }

                                double dg = 0;
                                if (i == indexDG)
                                {

                                    if (double.TryParse(cellValue, out dg))
                                    {
                                        fileImportDetail2.Dongia = dg; // Gán giá trị đã phân tích thành công
                                    }
                                }

                                double tt = 0;
                                if (i == indexTT)
                                {

                                    if (double.TryParse(cellValue, out tt))
                                    {
                                        fileImportDetail2.TTien = tt; // Gán giá trị đã phân tích thành công
                                    }
                                    else
                                    {
                                        hd.ThanhTien = 0; // Gán giá trị mặc định nếu không phân tích thành công
                                    }
                                    fileImportDetail2.TKNo = "156";
                                    fileImportDetail2.TKCo = "1111";
                                    fileImport.fileImportDetails.Add(fileImportDetail2);
                                    fileImportDetail2 = new FileImportDetail2();
                                    stt += 1;
                                }


                            }
                        }
                    }
                }
                SaveHoadonexcel();

                //Insert file vào phan mem
                // gridControl1.DataSource = lstFileImporthd;
            }
        }
        private void simpleButton5_Click(object sender, EventArgs e)
