                                            query = "INSERT INTO tbimportdetail(ParentId, SoHieu, SoLuong, DonGia, DVT, Ten, MaCT, TKNo, TKCo, TTien)  VALUES(?, ?, ?, ?, ?, ?, ?, ?, ?, ?)";
