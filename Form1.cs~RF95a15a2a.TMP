            {
                lsttbimport = tbimports.ToList<TbImport>();
                 lookupTbImport = new HashSet<(string MST, string SHDon, DateTime NLap)>(
                     lsttbimport.Select(x => (x.Mst ?? "", x.SHDon ?? "", x.NLap))
                 );
