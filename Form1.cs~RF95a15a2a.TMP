                                            XtraMessageBox.Show(ex.Message);

                                        }
                                        //Lay ID cua PArent
                                        string gettopquery = "SELECT TOP 1 ID FROM tbimport ORDER BY ID DESC";

                                        var resutls = ExecuteQuery(gettopquery, null);

