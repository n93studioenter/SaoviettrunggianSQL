        private async void VattuControl_ItemSelectednl(object sender, string seletedItem)
        { 
            lstvt = await LoadDataVattuAsync();
            var findkh = lstvt.Where(row => row.SoHieu == seletedItem).FirstOrDefault();
            if (findkh != null)
            {
                int currentRowHandle = gridView.FocusedRowHandle;
                var focusedColumn = gridView.FocusedColumn;

                gridView.SetRowCellValue(currentRowHandle, focusedColumn, seletedItem);

                //Tính số lượng
                var getvt = lstvt.Where(m => m.SoHieu == seletedItem).FirstOrDefault();
                if (getvt != null)
                { 
                    //Tìm chứng từ cuối cùng
                    var findlastCt = existingTbChungtu.AsEnumerable().Where(m => m.Field<int>("MaVattu") == getvt.MaSo && m["SoPS2No"].ToString() != "0").LastOrDefault();
                    if (findlastCt != null)
                    {
                        double getSoPS = double.Parse(findlastCt["SoPS"].ToString());
                        double SoPSNo = double.Parse(findlastCt["SoPS2No"].ToString());
                        double DonGia = getSoPS / SoPSNo;
                        for (int i = 1; i <= 5; i++)
                        {
                            if (focusedColumn.ToString() == $"Nguyên liệu {i}")
                            {
                                double tt = double.Parse(gridView6.GetRowCellValue(gridView6.FocusedRowHandle, "DonGia").ToString()) *
                                             double.Parse(gridView6.GetRowCellValue(gridView6.FocusedRowHandle, "SoLuongTon").ToString());
                                double percent2 = double.Parse(gridView6.GetRowCellValue(gridView6.FocusedRowHandle, $"ps{i}").ToString());
                                var tt1 = (tt * percent2 / 100);
                                double sL = Math.Round(tt1 / DonGia, 2);
                                sL = sL < 0 ? sL * -1 : sL;

                                gridView6.SetRowCellValue(gridView6.FocusedRowHandle, $"sl{i}", sL);
                                gridView6.SetRowCellValue(gridView6.FocusedRowHandle, $"dg{i}", DonGia);
                                break; // Kết thúc vòng lặp nếu tìm thấy trường hợp phù hợp
                            }
                        }
                       
                    }
                    else
                    {
                       //XtraMessageBox.Show("Không tìm thấy chứng từ!");
                    }
                }
                else
                {
                    //  XtraMessageBox.Show("Không tìm thấy vật tư!");
                }

                vattuControlnl.Hide(); // Ẩn UserControl  
            }
        }
        private void Khachhangcontrol_ItemSelected(object sender, string selectedItem)
        {
            if (xtraTabControl2.SelectedTabPageIndex == 2)
            {
                var query = "SELECT * FROM KhachHang"; // Giả sử bạn muốn lấy tất cả dữ liệu từ bảng KhachHang
                tbKhachhang = ExecuteQuery(query);
                var findkh = tbKhachhang.AsEnumerable().Where(row => row.Field<string>("SoHieu") == selectedItem).FirstOrDefault();
                if (findkh != null)
                {
                    int currentRowHandle = gridView11.FocusedRowHandle;
                    gridView11.SetRowCellValue(currentRowHandle, "TenKH", Helpers.ConvertVniToUnicode(findkh["Ten"].ToString()));
                    gridView11.SetRowCellValue(currentRowHandle, "MaKH", Helpers.ConvertVniToUnicode(findkh["SoHieu"].ToString()));
                    CloseKhachhangControl();
                }
            }

        }
        private void HanghoaControl_ItemSelected(object sender, string selectedItem)
        {
            int currentRowHandle = gridView.FocusedRowHandle;
            DTO.VatTu vattu = lstvt.ToList().Where(m => m.SoHieu == selectedItem).FirstOrDefault();
            if (vattu != null)
            {
                string tenvt = vattu.TenVattu;
                gridView.SetRowCellValue(currentRowHandle, "SoHieu", selectedItem);
                gridView.SetRowCellValue(currentRowHandle, "Ten", tenvt);
            }
            //Trường hợp thêm mới vật tư
            else
            {
                //Lấy giá trị trên gridview
                string Ten = gridView.GetRowCellValue(currentRowHandle, "Ten").ToString();
                string SoHieu = sohieuedit;
                var DVT = gridView.GetRowCellValue(currentRowHandle, "DVT").ToString();

                var query = @"INSERT INTO Vattu (MaPhanLoai, SoHieu, TenVattu, DonVi,GhiChu) VALUES (?, ?, ?, ?,?)";
                var parameters = new OleDbParameter[]
                   {
                        new OleDbParameter("?",selectedItem),
                        new OleDbParameter("?", SoHieu),
                        new OleDbParameter("?",Helpers.ConvertUnicodeToVni(Ten)),
                        new OleDbParameter("?",Helpers.ConvertUnicodeToVni(DVT)),
                        new OleDbParameter("?","xxx"),
                   };
                try
                {
                    int rowsAffected = ExecuteQueryResult(query, parameters);
                    DTO.VatTu vt = new DTO.VatTu();
                    vt.TenVattu = Ten;
                    vt.SoHieu = SoHieu;
                    vt.DonVi = DVT;
                    vt.MaPhanLoai = int.Parse(selectedItem);
                    vt.GhiChu = "xxx";
                    vt.TenMaPhanLoai = "";
                    lstvt.Add(vt);
                    //
                    bool replace = false;
                    foreach (var item in lstImportVao)
                    {
                        foreach (var it in item.fileImportDetails)
                        {
                            if (it.Ten == vt.TenVattu)
                            {
                                lstrowSohieu.Add(it.ID);
                            }
                        }
                    }
                    if (lstrowSohieu.Count > 0)
                        lstrowSohieu.RemoveAt(0);
                    if (lstrowSohieu.Count > 0)
                    {
                        DialogResult result = XtraMessageBox.Show("Có " + lstrowSohieu.Count + " sản phẩm khác đang trùng tên với sản phẩm đang sửa, bạn có muốn cập nhật luôn mã mới?",
                                        "Xác nhận",
                                        MessageBoxButtons.YesNo,
                                        MessageBoxIcon.Question);
                        if (result == DialogResult.Yes)
                        {
                            replace = true;
                        }
                    }
                    if (replace)
                    {
                        foreach (var item in lstrowSohieu)
                        {
                            foreach (var it in lstImportVao)
                            {
                                var findchild = it.fileImportDetails.Where(m => m.ID == item).FirstOrDefault();
                                if (findchild != null)
                                {
                                    findchild.SoHieu = SoHieu;
                                    findchild.DVT = DVT;
                                    findchild.Ten = Ten;
                                    //Update vào database
                                    query = @"UPDATE tbimportdetail SET  SoHieu=?,DVT=?,Ten=? where ID=? ";
                                    parameters = new OleDbParameter[]
                                   {
                new OleDbParameter("?", SoHieu),
                new OleDbParameter("?", Helpers.ConvertUnicodeToVni(DVT)),
                new OleDbParameter("?",  Helpers.ConvertUnicodeToVni(Ten)) ,
                new OleDbParameter("?", findchild.ID)
                                   };
                                    rowsAffected = ExecuteQueryResult(query, parameters);
                                }
                            }
                        }
                        lstrowSohieu = new List<int>();
                    }
                }
                catch (Exception ex)
                {
                    XtraMessageBox.Show(ex.Message);
                }
            }

        }
