        private void xtraTabControl1_Click(object sender, EventArgs e)
        {
            if (xtraTabControl1.SelectedTabPageIndex == 1)
            {
                try
                {
                    string rootDirectory = @"\\192.168.1.90\Ke toan 2025 New"; // Thay đổi đường dẫn
                    string keyword = "Sao Viet";

                    List<string> subdirectories = GetSubdirectoriesWithKeyword(rootDirectory, keyword);
                    comboBoxEdit1.Properties.Items.Clear(); // Xóa các mục cũ

                    foreach (var dir in subdirectories)
                    {
                        cbbCty.Properties.Items.Add(dir); // Gán giá trị cho ComboBoxEdit
                    }
                }
                catch(Exception ex)
                {
                    XtraMessageBox.Show(ex.Message);
                }
            }
        }

        private List<string> GetSubdirectoriesWithKeyword(string rootDir, string keyword)
        {
            List<string> matchingDirs = new List<string>();

            try
            {
                // Lấy tất cả thư mục con trực tiếp trong thư mục gốc
                var directories = Directory.GetDirectories(rootDir);

                foreach (var dir in directories)
                {
                    // Kiểm tra xem tên thư mục có chứa từ khóa không
                    if (dir.IndexOf(keyword, StringComparison.OrdinalIgnoreCase) >= 0)
                    {
                        matchingDirs.Add(dir);
                    }
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show("An error occurred: " + ex.Message);
            }

            return matchingDirs;
        }

        private void simpleButton11_Click(object sender, EventArgs e)
        {
            btnChonthang.Enabled = false;
            Application.DoEvents();
            if (chkDauvao.Checked)
