                                new OleDbParameter("?", ""),
                                new OleDbParameter("?", fileip2.TPhi.ToString()),
                                new OleDbParameter("?", fileip2.TgTCThue.ToString()),
                                new OleDbParameter("?", fileip2.TgTThue.ToString()),
                                    new OleDbParameter("?", fileip2.Path.ToString())
                                        };

                                        try
