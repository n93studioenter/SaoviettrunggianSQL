                else
                {
                    throw new ArgumentException("invoiceType không hỗ trợ: " + invoiceType);
                }
                // 3. Gọi API
                GDTClient.UpdateToken(tokken);
                string json = await GDTClient.GetJsonAsync(url);
                var invoice = JsonConvert.DeserializeObject<Invoice>(json);

                if (invoice?.Hdhhdvu == null || invoice.Hdhhdvu.Count == 0)
                    return;

                executionCount++;

                // 4. Lấy thông tin cha + license
                var parentRow = ExecuteQuery("SELECT * FROM tbimport WHERE ID=?", new[] { new OleDbParameter("?", fileImport.ID) }).Rows[0];
                var licenseRow = ExecuteQuery("SELECT * FROM License", null).Rows[0];
                bool skip711 = licenseRow.Field<string>("col711") == "1";

                double ttrcthue = 0;
                bool hasVattu = false;
                string getcode = "";

                // 5. Gộp chiết khấu 711 (nếu không skip)
                InvoiceLineItem mainDiscountLine = null;
                //if (!skip711)
                //{
                //    for (int i = invoice.Hdhhdvu.Count - 1; i >= 0; i--)
                //    {
                //        var it = invoice.Hdhhdvu[i];
                //        if (fileImport.Type == 2 && it.tchat == 3)
                //        {
                //            ttrcthue -= it.Thtien ?? 0;
                //            invoice.Hdhhdvu.RemoveAt(i);
                //            continue;
                //        }

                //        if (it.tchat == 3 || it.Thtien < 0)
                //        {
                //            if (mainDiscountLine == null)
                //                mainDiscountLine = it;
                //            else
                //            {
                //                mainDiscountLine.Thtien = (mainDiscountLine.Thtien ?? 0) + (it.Thtien ?? 0);
                //                invoice.Hdhhdvu.RemoveAt(i);
                //            }
                //        }
                //    }
                //}

                // 6. Thêm phí (nếu có)
                if (invoice.Thttlphi?.Count > 0)
                {
                    foreach (var p in invoice.Thttlphi)
                    {
                        if (!string.IsNullOrEmpty(p.tlphi) && p.tlphi != "0")
                            invoice.Hdhhdvu.Add(new InvoiceLineItem { Ten = p.tlphi, Thtien = p.tphi });
                    }
                }

                // 7. Duyệt từng dòng hóa đơn
                foreach (var it in invoice.Hdhhdvu.ToList())
                {
                    // Bỏ dòng rác
                    if ((it.Thtien == 0 || it.Thtien == null) && (it.Sluong == null || it.Sluong == 0))
                        if (!it.Ten?.Contains("Đã giảm") == true && !it.Ten?.Contains("Điều chỉnh") == true)
                            continue;

                    // Cộng tổng tiền thuế (trừ chiết khấu khi bán ra)
                    if (fileImport.Type == 1)
                        ttrcthue += it.Thtien ?? 0;
                    else if (fileImport.Type == 2)
                        ttrcthue += it.tchat == 3 ? -(it.Thtien ?? 0) : (it.Thtien ?? 0);



                    // Map mã vật tư (tối ưu cực mạnh)
                    string tenKey = it.Ten?.Trim().ToLower() ?? "";
                    if (!dicListvt.TryGetValue(tenKey, out getcode))
                    {
                        lastfinalsValue = 0; // reset mỗi lần
                        var best = lstvt
                            .Select(vt => new
                            {
                                Code = vt.SoHieu?.ToString(),
                                Score = CalculateMatchScore(vt, it.Ten)
                            })
                            .Where(x => x.Score >= 90)
                            .OrderByDescending(x => x.Score)
                            .FirstOrDefault();

                        if (best != null)
                        {
                            getcode = best.Code;
                            lastfinalsValue = Math.Round(best.Score); // đây chính là lastfinals
                        }
                        else
                        {
                            getcode = GenerateResultString(NormalizeVietnameseString(it.Ten?.Trim() ?? ""));
                            lastfinalsValue = 0;
                        }
                        dicListvt[tenKey] = getcode;
                    }
                    else
                    {
                        lastfinalsValue = 100; // đã có trong cache → 100%
                    }
                    if(fileImport.ID== 3105)
                    {
                        int a = 10;
                    }
                    // Cập nhật nội dung lần đầu
                    if (!hasVattu && !string.IsNullOrEmpty(it.Ten))
                    {

                        ExecuteQueryResult("UPDATE tbimport SET Noidung=? WHERE ID=?", new OleDbParameter[]
                        {
                    new OleDbParameter("?", Helpers.ConvertUnicodeToVni(it.Ten)),
                    new OleDbParameter("?", fileImport.ID)
                        });
                        fileImport.Noidung = it.Ten;
                        hasVattu = true;
                    }
                    else
                    {
                        int noname = 10;
                    }
                        // Xác định tài khoản
                        string tkno = parentRow["TKNo"].ToString();
                    string tkco = parentRow["TKCo"].ToString();

                    if (it.tchat == 3 && fileImport.Type == 2)
                    {
                      //  tkno = "5211";
                    }

                    if (it.Ten?.ToLower().Contains("điều chỉnh") == true && fileImport.Type == 1)
                        tkno = "6421";

                    if (it.Ten?.ToLower().Contains("chiết khấu") == true || it.tchat == 3 || it.Thtien < 0)
                        tkco = (invoiceType == 5 || invoiceType == 10) ? tkco : "711";
                    else if (it.Ten?.Contains("Đã giảm") == true)
                    {
                        var match = Regex.Match(it.Ten, @"\d[\d\.,]*");
                        if (match.Success)
                        {
                            tkco = "711"; tkno = "152";
                            it.Dgia = 0;
                            it.Thtien = -double.Parse(match.Value.Replace(".", "").Replace(",", ""));
                        }
                    }

                    //if (fileImport.Type == 2 && it.tchat == 3)
                    //    tkno = "5211";

                    // Đảo dấu tiền âm
                    double amount = Math.Abs(it.Thtien ?? 0);
                    //if (it.tchat == 3 && fileImport.Type == 2)
                    //{
                    //    tkno = "5211";
                    //}
                    // Insert chi tiết
                    var parameters = new OleDbParameter[]
                    {
                new OleDbParameter("?", fileImport.ID),
                new OleDbParameter("?", getcode),
                new OleDbParameter("?", it.Sluong ?? 0),
                new OleDbParameter("?", it.Dgia ?? 0),
                new OleDbParameter("?", Helpers.ConvertUnicodeToVni(it.Dvtinh)),
                new OleDbParameter("?", it.Ten != null ? Helpers.ConvertUnicodeToVni(it.Ten) : ""),
                new OleDbParameter("?", ""),
                new OleDbParameter("?", tkno),
                new OleDbParameter("?", tkco),
                new OleDbParameter("?", amount),
                new OleDbParameter("?", lastfinalsValue.ToString()), // ĐÃ CÓ LẠI RỒI ĐÂY!
                new OleDbParameter("?", it.tchat)
                    };

                    ExecuteQueryResult(
                        @"INSERT INTO tbimportdetail ([ParentId],[SoHieu],[SoLuong],[DonGia],[DVT],[Ten],[MaCT],[TKNo],[TKCo],[TTien],[Percent],[Tchat]) 
                  VALUES (?,?,?,?,?,?,?,?,?,?,?,?)", parameters);

                    // Cập nhật DataTable hiển thị
                    var row = tbImportDt.NewRow();
                    row["ParentId"] = fileImport.ID; row["SoHieu"] = getcode; row["SoLuong"] = it.Sluong ?? 0;
                    row["DonGia"] = it.Dgia ?? 0; row["DVT"] = it.Dvtinh; row["Ten"] = it.Ten ?? "";
                    row["TKNo"] = tkno; row["TKCo"] = tkco; row["TTien"] = amount; row["Percent"] = lastfinalsValue; // hiển thị luôn % khớp
                    tbImportDt.Rows.Add(row);
                }

                // 8. Cập nhật tổng tiền thuế (nếu cần)
                if (parentRow["TgTCThue"].ToString() == "-100")
                {
                    ExecuteQueryResult("UPDATE tbimport SET TgTCThue=? WHERE ID=?", new OleDbParameter[]
                    {
                new OleDbParameter("?", ttrcthue),
                new OleDbParameter("?", fileImport.ID)
                    });
                    fileImport.TgTCThue = ttrcthue;
                }
            }
            catch (Exception ex)
            {
               // MessageBox.Show("Lỗi lấy chi tiết hóa đơn: " + ex.Message);
            }
        }

        // Hàm hỗ trợ tính điểm khớp (giữ nguyên như cũ của bạn)
        private double CalculateMatchScore(dynamic vt, string tenSP)
        {
            if (string.IsNullOrEmpty(tenSP)) return 0;
            string a = Helpers.RemoveVietnameseDiacritics(vt.TenVattu?.ToString() ?? "").ToLower().Replace(".", " ").Replace("-", " ");
            string b = Helpers.RemoveVietnameseDiacritics(Helpers.NormalizeVietnameseString(tenSP)).ToLower().Replace(".", " ").Replace("-", " ");

            int fuzzScore = Fuzz.Ratio(a, b);
            double levScore = CalculateSimilarity(a, b);

            // Ưu tiên tên phụ nếu có
            if (fuzzScore < 100 && vt.TenVattu2 != null)
            {
                string a2 = Helpers.RemoveVietnameseDiacritics(vt.TenVattu2.ToString()).ToLower();
                int fuzz2 = Fuzz.Ratio(a2, b);
                if (fuzz2 > fuzzScore) fuzzScore = fuzz2;
            }

            return 0.7 * fuzzScore + 0.3 * levScore;
        }


        public void GetdetailXML2(string nbmst, string khhdon, string shdon, string tokken, int invoiceType, FileImport fileImport, string khmshdon)
        {
            if (string.IsNullOrEmpty(khmshdon))
                khmshdon = "1";
            string mst = "";
            if (string.IsNullOrEmpty(CCCD) || CCCD == "...")
            {
                mst = nbmst;
            }
            else
            {
                mst = CCCD;
            }
            string url = "";
            if (invoiceType == 4 || invoiceType == 6 || invoiceType == 8)
                url = $"https://hoadondientu.gdt.gov.vn:30000/query/invoices/detail?nbmst={nbmst}&khhdon={khhdon}&shdon={shdon}&khmshdon={khmshdon}";
            if (invoiceType == 5 || invoiceType == 10)
                url = $"https://hoadondientu.gdt.gov.vn:30000/sco-query/invoices/detail?nbmst={mst}&khhdon={khhdon}&shdon={shdon}&khmshdon={khmshdon}";
            using (var client = new WebClient())
            {
                client.Encoding = Encoding.UTF8;
                client.Headers[HttpRequestHeader.Authorization] = "Bearer " + tokken;
                client.Headers[HttpRequestHeader.Accept] = "application/json; charset=utf-8";
                client.Headers[HttpRequestHeader.ContentType] = "application/json; charset=utf-8";
                // client.Timeout = TimeSpan.FromSeconds(10); // Ví dụ: 30 giây

                string responseBody = "";
                int retryCount = 0;
                const int maxRetries = 3;

                while (retryCount < maxRetries)
                {
                    try
                    {
                        // Download string đồng bộ - không async
                        responseBody = client.DownloadString(url);

                        // Kiểm tra status code (WebClient ném exception cho lỗi HTTP)
                        break; // Thành công, thoát vòng lặp
                    }
                    catch (WebException ex) when ((ex.Response as HttpWebResponse)?.StatusCode == HttpStatusCode.InternalServerError)
                    {
                        retryCount++;
                        Thread.Sleep(400); // Thay Task.Delay bằng Thread.Sleep
                        Console.WriteLine($"Lỗi 500, thử lại lần {retryCount}...");
                        if (retryCount >= maxRetries)
                            throw;
                    }
                    catch (Exception ex)
                    {
                        // Xử lý các exception khác
                        if (retryCount >= maxRetries - 1)
                        {
                           // XtraMessageBox.Show(ex.Message);
                        }
                        retryCount++;
                        Thread.Sleep(400);
                    }
                }
                var rootObject = JsonConvert.DeserializeObject<Invoice>(responseBody);
                VietnameseProductMatcher vietnameseProductMatcher = new VietnameseProductMatcher();
                if (rootObject == null)
                    return;
                // Tìm ID Cha mới nhất
                string query = "SELECT * FROM tbimport WHERE ID=?";
                var parameterss = new OleDbParameter[]
                {
                new OleDbParameter("?", fileImport.ID.ToString()),
                };
                var kq2 = ExecuteQuery(query, parameterss);
                string getcode = "";

                if (kq2.Rows.Count > 0)
                {
                    // Xử lý tên
                    if (rootObject == null || rootObject.Hdhhdvu == null)
                        return;
                    bool hasVattu = false;
                    double ttrcthue = 0;
                    int has711 = 0;
                    string id711 = "";

                    double tienphi = 0;
                    //Xử lý tiền phí;

                    string quer = "SELECT * FROM License";
                    var getLcv = ExecuteQuery(quer, null);
                    //Xử lý  711 trước khi xử lý các vật tư khác
                    if (getLcv.Rows[0].Field<string>("col711") != "1")
                    {
                        //Xử lý  711 trước khi xử lý các vật tư khác
                        foreach (var it in rootObject.Hdhhdvu.ToList())
                        {
                            //Loại bỏ đi ưu đãi của bán ra
                            if (fileImport.Type == 2)
                            {
                                if (it.tchat == 3)
                                {
                                    ttrcthue -= it.Thtien != null ? it.Thtien.Value : 0;
                                   // rootObject.Hdhhdvu.Remove(it);
                                }
                            }
                            if ((it.tchat == 3 && has711 == 0) || (it.Thtien < 0 && has711 == 00))
                            {
                                id711 = it.Id;
                                has711 += 1;
                            }
                            else
                            {
                                if (it.tchat == 3 || it.Thtien < 0)
                                {
                                    var findwith711 = rootObject.Hdhhdvu.FirstOrDefault(m => m.Id == id711);
                                    if (findwith711 != null)
                                    {
                                        findwith711.Thtien += it.Thtien != null ? it.Thtien.Value : 0;
                                    }
                                    rootObject.Hdhhdvu.Remove(it);
                                }
                            }

                        }
                    }
                  
                    if (rootObject.Thttlphi != null && rootObject.Thttlphi.Count > 0)
                    {
                        foreach (var tp in rootObject.Thttlphi.ToList())
                        {
                            InvoiceLineItem lephi = new InvoiceLineItem();
                            lephi.Ten = tp.tlphi;
                            lephi.Thtien = tp.tphi;
                            rootObject.Hdhhdvu.Add(lephi);
                        }
                    }

                    double lastfinal = 0;
                    //Xử lý gộp sản phẩm cùng số hiệu 
                    foreach (var it in rootObject.Hdhhdvu)
                    {
                        if (it.Ten == "Hạt nêm Heo Aji-ngon 170g11")
                        {
                            int a = 0;
                        }
                        lastfinal = 0;

                        //if(it.tchat==2 || it.tchat==4)
                        //{
                        //    continue; // Bỏ qua nếu tchat là 2 hoặc 3
                        //}

                        if (it.Thtien == 0 && (it.Sluong == 0 || it.Sluong == null))
                        {
                            if (it.Ten!=null && !it.Ten.Contains("Đã giảm") && !it.Ten.Contains("Điều chỉnh"))
                                continue;
                        }
                        if (it.Thtien == null && it.Sluong == null)
                        {
                            if(it.Ten==null)
                                continue;
                            if (!it.Ten.Contains("Đã giảm") && !it.Ten.Contains("Điều chỉnh"))
                                continue;
                        }
                        if (fileImport.Type == 1)
                        {
                            ttrcthue += it.Thtien != null ? it.Thtien.Value : 0;
                        }
                        if (fileImport.Type == 2)
                        {
                            if (it.tchat == 3)
                            {
                                ttrcthue -= it.Thtien != null ? it.Thtien.Value : 0;
                            }
                            else
                            {
                                ttrcthue += it.Thtien != null ? it.Thtien.Value : 0;
                            }
                        }
                        List<FindVT> lstFindVT = new List<FindVT>();

                        foreach (var dtr in lstvt)
                        {
                            var getTen = Helpers.RemoveVietnameseDiacritics(dtr.TenVattu.ToString()).ToLower().Replace(".", " ").Replace("-", " ");

                            var getTen2 = Helpers.RemoveVietnameseDiacritics(Helpers.NormalizeVietnameseString(it.Ten)).ToLower().Replace(".", " ").Replace("-"," ");
                           
                            var getghichu = Helpers.RemoveVietnameseDiacritics(dtr.GhiChu).ToLower().Replace(".", " ");

                            if (!string.IsNullOrEmpty(getTen) && !string.IsNullOrEmpty(getTen2))
                            {
                                var getps = vietnameseProductMatcher.CalculateSimilarity(getTen, getTen2);


                                var getPercent = CalculateSimilarity(getTen, getTen2);
                                var getPercent2 = CalculateSimilarity(getTen2, getTen);
                                var getpercent2 = Fuzz.Ratio(getTen.ToLower(), getTen2.ToLower());
                                double final = (0.6 * getpercent2 + 0.4 * getPercent2);
                                if (final < 100)
                                {
                                    if (dtr.TenVattu2 != null)
                                    {
                                        getTen = Helpers.RemoveVietnameseDiacritics(dtr.TenVattu2.ToString()).ToLower().Replace(".", " ");
                                        if (!string.IsNullOrEmpty(getTen))
                                        {
                                            getPercent2 = CalculateSimilarity(getTen2, getTen);
                                            getpercent2 = Fuzz.Ratio(getTen.ToLower(), getTen2.ToLower());
                                            var final2 = (0.6 * getpercent2 + 0.4 * getPercent2);
                                            if (final2 > final)
                                                final = final2;
                                        }
                                        //Tim theo tên thứ 2  
                                    }


                                }
                                if (final >= 90)
                                {
                                    //Thêm 1 bước kiểm tra
                                    try
                                    {
                                        Regex regex = new Regex(@"(\d+(g|ml|L|kg)|x\d+|(\d+\s*cái))");

                                        var match = regex.Match(getTen2).Value;
                                        var match2 = regex.Match(getTen).Value;
                                        if (match == match2)
                                        {
                                            FindVT findVT = new FindVT();
                                            findVT.Percent = getpercent2;
                                            findVT.Ten = getTen;
                                            findVT.Ten2 = getTen2;
                                            findVT.Code = dtr.SoHieu.ToString();
                                            lstFindVT.Add(findVT);
                                        }
                                    }
                                    catch (Exception ex)
                                    {
                                        continue;
                                    }

                                }
                                else
                                {
                                    lastfinal = final;
                                }
                                    
                                    int index = lstvt.IndexOf(dtr);
                                bool isLastElement = (index == lstvt.Count - 1);
                                if (isLastElement)
                                {
                                    var highestPercentItem = lstFindVT.OrderByDescending(v => v.Percent).FirstOrDefault();
                                    if (highestPercentItem != null && highestPercentItem.Percent>=90)
                                    {
                                        getcode = highestPercentItem.Code;
                                        lastfinal = highestPercentItem.Percent;
                                    }
                                    else
                                    {
                                        // var getdata = lstImportRa.Where(m => m.fileImportDetails.Any(n => n.Ten.ToLower() == it.Ten.Trim().ToLower())).FirstOrDefault();
                                        if (!dicListvt.ContainsKey(it.Ten.Trim().ToLower()))
                                        {
                                            getcode = GenerateResultString(NormalizeVietnameseString(it.Ten.Trim()));
                                            dicListvt.Add(it.Ten.Trim().ToLower(), getcode);
                                        }
                                        else
                                        {
                                            dicListvt.TryGetValue(it.Ten.Trim().ToLower(), out string value);
                                            getcode = value.ToString();
                                        } 
                                    }

                                    Console.WriteLine("Đây là phần tử cuối cùng.");
                                }
                            }
                        }
                        if (lstvt.Count == 0)
                        {
                            if (it.Ten != null)
                                getcode = GenerateResultString(NormalizeVietnameseString(it.Ten.Trim()));
                        }
                        if (!hasVattu)
                        {
                            // Update nội dung cho Parent
                            query = "UPDATE tbimport SET Noidung=? WHERE ID=?";
                            var parametersss = new OleDbParameter[]
                            {
                            new OleDbParameter("?", Helpers.ConvertUnicodeToVni(it.Ten)),
                            new OleDbParameter("?", kq2.Rows[0]["ID"]),
                            };
                            ExecuteQueryResult(query, parametersss);
                            hasVattu = true;
                            fileImport.Noidung = it.Ten;
                        }
                        //
                        // Chèn ch
                        // i tiết hóa đơn
                        string tkco = "";
                        string tkno = "";

                        tkno = kq2.Rows[0]["TKNo"].ToString();

                        if (it.Ten != null && (it.Ten.ToLower().Contains("điều chỉnh")))
                        {
                            if (fileImport.Type == 1)
                            {
                                fileImport.TKNo = "6421";
                            }
                        }
                        if (it.Ten != null && it.Ten.ToLower().Contains("chiết khấu") || it.tchat == 3 || it.Thtien < 0)
                        {
                            if (invoiceType == 5 || invoiceType == 10)
                            {
                                //tkno = "5211";
                                //tkco = kq2.Rows[0]["TKCo"].ToString();
                            }
                            else
                            {
                                tkco = "711";
                            }
                        }
                        else
                        {
                            tkco = kq2.Rows[0]["TKCo"].ToString();
                        }

                        if(it.Ten!=null &&   it.Ten.Contains("Đã giảm"))
                        {
                            string pattern = @"\d{1,3}(?:\.\d{3})*(?:,\d+)?"; // Hỗ trợ cả định dạng số với dấu phẩy và dấu chấm
                            Match match = Regex.Match(it.Ten, pattern);

                            if (match.Success)
                            {
                                Console.WriteLine($"Số tiền giảm: {match.Value} VND");
                                tkco = "711";
                                tkno = "152";
                                it.Dgia = 0;
                                it.Thtien = double.Parse(match.Value.Replace(".", ""));
                            }
                        }
                        query = @"INSERT INTO tbimportdetail ([ParentId], [SoHieu], [SoLuong], [DonGia], [DVT], [Ten], [MaCT], [TKNo], [TKCo], [TTien], [Percent]) 
                 VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)";

                        // Chuyển đổi các giá trị nếu cần
                        if (it.Thtien != null && it.Thtien < 0)
                        {
                            it.Thtien = it.Thtien * (-1);
                        }
                        lastfinal = Math.Round(lastfinal);
                        string lastfinals = lastfinal.ToString();
                        // Tạo mảng tham số
                        if (it.tchat == 3 && fileImport.Type==2)
                        {
                            tkno = "5211";
                        }
                        var parameters = new OleDbParameter[]
                         {
                            new OleDbParameter("?", kq2.Rows[0]["ID"]), // ParentId
                            new OleDbParameter("?", getcode),           // SoHieu
                            new OleDbParameter("?", it.Sluong ?? 0),    // SoLuong
                            new OleDbParameter("?", it.Dgia ?? 0),      // DonGia
                            new OleDbParameter("?", Helpers.ConvertUnicodeToVni(it.Dvtinh)), // DVT
                            new OleDbParameter("?", it.Ten != null ? Helpers.ConvertUnicodeToVni(it.Ten) : ""), // Ten
                            new OleDbParameter("?", ""),                  // MaCT
                            new OleDbParameter("?", tkno),                // TKNo
                            new OleDbParameter("?", tkco),                // TKCo
                            new OleDbParameter("?", it.Thtien ?? 0),     // TTien
                            new OleDbParameter("?", lastfinals)            // Percent
                         };
                        // Log parameter values for debugging

                        // Thực hiện truy vấn trong khối try-catch
                        try
                        {
                            ExecuteQueryResult(query, parameters);
                            //Cập nhật lại cho datattable importdetail
                            DataRow newRow = tbImportDt.NewRow();
                            newRow["ParentId"] = fileImport.ID;
                            newRow["SoHieu"] = getcode;
                            newRow["SoLuong"] = it.Sluong != null ? it.Sluong : 0;
                            newRow["DonGia"] = it.Dgia != null ? it.Dgia : 0;
                            newRow["DVT"] = it.Dvtinh;
                            newRow["Ten"] = it.Ten != null ? it.Ten : "";
                            newRow["TKNo"] = tkno;
                            newRow["TKCo"] = tkco;
                            newRow["TTien"] = it.Thtien != null ? it.Thtien : 0;
                            tbImportDt.Rows.Add(newRow);

                            getcode = "";
                        }
                        catch (Exception ex)
                        {
                            var aa = ex.Message;
                        }

                    }
                    //
                    if (kq2.Rows[0]["TgTCThue"].ToString() == "-100")
                    {
                        // Cập nhật trạng thái là đã lấy dữ liệu
                        query = "UPDATE tbimport SET TgTCThue=? WHERE ID=?";
                        var parametersss = new OleDbParameter[]
                        {
                                new OleDbParameter("?", ttrcthue),
                                new OleDbParameter("?", kq2.Rows[0]["ID"]),
                        };
                        ExecuteQueryResult(query, parametersss);
                        fileImport.TgTCThue = ttrcthue;
                    }
                    //Trường hợp giảm từ nghị quyết

                }
            }

        }
        public async void GetdetailXML(string nbmst, string khhdon, string shdon, string tokken)
        {
            string url = @"https://hoadondientu.gdt.gov.vn:30000/query/invoices/detail?nbmst=" + nbmst + "&khhdon=" + khhdon + "&shdon=" + shdon + "&khmshdon=1";
            using (var client = new HttpClient())
            {
                client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", tokken);
                client.DefaultRequestHeaders.Accept.Add(new MediaTypeWithQualityHeaderValue("application/json"));
                try
                {
                    // Gửi yêu cầu GET 

                    HttpResponseMessage response = await client.GetAsync(url);

                    // Đảm bảo phản hồi thành công
                    response.EnsureSuccessStatusCode();

                    // Đọc nội dung phản hồi
                    string responseBody = await response.Content.ReadAsStringAsync();
                    var rootObject = JsonConvert.DeserializeObject<Invoice>(responseBody);
                    //Tìm ID Cha mới nhất
                    string query = "SELECT *   FROM tbimport where SHDon=? and KHHDon=? and Mst= ?"; // Giả sử có cột DateAdded
                    var parameterss = new OleDbParameter[]
                      {
                            new OleDbParameter("?",shdon),
                            new OleDbParameter("?",khhdon),
                            new OleDbParameter("?",nbmst)
                      };
                    var kq2 = ExecuteQuery(query, parameterss);
                    string getcode = "";
                    if (kq2.Rows.Count > 0)
                    {
                        if (rootObject.Gchu != null && rootObject.Gchu.Contains("Đã giảm"))
                        {
                            string pattern = @"\d{1,3}(?:\.\d{3})*(?:,\d+)?"; // Hỗ trợ cả định dạng số với dấu phẩy và dấu chấm

                            // Tìm kiếm số trong chuỗi
                            Match match = Regex.Match(rootObject.Gchu, pattern);

                            if (match.Success)
                            {
                                Console.WriteLine($"Số tiền giảm: {match.Value} VND");
                                InvoiceLineItem invoiceLineItem = new InvoiceLineItem();
                                invoiceLineItem.tchat = 3;
                                invoiceLineItem.Thtien = double.Parse(match.Value.Replace(".", ","));
                                invoiceLineItem.Ten = rootObject.Gchu;
                                rootObject.Hdhhdvu.Add(invoiceLineItem);
                            }
                        }
                        foreach (var it in rootObject.Hdhhdvu)
                        {
                            //Xử lý tên
                            bool hasVattu = false;

                            //Update nội dung cho Parent
                            query = @"Update tbimport set Noidung=? where ID=?";
                            var parameters = new OleDbParameter[]
                             {
                        new OleDbParameter("?",Helpers.ConvertUnicodeToVni(rootObject.Hdhhdvu.FirstOrDefault().Ten)),
                        new OleDbParameter("?", kq2.Rows[0]["ID"]),
                             };
                            int resl = ExecuteQueryResult(query, parameters);

                            query = @"
                        INSERT INTO tbimportdetail (ParentId, SoHieu, SoLuong, DonGia, DVT, Ten,MaCT,TKNo,TKCo,TTien)
                        VALUES (?, ?, ?, ?, ?, ?,?,?,?,?)";

                            parameters = new OleDbParameter[]
                            {
                        new OleDbParameter("?", kq2.Rows[0]["ID"]),
                        new OleDbParameter("?", getcode),
                        new OleDbParameter("?", it.Sluong),
                        new OleDbParameter("?", it.Dgia),
                        new OleDbParameter("?", Helpers.ConvertUnicodeToVni(it.Dvtinh)),
                        new OleDbParameter("?", Helpers.ConvertUnicodeToVni(it.Ten)),
                        new OleDbParameter("?", ""),
                        new OleDbParameter("?", kq2.Rows[0]["TKNo"]),
                        new OleDbParameter("?", kq2.Rows[0]["TKCo"]),
                        new OleDbParameter("?", it.Thtien),
                            };

                            resl = ExecuteQueryResult(query, parameters);
                        }

                    }
                }
                catch (HttpRequestException e)
                {
                    Console.WriteLine($"Request error: {e.Message}");
                }
            }

        }
        public void UncheckImport(List<FileImport> lstImport, int type)
        {
            foreach (var item in lstImport)
            {
                if (item.fileImportDetails.Count == 0)
                {
                    item.Checked = false;
                }
            }
            if (type == 1)
                gridControl1.RefreshDataSource();
            else
                gridControl2.RefreshDataSource();
        }
        public static string RemoveLeadingZeros(string invoiceNumber)
        {
            if (string.IsNullOrEmpty(invoiceNumber))
                return invoiceNumber;

            return Regex.Replace(invoiceNumber, "^0+", "");
        }
