        int stt = 0;
        public static string IncrementSuffix(string input)
        {
            // Tìm '/' và tách chuỗi
            int index = input.LastIndexOf('/');
            if (index == -1)
            {
                //throw new ArgumentException("Chuỗi không chứa ký tự '/'");
                return "";
            }

            string prefix = input.Substring(0, index + 1); // Lấy phần trước '/'
            int number = int.Parse(input.Substring(index + 1)); // Lấy phần sau '/'

            // Tăng số lên 1
            number++;

            // Ghép lại chuỗi
            return prefix + number.ToString("D2"); // Định dạng thành 2 chữ số
        }
        private void DocfileNganhangExcel(string path)
        {
            progressPanel4.Caption = "Đang đọc dữ liệu";
              var query = "SELECT * FROM tbMatdinhghichu"; // Giả sử bạn muốn lấy tất cả dữ liệu từ bảng KhachHang
            DataTable tbMatdinhghichu = ExecuteQuery(query);

            string tknganhang = labelControl23.Text.Split('-')[0].ToString();
            string[] headers = { "rút ra", "Ngày hạch toán", "Withdrawal", "Dr" };
            using (var workbook = new XLWorkbook(path))
            {
                stt = 0;
                bool generate = false;
                string getlastString = "";
                foreach (var worksheet in workbook.Worksheets)
                {
                  
                    int findrow =0;
                    //Tìm row
                    foreach (var row in worksheet.Rows())
                    {
                        //foreach (var cell in row.Cells())
                        //{

                        //}
                        string cellValue1 = row.Cell(txtBankIndexTT1.Text).GetString(); // Cột A
                        if (headers.Any(header => cellValue1.Contains(header)))
                        {
                            findrow= row.RowNumber();
                        } 
                    }

                    //Đọc nội dung
                  
                    foreach (var row in worksheet.Rows().Skip(findrow))
                    {
                      
                        //Lấy nội dung cột ngày
                        string getNgay = row.Cell(txtBankIndexNgay.Text).GetString(); // Cột A
                        string getNoidung = row.Cell(txtBankIndexNoidung.Text).GetString(); // Cột A
                        Nganhang nganhang = new Nganhang();
                        nganhang.Diengiai = getNoidung.Replace("\r\n", " ")
                  .Replace("\n", " ")
                  .Replace("\r", " ");                                               //Lấy nội dung cột nội dung
                        if (string.IsNullOrEmpty(nganhang.Diengiai))
                            continue;
                       
                        stt += 1;
                        if (!string.IsNullOrEmpty(getNgay) && DateTime.TryParse(getNgay, out DateTime parsedDate))
                        {
                            nganhang.NgayGD = parsedDate;
                        }
                        else
                        {
                            nganhang.NgayGD = DateTime.MinValue; // Hoặc giá trị mặc định khác nếu cần
                        } 
                        if (nganhang.NgayGD==DateTime.MinValue)
                        {
                            //continue;
                        }
                        
                        try
                        {
                            string number1 = row.Cell(txtBankIndexTT1.Text).GetString().Replace(".", "").Replace(",", "");
                            nganhang.ThanhTien = !string.IsNullOrEmpty(number1) ? double.Parse(number1) : 0;
                            string number2 = row.Cell(txtBankIndexTT2.Text).GetString().Replace(".", "").Replace(",", "");
                            nganhang.ThanhTien2 = !string.IsNullOrEmpty(number2) ? double.Parse(number2) : 0;
                        }
                        catch (Exception ex)
                        {
                            Console.WriteLine(ex.Message);
                        }
                        //Kiểm tra chứng từ này đã import chưa
                        if (existingTbChungtu.AsEnumerable().Any(m => m.Field<DateTime>("NgayCT").Date == nganhang.NgayGD.Date && (m.Field<double>("SoPS") == nganhang.ThanhTien || m.Field<double>("SoPS") == nganhang.ThanhTien2)))
                            continue;
                        //Load mã số
                        var getLastctNganhang = existingTbChungtu.AsEnumerable().Where(m => m["MaLoai"].ToString() == "4" && m.Field<DateTime>("NgayCT").Month== nganhang.NgayGD.Month && nganhang.NgayGD!=DateTime.MinValue).LastOrDefault();
                        if (getLastctNganhang != null && !generate)
                        {
                            generate = true;
                            getlastString = getLastctNganhang.Field<string>("SoHieu");
                            nganhang.Maso = IncrementSuffix(getlastString);
                        }
                        else
                        {
                            if (generate)
                            {
                                getlastString = IncrementSuffix(getlastString);
                                nganhang.Maso = getlastString;
                            }
                            else
                            {
                                generate = true;
                                if (labelControl23.Text.ToLower().Contains("acb"))
                                {
                                    getlastString = $"ACB{nganhang.NgayGD.Month}/01";
                                }
                                if (labelControl23.Text.ToLower().Contains("agr"))
                                {
                                    getlastString = $"AGR{nganhang.NgayGD.Month}/01";
                                }
                                if (labelControl23.Text.ToLower().Contains("hd"))
                                {
                                    getlastString = $"HD{nganhang.NgayGD.Month}/01";
                                }
                                nganhang.Maso = getlastString;
                            }
                        }
                        //Tài khoản nợ có mặc định
                        if (nganhang.ThanhTien != 0)
                        {
                            nganhang.TKNo = "1111";
                            nganhang.TKCo = tknganhang;
                        }
                        else
                        {
                            nganhang.TKNo = tknganhang;
                            nganhang.TKCo = "1111";
                        }
                        if (nganhang.ThanhTien == 0 && nganhang.ThanhTien2 == 0)
                            continue;
                        nganhang.Checked = true;
                        nganhang.Stt = stt;

                        var findMakh = false;
                        if (!string.IsNullOrEmpty(nganhang.Diengiai))
                        {

                            string loai_4 = "";
                            string loai_3 = "";
                            string loai_2 = "";
                            string loai_4n = "";
                            string loai_3n = "";
                            string loai_2n = "";
                            //Tìm mã khách hàng thông qua diễn giải
                            bool hasTen = false;
                            query = "SELECT * FROM License";
                            var kq2 = ExecuteQuery(query, null);
                            bool hastenghichu = false;

                            if (hastenghichu == false)
                            {
                                foreach (DataRow dtrow in tbKhachhang.Rows)
                                {


                                    string getTen = Helpers.RemoveVietnameseDiacritics(Helpers.ConvertVniToUnicode(dtrow["Ten"].ToString()));
                                    if(nganhang.Diengiai.Contains("NGUYEN PHUONG THU"))
                                    {
                                        int testt = 10;
                                    }

                                    List<string> wordsToReplace = new List<string>
                                {
                                   "thue","cty", "tnhh", "cong ty", "cp tm", "noi that", "vung tau", "dich vu","tinh","brvt","dau gia","tai san","ba ria","mam non","ubnd","hang hai","trach nhiem","huu han","xay dung","dau tu","dau khi","tm","sx","cn","vung  tau","tham dinh","trung tam","thuong mai","quan ly","lien doanh","tu dong","giai phap","o to","kiem soat","co phan","thiet bi","trung tam","ky thuat","san xuat","do go","nha nuoc khu vuc","bac nha nuoc","khu vuc","so 1","nha nuoc","cp dv","dv va","lap dat","nha khoa","hoa don","va xd","xd","cp dt","viet nam","ke toan"
                                };
                                    //Lấy tên công ty

                                    string tencty = Helpers.RemoveVietnameseDiacritics(Helpers.ConvertVniToUnicode(kq2.Rows[0]["TenCty"].ToString()));
                                    tencty = ReplaceWords(tencty.Trim().ToLower(), wordsToReplace).ToLower();

                                    string str1 = ReplaceWords(getTen.Trim().ToLower(), wordsToReplace).ToLower();
                                    if (str1.Contains("theone"))
                                    {
                                        var hasone = "Sdad";
                                    }
                                    string str2 = nganhang.Diengiai.ToLower();
                                    var commonPhrases = Helpers.FindCommonAdjacentPhrases(str1, str2, 4);
                                    if (commonPhrases.Count > 0 && !commonPhrases.Any(m => m.Contains(tencty)))
                                    {
                                        loai_4 = Helpers.ConvertVniToUnicode(dtrow["SoHieu"].ToString());
                                        loai_4n = Helpers.ConvertVniToUnicode(dtrow["Ten"].ToString());
                                        hasTen = true;
                                    }
                                    if (commonPhrases.Count() == 0)
                                    {
                                        commonPhrases = Helpers.FindCommonAdjacentPhrases(str1, str2, 3);
                                        if (commonPhrases.Count > 0 && !commonPhrases.Any(m => m.Contains(tencty)))
                                        {
                                            loai_3 = Helpers.ConvertVniToUnicode(dtrow["SoHieu"].ToString());
                                            loai_3n = Helpers.ConvertVniToUnicode(dtrow["Ten"].ToString());
                                            hasTen = true;
                                        }
                                        if (commonPhrases.Count() == 0)
                                        {
                                            commonPhrases = Helpers.FindCommonAdjacentPhrases(str1, str2, 2);
                                            if (commonPhrases.Count > 0 && !commonPhrases.Any(m => m.Contains(tencty)))
                                            {
                                                if (string.IsNullOrEmpty(loai_2))
                                                {
                                                    loai_2 = Helpers.ConvertVniToUnicode(dtrow["SoHieu"].ToString());
                                                    loai_2n = Helpers.ConvertVniToUnicode(dtrow["Ten"].ToString());
                                                }
                                                hasTen = true;
                                            }
                                        }
                                    }

                                }

                                if (hasTen)
                                {
                                    //nganhang.MaKH = Helpers.ConvertVniToUnicode(dtrow["Ten"].ToString()) + " | " + dtrow["SoHieu"].ToString();
                                    if (!string.IsNullOrEmpty(loai_4))
                                    {
                                        nganhang.MaKH = loai_4;
                                        nganhang.TenKH = loai_4n;
                                    }
                                    else
                                    {
                                        if (!string.IsNullOrEmpty(loai_3))
                                        {
                                            nganhang.MaKH = loai_3;
                                            nganhang.TenKH = loai_3n;
                                        }
                                        else
                                        {
                                            if (!string.IsNullOrEmpty(loai_2))
                                            {
                                                nganhang.MaKH = loai_2;
                                                nganhang.TenKH = loai_2n;
                                            }
                                        }
                                    }
                                    //Tìm tk 131
                                    var getTk131 = existingTbHeThongTK.AsEnumerable().Where(m => m.Field<string>("SoHieu").StartsWith("131")).ToList();
                                    if (getTk131.Count == 1)
                                    {
                                        if (nganhang.ThanhTien2 > 0)
                                        {
                                            nganhang.TKCo = "131";
                                        }
                                    }
                                    else
                                    {
                                        if (nganhang.ThanhTien2 > 0)
                                        {
                                            nganhang.TKCo = "1311";
                                        }
                                    }
                                    //
                                    //Tìm tk 3311
                                    var getTk331 = existingTbHeThongTK.AsEnumerable().Where(m => m.Field<string>("SoHieu").StartsWith("331")).ToList();
                                    if (getTk331.Count == 1)
                                    {
                                        if (nganhang.ThanhTien > 0)
                                        {
                                            nganhang.TKNo = "331";
                                        }
                                    }
                                    else
                                    {
                                        if (nganhang.ThanhTien > 0)
                                        {
                                            nganhang.TKNo = "3311";
                                        }
                                    }


                                    findMakh = true;
                                }
                            }

                            //Tìm mã khách hàng thông qua số hoá đơn
                            if (findMakh == false)
                            {
                                string number = Helpers.ExtractNumber(nganhang.Diengiai);
                                bool isFindSohd = false;
                                if (number != "Không tìm thấy số" && number != "")
                                {
                                    //Tìm bỏ số 0 trước
                                    int number2 = int.Parse(number);

                                    int countwhile = 3;
                                    string makh = "";
                                    nganhang.SoHD = number2.ToString();
                                    double TT = 0;
                                    //Kiem tra hoa don truoc


                                    var getlist = existingTbChungtu != null ? existingTbChungtu.AsEnumerable().Where(m => m.Field<string>("SoHieu").EndsWith(number2.ToString())).ToList() : null;
                                    if (getlist != null)
