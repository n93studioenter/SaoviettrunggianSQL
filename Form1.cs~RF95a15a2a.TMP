        public static string ReplaceWords(string input, List<string> wordsToReplace)
        {
            foreach (var word in wordsToReplace)
            {
                input = input.Replace(word, "");
            }
            return input.Trim(); // Loại bỏ khoảng trắng thừa
        }
        static DataTable ExtractDataFromPdf(string pdfPath)
        {
            DataTable dataTable = new DataTable();
            // Định nghĩa các cột trong DataTable
            dataTable.Columns.Add("Column1");
            dataTable.Columns.Add("Column2");

            using (iText.Kernel.Pdf.PdfReader pdfReader = new iText.Kernel.Pdf.PdfReader(pdfPath))
            using (PdfDocument pdfDocument = new PdfDocument(pdfReader))
            {
                for (int i = 1; i <= pdfDocument.GetNumberOfPages(); i++)
                {
                    string text = PdfTextExtractor.GetTextFromPage(pdfDocument.GetPage(i));
                    var lines = text.Split('\n');
                    foreach (var line in lines)
                    {
                        if (!string.IsNullOrWhiteSpace(line))
                        {
                            var columns = line.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
                            if (columns.Length == dataTable.Columns.Count)
                            {
                                dataTable.Rows.Add(columns);
                            }
                            else
                            {
                                Console.WriteLine($"Số cột không khớp: {columns.Length}");
                            }
                        }
                    }
                }
            }
            return dataTable;
        }

        static void SaveDataTableToExcel(DataTable dataTable, string excelPath)
        {
            using (var workbook = new XLWorkbook())
            {
                var worksheet = workbook.Worksheets.Add("Sheet1");
                worksheet.Cell(1, 1).InsertTable(dataTable);
                workbook.SaveAs(excelPath);
            }
        }
        int currentIndex = 0;
        DevExpress.XtraGrid.Views.Grid.GridView gridCurrent;
        private void gridView5_RowClick(object sender, RowClickEventArgs e)
        {
            gridCurrent = sender as DevExpress.XtraGrid.Views.Grid.GridView;
            string columnName = gridView5.FocusedColumn.FieldName;
            currentIndex = gridView5.FocusedRowHandle;
            if (columnName != "Checked")
                gridView5.ShowEditor(); // Hiển thị chế độ chỉnh sửa
        }

        private void gridView5_RowCellClick(object sender, RowCellClickEventArgs e)
        {
            if (e.Column.FieldName == "Checked") // Thay đổi tên cột cho phù hợp
            {
                var getAcess = (bool)gridView5.GetRowCellValue(e.RowHandle, "Checked");
                if (getAcess)
                {
                    gridView5.SetRowCellValue(e.RowHandle, e.Column, false);
                }
                else
                {
                    gridView5.SetRowCellValue(e.RowHandle, e.Column, true);
                }
            }
        }

        private void gridView5_KeyUp(object sender, KeyEventArgs e)
        {
            if (e.KeyCode == System.Windows.Forms.Keys.Enter)
            {
                string columnName = gridView5.FocusedColumn.FieldName;
                if (columnName != "MaKH")
                    return;
                var selectedCells = gridView5.GetSelectedCells();
                int currentRowHandle = gridView5.FocusedRowHandle;
                string mst = "";
                string ten = "";
                frmKhachhang frmKhachhang = new frmKhachhang();
                frmKhachhang.Khachhang vatTu = new frmKhachhang.Khachhang();
                frmKhachhang.frmMain = this;

                if (gridView5.GetRowCellValue(currentRowHandle, gridView5.FocusedColumn) != null)
                {
                    var currentValue = Helpers.ConvertUnicodeToVni(gridView5.GetRowCellValue(currentRowHandle, gridView5.FocusedColumn).ToString()).ToLower();
                    //
                    var findcus = tbKhachhang.AsEnumerable().Where(m => m.Field<string>("Ten").ToLower().Equals(currentValue.ToString().ToLower())).FirstOrDefault();
                    if (findcus != null)
                    {
                        mst = findcus["SoHieu"].ToString();
                        ten = findcus["Ten"].ToString();
                    }



                    DataRow kh = null;
                    if (!string.IsNullOrEmpty(mst))
                    {
                        kh = tbKhachhang.AsEnumerable().Where(row => row.Field<string>("MST") == mst).FirstOrDefault();
                        //Nếu ko lấy dc thì chuyển sang kiem tra theo số hiệu
                        if (kh == null)
                        {
                            kh = tbKhachhang.AsEnumerable().Where(row => row.Field<string>("SoHieu") == mst).FirstOrDefault();
                        }
                    }
                    else
                    {
                        if (!string.IsNullOrEmpty(ten))
                        {
                            ten = Helpers.ConvertUnicodeToVni(ten);
                            kh = tbKhachhang.AsEnumerable().Where(row => Helpers.RemoveVietnameseDiacritics(Helpers.ConvertVniToUnicode(row.Field<string>("Ten").ToLower())) == Helpers.RemoveVietnameseDiacritics(Helpers.ConvertVniToUnicode(ten.ToLower()))).FirstOrDefault();
                        }
                    }
                    if (kh != null && !string.IsNullOrEmpty(kh["MaSo"].ToString()))
                    {
                        vatTu.MaSo = int.Parse(kh["MaSo"].ToString());
                        vatTu.Ten = Helpers.ConvertVniToUnicode(ten);
                        vatTu.Mst = kh["MST"] != null ? kh["MST"].ToString() : "";
                        vatTu.DiaChi = kh["DiaChi"] != null ? Helpers.ConvertVniToUnicode(kh["DiaChi"].ToString()) : "";
                        vatTu.SoHieu = kh["SoHieu"].ToString();
                        vatTu.MaPhanLoai = int.Parse(kh["MaPhanLoai"].ToString());
                        currentselectId = int.Parse(kh["MaPhanLoai"].ToString());
                    }
                }

                frmKhachhang.dtoVatTu = vatTu;
                frmKhachhang.ShowDialog();
                if (!string.IsNullOrEmpty(hiddenValue3) && frmKhachhang.isChange)
                {
                    var findRow = tbKhachhang.AsEnumerable().Where(m => m.Field<string>("MST") == hiddenValue3).FirstOrDefault();
                    gridView5.SetRowCellValue(currentRowHandle, "MaKH", Helpers.ConvertVniToUnicode(findRow["Ten"].ToString()));
                }
            }
        }
