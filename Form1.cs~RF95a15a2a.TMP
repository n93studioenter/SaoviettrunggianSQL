        private List<TbImport> lstdsRa = new List<TbImport>();
        private bool CheckExistKH(string mst)
        {
            
            //Nếu có Mã s61 thuế
            if (!string.IsNullOrEmpty(mst))
            {
                if (tbKhachhang.AsEnumerable().Any(row => row.Field<string>("MST") == mst || row.Field<string>("SoHieu")==mst) )
                {
                    return true;
                }
            }

            return false;
        }
        public void DocfileXml(int type)
        {
            lstdsVao = new List<TbImport>();
            lstdsRa = new List<TbImport>();
            //Tạo lookup vattu
            string querykh = @" SELECT *  FROM tbDinhdanhtaikhoan"; // Sử dụng ? thay cho @mst trong OleDb
            tbDinhDanhtaikhoan = ExecuteQuery(querykh, new OleDbParameter("?", ""));
            progressPanel1.Visible = true;
            string path = (type == 1 ? "HDVao" : "HDRa");
            string directoryPath = Path.Combine(savedPath, path, dtTungay.DateTime.Month.ToString());

            int fromMonth = int.Parse(dtTungay.DateTime.Month.ToString()); // Thay đổi theo tháng bắt đầu (ví dụ: 3 cho tháng 3)
            int toMonth = int.Parse(dtDenngay.DateTime.Month.ToString());   // Thay đổi theo tháng kết thúc (ví dụ: 7 cho tháng 7)
            // Lấy tất cả các file XML từ các thư mục tháng từ fromMonth đến toMonth
            var files = Directory.EnumerateFiles(directoryPath, "*.xml", SearchOption.AllDirectories).ToList();

            int stt = 1;
            XmlDocument xmlDoc = new XmlDocument();
            foreach (var  file in files)
            {
                if(file== "D:\\Hosocongty\\Vuonpho\\Hoadon\\HDRa\\12\\3502469834_948_C25MVP.xml")
                {
                    int fix = 10;
                }
                try
                {
                    using (StreamReader reader = new StreamReader(file, Encoding.UTF8))
                    {
                        try
                        {
                            xmlDoc.Load(reader); // Tải file XML
                        }
                        catch (XmlException ex)
                        {
                            Console.WriteLine($"Lỗi khi tải file XML: {ex.Message}");
                            return;
                        }
                        TbImport TbImport = new TbImport();
                        XmlNode root = xmlDoc.DocumentElement;
                        XmlNode TTChung = root.SelectSingleNode("//TTChung");
                        DateTime NLap = DateTime.Parse(TTChung.SelectSingleNode("NLap")?.InnerText);
                        TbImport.NLap = NLap;
                        //Kiểm tra lấy trong ngày
                        if (NLap >= dtTungay.DateTime && NLap <= dtDenngay.DateTime)
                        {
                            if (type == 1)
                            {
                                progressPanel1.Caption = $"Đang đọc file {stt}";
                                Application.DoEvents();
                            }
                            else
                            {
                                progressPanel2.Caption = $"Đang đọc file {stt}";
                                Application.DoEvents();
                            }

                                TbImport.SHDon = Helpers.RemoveLeadingZeros(TTChung.SelectSingleNode("SHDon")?.InnerText);
                            TbImport.KHHDon = TTChung.SelectSingleNode("KHHDon")?.InnerText;
                            TbImport.Path = file;
                            if (type == 1)
                            {
                                TbImport.Ten = Helpers.ConvertUnicodeToVni(root.SelectSingleNode("//NBan//Ten").InnerText);
                                TbImport.Mst = root.SelectSingleNode("//NBan//MST").InnerText;
                                 
                            }
                            else
                            {
                                TbImport.Mst = root.SelectSingleNode("//NMua//MST") != null ? root.SelectSingleNode("//NMua//MST").InnerText : "";
                                //Kiểm tra tên KH
                                if (root.SelectSingleNode("//NMua//Ten") != null)
                                {
                                    TbImport.Ten = Helpers.ConvertUnicodeToVni(root.SelectSingleNode("//NMua//Ten").InnerText);
                                }
                                //Trường hợp không có tên thì lấy khách lẻ
                                else
                                {
                                    if (root.SelectSingleNode("//NMua//HVTNMHang") != null)
                                    {
                                        TbImport.Ten = Helpers.ConvertUnicodeToVni(root.SelectSingleNode("//NMua//HVTNMHang").InnerText);
                                    }
                                    if (TbImport.Ten == "Baùn leû khaùch khoâng laáy hoùa ñôn" || string.IsNullOrEmpty(TbImport.Ten) || TbImport.Ten== "Ngöôøi mua khoâng laáy hoùa ñôn")
                                    {
                                        //Tìm khách lẻ
                                        var findKL = tbKhachhang.AsEnumerable().Where(m => m.Field<string>("SoHieu") == "KL").FirstOrDefault();
                                        if (findKL != null)
                                        {
                                            TbImport.Ten = findKL.Field<string>("Ten");
                                            TbImport.Mst = findKL.Field<string>("SoHieu");
                                        }
                                    }
                                }
                            }
                            //Nếu không có MST thì thay thế = CCCD
                            string Sohieu = "";
                            if (string.IsNullOrEmpty(TbImport.Mst))
                            {
                                if (root.SelectSingleNode("//NMua//CCCDan") != null)
                                {
                                    TbImport.Mst = root.SelectSingleNode("//NMua//CCCDan")!=null? root.SelectSingleNode("//NMua//CCCDan").InnerText:"";
                                }
                                if(string.IsNullOrEmpty(TbImport.Mst))
                                {
                                    //Nếu không có MST, CCCD thì kiểm tra tên

                                    if (!string.IsNullOrEmpty(TbImport.Ten))
                                    {
                                        //Kiểm tra tên có trùng chưa
                                        var findcus = tbKhachhang.AsEnumerable().Where(m => m.Field<string>("Ten")== TbImport.Ten).FirstOrDefault();
                                        if (findcus==null)
                                        {
                                             Sohieu = GenerateAbbreviation(Helpers.ConvertVniToUnicode(TbImport.Ten), tbKhachhang.AsEnumerable().Select(row => row.Field<string>("SoHieu")).ToList()).ToUpper();
                                            //Xử lý khi số hiệu bị trùng
                                            int suffix = 1;
                                            string originalSohieu = Sohieu;

                                            while (tbKhachhang.AsEnumerable().Any(row => row.Field<string>("SoHieu") == Sohieu))
                                            {
                                                Sohieu = $"{originalSohieu}_{suffix}";
                                                suffix++;
                                            }
                                            TbImport.Mst = Sohieu;
                                        }
                                        else
                                        {
                                            TbImport.Mst = findcus.Field<string>("SoHieu");
                                        }
                                    }
                                    else
                                    {
                                        var findKL = tbKhachhang.AsEnumerable().Where(m => m.Field<string>("SoHieu") == "KL").FirstOrDefault();
                                        if (findKL != null)
                                        {
                                            TbImport.Ten = findKL.Field<string>("Ten");
                                            TbImport.Mst = findKL.Field<string>("SoHieu");
                                        }
                                    }

                                      
                                }
                            }
                            //Kiểm tra hoá đon 
                            if (Kiemtrahoadon(TbImport.SHDon, TbImport.NLap, TbImport.Mst))
                                continue;
                            if (KiemtrahoadonCT(TbImport.SHDon, TbImport.NLap, TbImport.Mst))
                                continue;
                            //Kiểm tra khách hàng có tạo chưa

                            if (TbImport.Mst != "KL")
                            {
                                if (CheckExistKH(TbImport.Mst) == false)
                                {
                                    int maphanloai = 0;
                                    maphanloai = type == 1 ? 2 : 3; //1 là mua, 2 là bán  
                                    string diachi = "";
                                    if (type == 1)
                                        diachi = root.SelectSingleNode("//NBan//DChi")!=null? root.SelectSingleNode("//NBan//DChi").InnerText:"";
                                    else
                                        diachi = root.SelectSingleNode("//NMua//DChi")!=null? root.SelectSingleNode("//NMua//DChi").InnerText:"";

                                    string sdt = "";
                                    if (type == 1)
                                        sdt = root.SelectSingleNode("//NBan//SDThoai") != null ? root.SelectSingleNode("//NBan//SDThoai").InnerText : "";
                                    else
                                        sdt = root.SelectSingleNode("//NMua//SDThoai") != null ? root.SelectSingleNode("//NMua//SDThoai").InnerText : "";
                                    InitCustomer(maphanloai, Sohieu, TbImport.Ten, diachi, TbImport.Mst, "", sdt);
                                }
                            }
                            //Kiểm tra có tạo chưa
                            if (type == 1)
                            {
                                if (lstImportVao.Any(m=>m.SHDon== TbImport.SHDon && m.NLap.Date == NLap.Date) )
                                {
                                    continue;
                                }
                            }
                            else
                            {
                                if (lstImportRa.Any(m => m.SHDon == TbImport.SHDon && m.NLap.Date == NLap.Date))
                                {
                                    continue;
                                }
                            }


                            //Load mặc định
                            if (tbDinhDanhtaikhoan.Rows.Count > 0)
                            {
                                string keyword = type == 1 ? "Ưu tiên vào" :
                                                 type == 2 ? "Ưu tiên ra" : null;

                                if (keyword != null)
                                {
                                    DataRow foundRow = tbDinhDanhtaikhoan.AsEnumerable()
                                        .FirstOrDefault(row => row.Field<string>("KeyValue")?.Contains(keyword) == true);

                                    if (foundRow != null)
                                    {
                                        TbImport.TKNo = foundRow["TKNo"].ToString();
                                        TbImport.TKCo = foundRow["TKCo"].ToString();
                                        TbImport.TkThue = foundRow["TKThue"].ToString();
                                    }
                                }
                            }
                            TbImport.Status = 0;
                            TbImport.Ngaytao = DateTime.Now.ToShortDateString();


                            //Thông tin thanh toán
                            TbImport.TongTien = double.Parse(root.SelectSingleNode("//TgTTTBSo").InnerText);
                            TbImport.TgTCThue = root.SelectSingleNode("//TgTCThue") != null ? double.Parse(root.SelectSingleNode("//TgTCThue").InnerText) : 0;
                            TbImport.TgTThue = root.SelectSingleNode("//TgTThue") != null ? double.Parse(root.SelectSingleNode("//TgTThue").InnerText) : 0;
                            // TbImport.Vat = double.Parse(root.SelectSingleNode("//TSuat").InnerText.Replace("%",""));
                            //
                            XmlNodeList nodeList = xmlDoc.SelectNodes("//LTSuat");
                            int index = 0;
                            foreach (XmlNode node in nodeList)
                            {
                                var suat = new SuatThue
                                {
                                    TSuat = node.SelectSingleNode("TSuat")?.InnerText,
                                    ThTien = double.Parse(node.SelectSingleNode("ThTien")?.InnerText ?? "0"),
                                    TThue = double.Parse(node.SelectSingleNode("TThue")?.InnerText ?? "0")
                                };
                                if (suat != null)
                                {
                                    if (!string.IsNullOrEmpty(suat.TSuat))
                                    {
                                        if (index == 0)
                                        {
                                            TbImport.TgTCThue1 = suat.ThTien;
                                            TbImport.TVat = suat.TThue;
                                      
                                            //KKKNT KCT
                                            if (suat.TSuat == "KCT" || suat.TSuat == "KKKNT")
                                            {
                                                TbImport.Vat = 0;
                                            }
                                            else
                                            {
                                                TbImport.Vat = double.Parse(suat.TSuat.Replace("%", ""));
                                            }
                                        }
                                        if (index == 1)
                                        {
                                            TbImport.TgTCThue2 = suat.ThTien;
                                            TbImport.TVat2 = suat.TThue;
                                            if (suat.TSuat == "KCT" || suat.TSuat == "KKKNT")
                                            {
                                                TbImport.Vat2 = "0";
                                            }
                                            else
                                            {
                                                TbImport.Vat2 = suat.TSuat.Replace("%", "");
                                            }
                                        }
                                        if (index == 2)
                                        {
                                            TbImport.TgTCThue3 = suat.ThTien;
                                            TbImport.TVat3 = suat.TThue;
                                          
                                            if (suat.TSuat == "KCT" || suat.TSuat == "KKKNT")
                                            {
                                                TbImport.Vat3 = "0";
                                            }
                                            else
                                            {
                                                TbImport.Vat3 = suat.TSuat.Replace("%", "");
                                            }
                                        }
                                    }
                                }
                                index += 1;
                            }


                         
                            //Trường hợp không chịu thuế
                            //if (vat == "KCT" || vat == "KKKNT")
                            //{
                            //    vat = "0";
                            //}

                            //KHMSHDon
                            TbImport.Khmshdon = root.SelectSingleNode("//KHMSHDon").InnerText;
                            string THDon = root.SelectSingleNode("//THDon").InnerText;
                            TbImport.hdon = "01";
                            if (Helpers.NormalizeVietnameseString(THDon.ToLower()).Contains("hóa đơn giá trị gia tăng") || Helpers.NormalizeVietnameseString(THDon.ToLower()).Contains("hóa đơn điện tử giá trị gia tăng"))
                            {
                                TbImport.hdon = "01";
                            }
                            if (Helpers.NormalizeVietnameseString(THDon.ToLower()).Contains("hóa đơn bán hàng"))
                            {
                                TbImport.hdon = "02";
                            }

                            XmlNodeList nodeListHHDVu = xmlDoc.SelectNodes("//HHDVu");
                            cacheMatHangTrongHoaDon = new Dictionary<string, TbImportDetail>(StringComparer.OrdinalIgnoreCase);
                            
                            foreach (XmlNode node in nodeListHHDVu)
                            {
                                try
                                {
                                    if(node.SelectSingleNode("THHDVu")?.InnerText== "Mì Cung Đình Koolspaghetti thố khuyến mãi")
                                    {
                                        int tets = 10;
                                    }
                                    TbImportDetail tbImportDetail = new TbImportDetail();
                                    if (Loaiborow(node.SelectSingleNode("THHDVu")?.InnerText))
                                        continue;
                                    tbImportDetail.Tchat = int.Parse(node.SelectSingleNode("TChat")?.InnerText);
                                    tbImportDetail.Ten = node.SelectSingleNode("THHDVu")?.InnerText;
                                    bool dagiam = false;
                                    if(tbImportDetail.Ten.Contains("Đã giảm"))
                                    {
                                        dagiam = true;
                                        string pattern = @"\d{1,3}(?:\.\d{3})*(?:,\d+)?"; // Hỗ trợ cả định dạng số với dấu phẩy và dấu chấm
                                        Match match = Regex.Match(tbImportDetail.Ten, pattern);

                                        if (match.Success)
                                        {
                                            tbImportDetail.TTien =  double.Parse(match.Value.Replace(".", "")); 
                                        }
                                    }
                                    //Loại bỏ
                                    if (tbImportDetail.Tchat == 4 && dagiam==false)
                                        continue;

                                    var dvtNode = node.SelectSingleNode("DVTinh");
                                    tbImportDetail.DVT = CapitalizeFirstLetter(
                                        Helpers.ConvertUnicodeToVni(dvtNode?.InnerText));

                                    var slNode = node.SelectSingleNode("SLuong");
                                    tbImportDetail.Soluong = slNode != null && double.TryParse(slNode.InnerText, out var qty) ? qty  : 0;

                                    var nodeGia = node.SelectSingleNode("DGia");
                                    tbImportDetail.Dongia = nodeGia != null && double.TryParse(nodeGia.InnerText, out double value) ? value : 0;
                                    if (tbImportDetail.TTien == 0)
                                        tbImportDetail.TTien = node.SelectSingleNode("ThTien") != null ? double.Parse(node.SelectSingleNode("ThTien")?.InnerText) : 0;


                                    // —————— SIÊU TỐI ƯU TẠI ĐÂY (thay toàn bộ đoạn cũ) ——————
                                    string keyCache = NormalizeVietnameseString(tbImportDetail.Ten); // dùng hàm chuẩn hóa của bạn
                                    if(node.SelectSingleNode("THHDVu")?.InnerText== "Xăng RON 95 Mức 3")
                                    {
                                        int a = 10;
                                    }
                                    if (cacheMatHangTrongHoaDon.TryGetValue(keyCache, out TbImportDetail daXuLy))
                                    {
                                        // Đã xử lý rồi → copy kết quả
                                        tbImportDetail.SoHieu = daXuLy.SoHieu;
                                        tbImportDetail.Percent = daXuLy.Percent;
                                    }
                                    else
                                    {
                                        // Chưa xử lý → gọi hàm gán mã (chỉ chạy 1 lần!)
                                        Xulysohieuvattu(tbImportDetail);

                                        // Lưu vào cache
                                        cacheMatHangTrongHoaDon[keyCache] = tbImportDetail;
                                    }

                                    //Kiem tra xem sản phẩm này đã xử lý chưa
                                    //var checkExist = TbImport.tbImportDetails.Where(m => m.Ten == tbImportDetail.Ten).FirstOrDefault();
                                    //if (checkExist == null)
                                    //    Xulysohieuvattu(tbImportDetail);
                                    //else
                                    //{
                                    //    tbImportDetail.SoHieu = checkExist.SoHieu;
                                    //    tbImportDetail.Percent = checkExist.Percent;
                                    //}
                                    //Chuyển lại unicode sang vni cho tên
                                    tbImportDetail.Ten = Helpers.ConvertUnicodeToVni(tbImportDetail.Ten);

                                    //Điền tk nợ có
                                    tbImportDetail.TKNo = TbImport.TKNo;
                                    tbImportDetail.TKCo = TbImport.TKCo;
                                    if (type == 1)
                                    {
                                        if (tbImportDetail.Tchat == 3 || dagiam==true)
                                        {
                                            tbImportDetail.TKCo = "711";
                                        }
                                    }
                                    tbImportDetail.Percent =Math.Round(double.Parse(tbImportDetail.Percent.ToString()));
                                    TbImport.tbImportDetails.Add(tbImportDetail);
                                }
                                catch(Exception ex)
                                {
                                    XtraMessageBox.Show(node.SelectSingleNode("THHDVu")?.InnerText +"   "+TbImport.SHDon);
                                }
                                
                            }

                            //Cập nhật nội dung cho Parent
                            if (string.IsNullOrEmpty(TbImport.Noidung))
                            {
                                if (TbImport.tbImportDetails.Count > 0)
                                {
                                    if (string.IsNullOrEmpty(TbImport.Noidung))
                                        TbImport.Noidung = TbImport.tbImportDetails.FirstOrDefault().Ten;
                                }
                                
                            }

                            if (type == 1)
                                lstdsVao.Add(TbImport);
                            else
                                lstdsRa.Add(TbImport);

                            //Load chi tiết
                            stt += 1;
                        }
                    }
                }
                catch(Exception ex)
                {
                    XtraMessageBox.Show(file);
                }
              
            }
           // gridControl1.DataSource = lstdsVao;
        }
        // ──────────────────────────────── Helper siêu an toàn ────────────────────────────────
        // KHAI BÁO Ở ĐẦU CLASS (trong Form của bạn)
        private Dictionary<string, TbImportDetail> cacheMatHangTrongHoaDon;
        private string GetSafeText(XmlNode parent, string xpath)
        {
            try { return parent.SelectSingleNode(xpath)?.InnerText?.Trim() ?? ""; }
            catch { return ""; }
        }
        private double SafeDouble(string s) => double.TryParse(s, out double d) ? d : 0;
        private int SafeInt(string s) => int.TryParse(s, out int i) ? i : 0;
        // === Hàm helper an toàn ===
        private string GetNodeText(XmlNode parent, string xpath)
        {
            try
            {
                XmlNode node = parent.SelectSingleNode(xpath);
                return node?.InnerText?.Trim() ?? "";
            }
            catch { return ""; }
        }

        private double ParseDouble(string s)
        {
            if (double.TryParse(s?.Trim(), out double d)) return d;
            return 0;
        }

        private int ParseInt(string s)
        {
            if (int.TryParse(s?.Trim(), out int i)) return i;
            return 0;
        }
        private string CreateSearchKey(string productName)
        {
            // Chuẩn hóa giống như bạn đang làm
            return Helpers.RemoveVietnameseDiacritics(
                       Helpers.NormalizeVietnameseString(productName))
                   .ToLower()
                   .Replace(".", " ")
                   .Replace("-", " ")
                   .Replace("  ", " ")
                   .Trim();
        }
        private bool Loaiborow(string name)
        {
            if (name.ToLower().Contains("điều chỉnh"))
                return true;
            return false;
        }
        private Dictionary<string, (string TenVattu, string TenVattu2, string DonVi)> vatTuLookup;

        // ==================== TOÀN CỤC (chỉ khai báo 1 lần) ====================
        private readonly Dictionary<string, (string SoHieu, double Percent)> _cacheToanCuc
            = new Dictionary<string, (string SoHieu, double Percent)>(StringComparer.OrdinalIgnoreCase);

        // ==================== HÀM ĐÃ SỬA CHUẨN 100% – GIỮ NGUYÊN LOGIC CỦA ANH ====================
        private void Xulysohieuvattugoc(TbImportDetail tbImportDetail)
        {
            string ten = tbImportDetail.Ten?.Trim() ?? "";
            VietnameseProductMatcher vietnameseProductMatcher = new VietnameseProductMatcher();
            ten = vietnameseProductMatcher.NormalizeVietnameseProduct(ten);
            if (string.IsNullOrEmpty(ten))
            {
                tbImportDetail.SoHieu = GenerateResultString(NormalizeVietnameseString(ten));
                tbImportDetail.Percent = 0;
                return;
            }

            // DÙNG ĐÚNG 1 HÀM CHUẨN HÓA CHO TẤT CẢ: NormalizeForLookup (giống như bạn đang dùng cho _lookupByTenChinh)
            string key = Helpers.NormalizeVietnameseString(ten).Trim();  // ← QUAN TRỌNG NHẤT: DÙNG CHUNG 1 KEY!!!

            // === TẦNG 0: CACHE TOÀN CỤC ===
            if (_cacheToanCuc.TryGetValue(key, out var cached))
            {
                tbImportDetail.SoHieu = cached.SoHieu;
                tbImportDetail.Percent = cached.Percent;
                return;
            }

            // === TẦNG 1: Tìm nhanh (bây giờ key giống nhau → vào 100%) ===
            if (_lookupByTenChinh.TryGetValue(key, out string sohieu) ||
              _lookupByTenPhu.TryGetValue(key, out sohieu))
            {
                tbImportDetail.SoHieu = sohieu;
                tbImportDetail.Percent = 100;
                _cacheToanCuc[key] = (sohieu, 100);
                return;
            }

            // === TẦNG 2: Fuzzy + quy cách (giữ nguyên logic cực chuẩn của anh) ===
            tbImportDetail.Percent = 0;
            double bestPercent = 0;
            string bestSoHieu = null;

            string getTen2 = key;
            Regex regex = new Regex(@"(\d+(g|ml|L|kg)|x\d+|(\d+\s*cái))", RegexOptions.IgnoreCase);
            var matchInput = regex.Match(getTen2).Value;

            foreach (var item in vatTuLookup)
            {
                string getTen = Helpers.NormalizeVietnameseString(item.Value.TenVattu);  // ← DÙNG CHUNG HÀM!!!
                double final = CalculateSimilarity(getTen, getTen2);  
                if (!string.IsNullOrEmpty(item.Value.TenVattu2))
                {
                    string getTenAlt = Helpers.NormalizeVietnameseString(item.Value.TenVattu2);
                    double alt = CalculateSimilarity(getTenAlt, getTen2);
                    if (alt > final) final = alt;
                }

                if (final >= 90 && matchInput == regex.Match(getTen).Value)
                {
                    if (final > bestPercent)
                    {
                        bestPercent = final;
                        bestSoHieu = item.Key;
                    }
                    if (final >= 100) break;
                }
            }

            if (bestSoHieu != null)
            {
                tbImportDetail.SoHieu = bestSoHieu;
                tbImportDetail.Percent = Math.Round(bestPercent);
            }
            else
            {
                tbImportDetail.SoHieu = GenerateResultString(NormalizeVietnameseString(ten));
                tbImportDetail.Percent = 0;
            }

            // LƯU VÀO CACHE TOÀN CỤC
            _cacheToanCuc[key] = (tbImportDetail.SoHieu, tbImportDetail.Percent);
        }

        // Cấu trúc Tuple mới thêm trường TenChuan và QuyCach
        private Dictionary<string, (string TenChuan, string TenPhuChuan, string QuyCach, string DonVi)> _optimizedVatTu;

        private void InitializeVatTuOptimization()
        {
            _optimizedVatTu = new Dictionary<string, (string, string, string, string)>();
            Regex regex = new Regex(@"(\d+(g|ml|L|kg)|x\d+|(\d+\s*cái))", RegexOptions.IgnoreCase);

            foreach (var item in vatTuLookup)
            {
                string ten1 = Helpers.NormalizeVietnameseString(item.Value.TenVattu);
                string ten2 = Helpers.NormalizeVietnameseString(item.Value.TenVattu2);
                string quyCach = regex.Match(ten1).Value;

                _optimizedVatTu[item.Key] = (ten1, ten2, quyCach, item.Value.DonVi);
            }
        }
        private void Xulysohieuvattu(TbImportDetail tbImportDetail)
        {
            string originalTen = tbImportDetail.Ten?.Trim() ?? "";
            if (string.IsNullOrEmpty(originalTen)) return;

            // 1. Chuẩn hóa tên Input 1 lần duy nhất
            VietnameseProductMatcher matcher = new VietnameseProductMatcher();
            string normalizedTen = matcher.NormalizeVietnameseProduct(originalTen);
            string key = Helpers.NormalizeVietnameseString(normalizedTen).Trim();

            // === TẦNG 0: CACHE TOÀN CỤC (Tốc độ O(1) - Cực nhanh) ===
            if (_cacheToanCuc.TryGetValue(key, out var cached))
            {
                tbImportDetail.SoHieu = cached.SoHieu;
                tbImportDetail.Percent = cached.Percent;
                return;
            }

            // === TẦNG 1: TÌM NHANH (Dictionary Lookup) ===
            if (_lookupByTenChinh.TryGetValue(key, out string sohieu) ||
                _lookupByTenPhu.TryGetValue(key, out sohieu))
            {
                SetVatTuResult(tbImportDetail, key, sohieu, 100);
                return;
            }

            // === TẦNG 2: FUZZY MATCH (Chỉ chạy khi 2 tầng trên thất bại) ===
            Regex regex = new Regex(@"(\d+(g|ml|L|kg)|x\d+|(\d+\s*cái))", RegexOptions.IgnoreCase);
            string inputQuyCach = regex.Match(key).Value;

            double bestPercent = 0;
            string bestSoHieu = null;

            // Sử dụng _optimizedVatTu đã tính toán trước
            foreach (var item in _optimizedVatTu)
            {
                // Kiểm tra quy cách trước (Rẻ hơn Fuzzy)
                if (!string.IsNullOrEmpty(inputQuyCach) && inputQuyCach != item.Value.QuyCach)
                    continue;

                // Tính Similarity tên chính
                double final = CalculateSimilarity(item.Value.TenChuan, key);

                // Tính Similarity tên phụ (nếu có)
                if (final < 100 && !string.IsNullOrEmpty(item.Value.TenPhuChuan))
                {
                    double alt = CalculateSimilarity(item.Value.TenPhuChuan, key);
                    if (alt > final) final = alt;
                }

                if (final > bestPercent)
                {
                    bestPercent = final;
                    bestSoHieu = item.Key;
                }

                if (final >= 98) break; // Gần như khớp tuyệt đối thì dừng luôn
            }

            if (bestSoHieu != null && bestPercent >= 85) // Chỉ lấy nếu độ chính xác > 85%
            {
                SetVatTuResult(tbImportDetail, key, bestSoHieu, Math.Round(bestPercent));
            }
            else
            {
                string autoSoHieu = GenerateResultString(Helpers.NormalizeVietnameseString(normalizedTen));
                SetVatTuResult(tbImportDetail, key, autoSoHieu, 0);
            }
        }

        // Hàm bổ trợ để code sạch hơn
        private void SetVatTuResult(TbImportDetail dt, string key, string soHieu, double percent)
        {
            dt.SoHieu = soHieu;
            dt.Percent = percent;
            _cacheToanCuc[key] = (soHieu, percent);
        }
