        System.Windows.Forms.BindingSource bdNhapkho = new System.Windows.Forms.BindingSource();
        List<Nhapkhotp> lstNhapkhotp = new List<Nhapkhotp>();
        List<Nhapkhotp> lstFindnk = new List<Nhapkhotp>();
        private List<Nhapkhotp> findDataNK(DateTime fromdate, DateTime todate)
        {
            lstFindnk = new List<Nhapkhotp>();
            // DataTable getTonkho=
            string query = "SELECT * FROM " +
                "((TonKho " +
                "INNER JOIN Vattu ON TonKho.MaVatTu = Vattu.MaSo) " +
                "INNER JOIN PhanLoaiVattu ON Vattu.MaPhanLoai = PhanLoaiVattu.MaSo) " +
                "WHERE PhanLoaiVattu.MaTK = 38 " +
                "ORDER BY Vattu.TenVattu ASC";
            var parameters = new OleDbParameter[]
                     {
            new OleDbParameter("?", "3"),
                     };
            var kq = ExecuteQuery(query, null);
            foreach (DataRow dr in kq.Rows)
            {
                Nhapkhotp nhapkhotp = new Nhapkhotp();
                nhapkhotp.TenThanhPham = Helpers.ConvertVniToUnicode(dr.Field<string>("TenVattu")) + "|" + dr.Field<string>("Vattu.SoHieu");
                if (nhapkhotp.TenThanhPham.Contains("Ba ba rang muối "))
                {
                    int a = 10;
                }
                //Tính tồn đầu kỳ
                //Lấy tháng trước đó
                int monthDauky = ngaylapNhapTP.DateTime.Month - 1;
                var getSLDauky = dr.Field<double>("Luong_" + monthDauky);
                var loctheongay = existingTbChungtu.AsEnumerable().Where(m => m.Field<int>("MaVattu") == dr.Field<int>("Vattu.MaSo") && DateTime.Parse(m["NgayGS"].ToString()) >= dateEdit1.DateTime && DateTime.Parse(m["NgayGS"].ToString()) <= dateEdit2.DateTime && !m["SoHieu"].ToString().Contains("GV")).ToList();
                //Tính số lượng hoá đơn từ đầu tháng đến hiện tại
                //Tổng nhập
                double totalNo = 0;
                double totalCo = 0;
                if (loctheongay.Count > 0)
                {
                    totalNo = loctheongay.AsEnumerable().Sum(m => m.Field<double>("SoPS2No"));
                    totalCo = loctheongay.AsEnumerable().Sum(m => m.Field<double>("SoPS2Co"));
                    var getlast = existingTbChungtu.AsEnumerable().Where(m => m.Field<int>("MaVattu") == dr.Field<int>("Vattu.MaSo") && !m["SoHieu"].ToString().Contains("GV")).AsEnumerable().Where(m => double.Parse(m["SoPS2Co"].ToString()) > 0).AsEnumerable().LastOrDefault();
                    if (getlast != null)
                    {
                        var sops = getlast.Field<double>("SoPS");
                        var sl = getlast.Field<double>("SoPS2Co");
                        nhapkhotp.GiaBan = sops / sl;
                    }
                }
                else
                {
                    //Lấy giá bán theo hoá đơn cuối
                    var regain = existingTbChungtu.AsEnumerable().Where(m => m.Field<int>("MaVattu") == dr.Field<int>("Vattu.MaSo") && !m["SoHieu"].ToString().Contains("GV")).Where(m => double.Parse(m["SoPS2Co"].ToString()) > 0).ToList().LastOrDefault();
                    if (regain != null)
                    {
                        var sops = double.Parse(regain["SoPS"].ToString());
                        var sl = double.Parse(regain["SoPS2Co"].ToString());
                        nhapkhotp.GiaBan = sops / sl;
                    }
                }
                var soluogton = Math.Round(getSLDauky + totalNo - totalCo, 2);
                //if (soluogton < 0)
                //    soluogton = soluogton * (-1);
                nhapkhotp.SoLuongTon = soluogton;

                nhapkhotp.Percent = 80;
                nhapkhotp.DonGia = Math.Round(nhapkhotp.GiaBan * 80 / 100);
                nhapkhotp.Checked = true;
                nhapkhotp.ps1 = 70;
                nhapkhotp.ps2 = 10;
                lstFindnk.Add(nhapkhotp);

            }

            //Bước sàng lọc
            if (comboBoxEdit3.SelectedIndex == 1)
            {
                lstNhapkhotp = lstNhapkhotp.Where(m => m.SoLuongTon < 0).ToList();
            }
            if (comboBoxEdit3.SelectedIndex == 2)
            {
                lstNhapkhotp = lstNhapkhotp.Where(m => m.SoLuongTon >= 0).ToList();
            }

            //Lấy nguyên liệu đã lưu trước đó cho thành phẩm
            foreach (var it in lstFindnk)
            {
                string getsohieu = it.TenThanhPham.Split('|')[1];
                if (!string.IsNullOrEmpty(getsohieu))
                {
                    var getdsNLTP = existtbNguyenLieuThanhPham.AsEnumerable().Where(m => m.Field<double>("TiLe") > 0).Where(m => m.Field<string>("TPSoHieu") == getsohieu).ToList();
                    if (getdsNLTP != null && getdsNLTP.Count > 0)
                    {
                        foreach (var item in getdsNLTP)
                        {
                            for (int i = 1; i <= 5; i++)
                            {
                                string nlProperty = $"nl{i}";
                                string psProperty = $"ps{i}";
                                string slProperty = $"sl{i}";
                                string dgProperty = $"dg{i}";

                                // Kiểm tra xem thuộc tính nl[i] có trống hay không
                                if (string.IsNullOrEmpty(it.GetType().GetProperty(nlProperty)?.GetValue(it)?.ToString()))
                                {
                                    // Gán giá trị
                                    it.GetType().GetProperty(nlProperty).SetValue(it, item["SoHieuNguyenLieu"].ToString());
                                    it.GetType().GetProperty(psProperty).SetValue(it, item.Field<double>("TiLe"));

                                    var getvt = lstvt.FirstOrDefault(m => m.SoHieu == it.GetType().GetProperty(nlProperty).GetValue(it)?.ToString());
                                    var findlastCt = existingTbChungtu.AsEnumerable()
                                        .Where(m => m.Field<int>("MaVattu") == getvt.MaSo && m["SoPS2No"].ToString() != "0")
                                        .LastOrDefault();

                                    if (findlastCt != null)
                                    {
                                        double getSoPS = double.Parse(findlastCt["SoPS"].ToString());
                                        double SoPSNo = double.Parse(findlastCt["SoPS2No"].ToString());
                                        double DonGia = getSoPS / SoPSNo;
                                        double tt = it.DonGia * (it.SoLuongTon < 0 ? it.SoLuongTon * -1 : it.SoLuongTon);
                                        double percent2 = (double)it.GetType().GetProperty(psProperty).GetValue(it);
                                        var tt1 = (tt * percent2 / 100);
                                        double sL = Math.Round(tt1 / DonGia, 2);
                                        sL = sL < 0 ? sL * -1 : sL;

                                        // Gán giá trị cho số lượng và đơn giá
                                        it.GetType().GetProperty(slProperty).SetValue(it, sL);
                                        it.GetType().GetProperty(dgProperty).SetValue(it, DonGia);

                                    }
                                    break; // Thoát khỏi vòng lặp sau khi đã gán giá trị
                                }
                            }
                            var index = getdsNLTP.IndexOf(item);
                            if (index > 4)
                            {
                                Nguyenlieu nguyenlieu = new Nguyenlieu();
                                nguyenlieu.ParentId = it.ID;
                                nguyenlieu.SoHieu = item["SoHieuNguyenLieu"].ToString();
                                nguyenlieu.TiLe = item.Field<double>("TiLe");
                                nguyenlieu.Ten = lstvt.Where(m => m.SoHieu == nguyenlieu.SoHieu).FirstOrDefault().TenVattu;
                                it.Nguyenlieus.Add(nguyenlieu);
                            }
                        }
                    }
                }
            }
            return lstFindnk;
        }
        public class GeTonKho
        {
            public int MaSo { get; set; }
            public int MaVatTu { get; set; }
            public string TenVT { get; set; }
            public string SoHieu { get; set; }
            public double Luong_1 { get; set; }
            public double Luong_2 { get; set; }
            public double Luong_3 { get; set; }
            public double Luong_4 { get; set; }
            public double Luong_5 { get; set; }
            public double Luong_6 { get; set; }
            public double Luong_7 { get; set; }
            public double Luong_8 { get; set; }
            public double Luong_9 { get; set; }

            public double Luong_10 { get; set; }
            public double Luong_11{ get; set; }
            public double Luong_12{ get; set; }
        }

        private void simpleButton8_Click(object sender, EventArgs e)
        {
            btnLuuNhapKhoTP.Enabled = true;
            CapnhatNguyenlieuthanhphams();
            //
            ngaylapNhapTP.DateTime = dateEdit1.DateTime;
            DateTime selectedDate = dateEdit1.DateTime;

            txtNKSohieu.Text= "NKTP"+selectedDate.ToString("ddMM");
            txtNKNoidung.Text = $"Nhập kho thành phẩm ngày {dateEdit1.DateTime.Day}/{dateEdit1.DateTime.Month}";

            txtNKNLSohieu.Text = "XKNL" + selectedDate.ToString("ddMM");
            txtNKNLNoidung.Text = $"Xuất kho nguyên liệu ngày {dateEdit1.DateTime.Day}/{dateEdit1.DateTime.Month}";

            //Kiểm tra đã có mã nhập tp chưa
            int count = 1;
            while (tbNhapkhotp.AsEnumerable().Any(m => m.Field<string>("SoHieu").ToLower() == txtNKSohieu.Text.ToLower()))
            {
                txtNKSohieu.Text =$"{txtNKSohieu.Text}_{count}";
                count++;
            }

            count = 1;
            while (tbNhapkhotp.AsEnumerable().Any(m => m.Field<string>("SoHieu2").ToLower() == txtNKNLSohieu.Text.ToLower()))
            {
                txtNKNLSohieu.Text = $"{txtNKNLSohieu.Text}_{count}";
                count++;
            }
            progressPanel3.Visible = true;
            Application.DoEvents();
            lstNhapkhotp = new List<Nhapkhotp>();
            // DataTable getTonkho=
            //Tìm id của phan loại thành pham 

            //

            int getidtp = ListPhanloaiVattu.AsEnumerable().Where(m => m.Field<string>("SoHieu") == "TP").FirstOrDefault().Field<int>("MaTK");
            string query = "SELECT * FROM " +
                "((TonKho " +
                "INNER JOIN Vattu ON TonKho.MaVatTu = Vattu.MaSo) " +
                "INNER JOIN PhanLoaiVattu ON Vattu.MaPhanLoai = PhanLoaiVattu.MaSo) " +
                "WHERE PhanLoaiVattu.SoHieu =  'TP' " +
                "ORDER BY Vattu.TenVattu ASC";
            var parameters = new OleDbParameter[]
                     {
            new OleDbParameter("?", "3"),
                     };
            var kq = ExecuteQuery(query, null);
           var nkq = kq.AsEnumerable()
     .GroupBy(m => m.Field<int>("MaVatTu"))
             .Select(g => new GeTonKho
             {
                 MaVatTu = g.Key, 
                 Luong_1 = g.Sum(m => m.Field<double>("Luong_1")),
                 Luong_2 = g.Sum(m =>m.Field<double>("Luong_2")),
                 Luong_3 = g.Sum(m =>m.Field<double>("Luong_3")),
                 Luong_4 = g.Sum(m => m.Field<double>("Luong_4")),
                 Luong_5 = g.Sum(m => m.Field<double>("Luong_5")),
                 Luong_6 = g.Sum(m => m.Field<double>("Luong_6")),
                 Luong_7 = g.Sum(m => m.Field<double>("Luong_7")),
                 Luong_8 = g.Sum(m => m.Field<double>("Luong_8")),
                 Luong_9 = g.Sum(m => m.Field<double>("Luong_9")),
                 Luong_10 = g.Sum(m => m.Field<double>("Luong_10")),
                 Luong_11 = g.Sum(m => m.Field<double>("Luong_11")),
                 Luong_12 = g.Sum(m => m.Field<double>("Luong_12")),
             })
     .ToList();
            int stt = 1;
            foreach (GeTonKho dr in nkq)
            {
                Nhapkhotp nhapkhotp = new Nhapkhotp();
                nhapkhotp.ID = stt;
                stt += 1;
                dr.TenVT = lstvt.Where(m => m.MaSo == dr.MaVatTu).FirstOrDefault().TenVattu;
                dr.SoHieu = lstvt.Where(m => m.MaSo == dr.MaVatTu).FirstOrDefault().SoHieu;
                nhapkhotp.TenThanhPham = Helpers.ConvertVniToUnicode(dr.TenVT) +"|" + dr.SoHieu;
                if (nhapkhotp.TenThanhPham.Contains("Trứng chiên"))
                {
                    int a = 10;
                }
                //Tính tồn đầu kỳ
                //Lấy tháng trước đó
                int monthDauky = ngaylapNhapTP.DateTime.Month - 1;
                string propertyName = $"Luong_{monthDauky}"; // Tạo tên thuộc tính động
                PropertyInfo propertyInfo = typeof(GeTonKho).GetProperty(propertyName); 

                var getSLDauky = (double)propertyInfo.GetValue(dr);
                var loctheongay = existingTbChungtu.AsEnumerable().Where(m => m.Field<int>("MaVattu") == dr.MaVatTu && DateTime.Parse(m["NgayCT"].ToString()) >=dateEdit1.DateTime && DateTime.Parse(m["NgayCT"].ToString()) <= dateEdit2.DateTime && !m["SoHieu"].ToString().Contains("GV")).ToList();
                //Tính số lượng hoá đơn từ đầu tháng đến hiện tại
                //Tổng nhập
                double totalNo = 0;
                double totalCo = 0;
                int typeloc = 0;
                if (loctheongay.Count > 0)
                {
                    totalNo = loctheongay.AsEnumerable().Sum(m => m.Field<double>("SoPS2No"));
                    totalCo = loctheongay.AsEnumerable().Sum(m => m.Field<double>("SoPS2Co"));
                    var getlast = loctheongay.AsEnumerable().Where(m => m.Field<int>("MaVattu") == dr.MaVatTu && !m["SoHieu"].ToString().Contains("GV")).AsEnumerable().Where(m => double.Parse(m["SoPS2Co"].ToString()) > 0).AsEnumerable().LastOrDefault();
                    if(getlast != null)
                    {
                        var sops = getlast.Field<double>("SoPS");
                        var sl = getlast.Field<double>("SoPS2Co");
                        nhapkhotp.GiaBan = Math.Round(sops / sl,2);
                    }
                    typeloc = 1;
                }
                else
                {
                    loctheongay = existingTbChungtu.AsEnumerable().OrderByDescending(m=>m.Field<int>("MaSo")).Where(m => m.Field<int>("MaVattu") == dr.MaVatTu && !m["SoHieu"].ToString().Contains("GV")).ToList();
                    totalNo = loctheongay.AsEnumerable().Sum(m => m.Field<double>("SoPS2No"));
                    totalCo = loctheongay.AsEnumerable().Sum(m => m.Field<double>("SoPS2Co"));
                    var getlast = loctheongay.AsEnumerable().Where(m => m.Field<int>("MaVattu") == dr.MaVatTu && !m["SoHieu"].ToString().Contains("GV")).AsEnumerable().Where(m => double.Parse(m["SoPS2Co"].ToString()) > 0).AsEnumerable().FirstOrDefault();
                    if (getlast != null)
                    {
                        var sops = getlast.Field<double>("SoPS");
                        var sl = getlast.Field<double>("SoPS2Co");
                        nhapkhotp.GiaBan = Math.Round(sops / sl, 2);
                    }
                    typeloc = 2;
                }
                double soluogton = 0;
                if(comboBoxEdit4.SelectedIndex==0)
                {
                    soluogton = Math.Round(getSLDauky + totalNo - totalCo, 2);
                }
                if (comboBoxEdit4.SelectedIndex == 1)
                {
                    soluogton = Math.Round(getSLDauky, 2);
                }
                if (comboBoxEdit4.SelectedIndex == 2)
                {
                    if (typeloc == 1)
                        soluogton = Math.Round(totalNo - totalCo, 2);
                    else
                        soluogton = 0;
                }
                //if (soluogton < 0)
                //    soluogton = soluogton * (-1);
                nhapkhotp.SoLuongTon = soluogton;
                //Lấy tỉ lệ phần trăm
                var findvt = lstvt.Where(m => m.SoHieu == nhapkhotp.TenThanhPham.Split('|')[1]).FirstOrDefault();
                if (findvt != null)
                {
                    if(string.IsNullOrEmpty(findvt.PTGB))
                    {
                        nhapkhotp.Percent = 80;
                        nhapkhotp.DonGia = Math.Round(nhapkhotp.GiaBan * 80 / 100);
                    }
                    else
                    {
                        double tlpt = double.Parse(findvt.PTGB);
                        nhapkhotp.Percent = tlpt;
                        nhapkhotp.DonGia = Math.Round(nhapkhotp.GiaBan * tlpt / 100);
                    }
                }
                    
                nhapkhotp.Checked = true;
                nhapkhotp.ps1 = 70;
                nhapkhotp.ps2 = 10;
                lstNhapkhotp.Add(nhapkhotp);
               
            }
           
            //Bước sàng lọc
            if (comboBoxEdit3.SelectedIndex == 1)
            {
                lstNhapkhotp = lstNhapkhotp.Where(m => m.SoLuongTon < 0).ToList();
            }
            if (comboBoxEdit3.SelectedIndex == 2)
            {
                lstNhapkhotp = lstNhapkhotp.Where(m => m.SoLuongTon >= 0).ToList();
            }

            //Lấy nguyên liệu đã lưu trước đó cho thành phẩm
            foreach (var it in lstNhapkhotp)
            {
                string getsohieu = it.TenThanhPham.Split('|')[1];
                if(!string.IsNullOrEmpty(getsohieu) && existtbNguyenLieuThanhPham!=null)
                { 
                    var getdsNLTP = existtbNguyenLieuThanhPham.AsEnumerable().Where(m=>m.Field<double>("TiLe")>0).Where(m => m.Field<string>("TPSoHieu") == getsohieu).ToList();
                    if(getdsNLTP!=null && getdsNLTP.Count > 0)
                    {
                        foreach (var item in getdsNLTP)
                        {
                            for (int i = 1; i <= 5; i++)
                            {
                                string nlProperty = $"nl{i}";
                                string psProperty = $"ps{i}";
                                string slProperty = $"sl{i}";
                                string dgProperty = $"dg{i}";

                                // Kiểm tra xem thuộc tính nl[i] có trống hay không
                                if (string.IsNullOrEmpty(it.GetType().GetProperty(nlProperty)?.GetValue(it)?.ToString()))
                                { 
                                    // Gán giá trị
                                    it.GetType().GetProperty(nlProperty).SetValue(it, item["SoHieuNguyenLieu"].ToString());
                                    it.GetType().GetProperty(psProperty).SetValue(it, item.Field<double>("TiLe"));

                                    var getvt = lstvt.FirstOrDefault(m => m.SoHieu == it.GetType().GetProperty(nlProperty).GetValue(it)?.ToString());
                                    if (getvt == null)
                                        continue;
                                    //var findlastCt = existingTbChungtu.AsEnumerable()
                                    //    .Where(m=>m.Field<DateTime>("NgayCT")>=dateEdit1.DateTime && m.Field<DateTime>("NgayCT") <= dateEdit2.DateTime)
                                    //    .Where(m => m.Field<int>("MaVattu") == getvt.MaSo && m["SoPS2No"].ToString() != "0")
                                    //    .LastOrDefault();
                                    //Lấy tồn kho
                                    var getTien = tbTonkho.AsEnumerable().Where(m => m.Field<int>("MaVatTu") == getvt.MaSo).FirstOrDefault();
                                    double getLuong = 0;
                                    if (getTien != null)
                                    {
                                        var gettien = getTien.Field<double>($"Tien_{dateEdit1.DateTime.Month}");
                                        //Trường hợp theo tháng k có thì tìm đến khi nào tìm được
                                        if (gettien == 0)
                                        {
                                            int getmonth = dateEdit1.DateTime.Month-1;
                                            while (gettien == 0 && getmonth>=0)

                                            {
                                                gettien = getTien.Field<double>($"Tien_{getmonth}");
                                                getLuong = getTien.Field<double>($"Luong_{getmonth}");
                                                getmonth -= 1;
                                            }

                                        }
                                        else
                                        {
                                            getLuong = getTien.Field<double>($"Luong_{dateEdit1.DateTime.Month}");
                                        }
                                            var DonGia = Math.Round(gettien / getLuong);

                                        double tt = it.DonGia * (it.SoLuongTon < 0 ? it.SoLuongTon * -1 : it.SoLuongTon);
                                        double percent2 = (double)it.GetType().GetProperty(psProperty).GetValue(it);
                                        var tt1 = (tt * percent2 / 100);
                                        double sL = Math.Round(tt1 / DonGia, 2);
                                        sL = sL < 0 ? sL * -1 : sL;

                                        // Gán giá trị cho số lượng và đơn giá
                                        it.GetType().GetProperty(slProperty).SetValue(it, sL);
                                        it.GetType().GetProperty(dgProperty).SetValue(it, DonGia);
                                         
                                    }
                                    break; // Thoát khỏi vòng lặp sau khi đã gán giá trị
                                }
                            }
                            var index = getdsNLTP.IndexOf(item);
                            if (index > 4)
                            {
                                Nguyenlieu nguyenlieu = new Nguyenlieu();
                                nguyenlieu.ParentId = it.ID;
                                nguyenlieu.SoHieu= item["SoHieuNguyenLieu"].ToString();
                                nguyenlieu.TiLe = item.Field<double>("TiLe");
                                nguyenlieu.Ten = lstvt.Where(m => m.SoHieu == nguyenlieu.SoHieu).FirstOrDefault().TenVattu;

                                it.Nguyenlieus.Add(nguyenlieu);
                            }
                        }
                    }
                }
                if(it.ps1==100)
                {
                    it.ps2 = 0;
                }
            }
             
                //Điền thông tin cho các row theo thông tin cũ
                //foreach (var it in lstNhapkhotp)
                //{
                //    var getlastData = tbNhapkhonguyenlieu.AsEnumerable().Where(m => m["SoHieuTP"].ToString() == it.TenThanhPham.Split('|')[1]).ToList();
                //    if (getlastData != null)
