        private void gridView11_RowCellClick(object sender, RowCellClickEventArgs e)
        {
            if (e.Column.FieldName == "Checked") // Thay đổi tên cột cho phù hợp
            {
                var getAcess = (bool)gridView11.GetRowCellValue(e.RowHandle, "Checked");
                if (getAcess)
                {
                    gridView11.SetRowCellValue(e.RowHandle, e.Column, false);
                }
                else
                {
                    gridView11.SetRowCellValue(e.RowHandle, e.Column, true);
                }
            }
        }

        private void gridView11_CellValueChanged(object sender, DevExpress.XtraGrid.Views.Base.CellValueChangedEventArgs e)
        {
            int getMonthFirst = DateTime.Parse(gridView11.GetRowCellValue(e.RowHandle, "NgayGD").ToString()).Month;
            if (e.Column.FieldName == "Maso" && e.RowHandle == 0)
            {
                string getvalue = e.Value.ToString();
                string[] parts = getvalue.Split('/');
                string prefix = parts[0]; 
                int number = int.Parse(parts[1]);
                bool resetNumber = false;
                foreach (var item in lstNganhan)
                {
                    //Tìm tháng hiện tại
                    var findmonthcurrent = DateTime.Parse(item.NgayGD.ToString()).Month;
                    if (findmonthcurrent != getMonthFirst && resetNumber == false)
                    {
                        number = 0;
                        resetNumber = true;
                    }
                    number += 1;
                    string newtext = number.ToString("D2");
                    item.Maso = prefix + findmonthcurrent + "/" + newtext; // Cập nhật giá trị mới cho item.Maso
                                                                           // Định dạng số với số chữ số hiện tại 
                }
                gridControl7.DataSource = lstNganhan;
                gridControl7.RefreshDataSource();
            }
        }

