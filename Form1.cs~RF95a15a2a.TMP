        private void InitDB()
        {
            // 1. Đọc dbPath (rất nhanh)
            if (string.IsNullOrEmpty(dbPath))
            {
                string exeDir = Path.GetDirectoryName(
                    Assembly.GetExecutingAssembly().Location);

                string root = Path.GetFullPath(
                    Path.Combine(exeDir, @"..\.."));

                string pathFile = Path.Combine(root, "hoadon", "dpPath.txt");
                dbPath = File.ReadAllText(pathFile).Trim();
            }

            // 2. Build connection string (string concat nhanh hơn interpolated)
            if (string.IsNullOrEmpty(connectionString))
            {
                connectionString =
                    "Provider=Microsoft.ACE.OLEDB.12.0;" +
                    "Data Source=" + dbPath + ";" +
                    "Jet OLEDB:Database Password=1@35^7*9)1;";
            }

            // 3. MỞ KẾT NỐI NGẮN GỌN + LOAD LICENSE
            using (OleDbConnection conn = new OleDbConnection(connectionString))
            {
                conn.Open();          // không tránh được
                //LoadLicenseInfo(conn); // truyền connection vào
            }
        }

        private void SafeExecute(string sql)
        {
            try
            {
                ExecuteQueryResult(sql, null);
            }
            catch
            {
                // cố tình bỏ qua (ALTER TABLE chạy 1 lần là đủ)
            }
        }

        private void EnsureTables(OleDbConnection conn)
        {
            // ALTER TABLE an toàn (chạy được thì chạy)
            SafeExecute("ALTER TABLE TP154 ALTER COLUMN TenVattu TEXT");

            // 1. tbGhichuHT
            if (!TableExists(conn, "tbGhichuHT"))
            {
                CreateTableGhiChuHT(conn, "tbGhichuHT");
            }

            // 2. tbMatdinhghichu (có seed mặc định)
            if (!TableExists(conn, "tbMatdinhghichu"))
            {
                CreateTableMatdinhghichu(conn, "tbMatdinhghichu");

                string sql = "INSERT INTO tbMatdinhghichu (TK,Noidung) VALUES (?,?)";
                ExecuteQueryResult(sql, new OleDbParameter[]
                {
            new OleDbParameter("?", "131"),
            new OleDbParameter("?", "")
                });
            }

            // 3. tbNguyenLieuThanhPham
            if (!TableExists(conn, "tbNguyenLieuThanhPham"))
            {
                CreateTableNguyenLieuTP(conn, "tbNguyenLieuThanhPham");
            }

            // 4. tbNhapkhonguyenlieu
            if (!TableExists(conn, "tbNhapkhonguyenlieu"))
            {
                CreateTableNhapkhoNguyenLieu(conn, "tbNhapkhonguyenlieu");
            }

            // 5. tbNhapkhotp
            if (!TableExists(conn, "tbNhapkhotp"))
            {
                CreateTableNhapkhoTP(conn, "tbNhapkhotp");
            }

            // 6. tbNhapkhotpChitiet
            if (!TableExists(conn, "tbNhapkhotpChitiet"))
            {
                CreateTableNhapkhoTPChitiet(conn, "tbNhapkhotpChitiet");
            }

            // 7. tableHoadonvao
            if (!TableExists(conn, "tableHoadonvao"))
            {
                CreateTableHoadonvao(conn, "tableHoadonvao");
            }

            // 8. tbNganhang
            if (!TableExists(conn, "tbNganhang"))
            {
                CreateTableNganhang(conn, "tbNganhang");
            }

            // 9. tbDinhdanhNganhang
            if (!TableExists(conn, "tbDinhdanhNganhang"))
            {
                CreateTableDinhDanhNganhang(conn, "tbDinhdanhNganhang");
            }

            // 10. tbDinhdanhtaikhoan
            if (!TableExists(conn, "tbDinhdanhtaikhoan"))
            {
                CreateTableDinhDanh(conn, "tbDinhdanhtaikhoan");
            }

            // 11. tbLogs (bảng log – nếu bạn có hàm tạo)
            if (!TableExists(conn, "tbLogs"))
            {
                // Nếu bạn đã có hàm CreateTableLogs thì bật dòng này
                // CreateTableLogs(conn, "tbLogs");
            }
        }

        private void AddColumnIfNotExists(
        OleDbConnection conn,
        string tableName,
        string columnName,
        string columnType)
            {
                if (!ColumnExists(conn, tableName, columnName))
                {
                    AddColumn(conn, tableName, columnName, columnType);
                }
            }

        private void EnsureColumns(OleDbConnection conn)
        {
            // tbRegister
            AddColumnIfNotExists(conn, "tbRegister", "tokken", "TEXT");
            AddColumnIfNotExists(conn, "tbRegister", "TimeTokken", "DATETIME");
            AddColumnIfNotExists(conn, "tbRegister", "tk154", "TEXT");
            AddColumnIfNotExists(conn, "tbRegister", "col1", "TEXT");
            AddColumnIfNotExists(conn, "tbRegister", "col2", "TEXT");

            // tbimport
            AddColumnIfNotExists(conn, "tbimport", "hdon", "TEXT");
            AddColumnIfNotExists(conn, "tbimport", "IsImport", "NUMBER");
            AddColumnIfNotExists(conn, "tbimport", "Macdinhstatus", "TEXT");
            AddColumnIfNotExists(conn, "tbimport", "Khmshdon", "TEXT");
            AddColumnIfNotExists(conn, "tbimport", "idhoadon", "TEXT");
            AddColumnIfNotExists(conn, "tbimport", "InvoiceType", "TEXT");
