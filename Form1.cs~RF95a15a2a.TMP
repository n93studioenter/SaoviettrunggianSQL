        private Dictionary<(int RowHandle, string ColumnName), Color> cellColors = new Dictionary<(int, string), Color>();

        public void CustomDrawcellGrid(DevExpress.XtraGrid.Views.Base.RowCellCustomDrawEventArgs e, GridView grid, int type)
        {

            int rowHandle = e.RowHandle;
            if (e.Column.FieldName == "Noidung" && hienthimau)
            {
                var getcellValue = grid.GetRowCellValue(rowHandle, "Noidung");
                if (getcellValue!=null && getcellValue.ToString().Contains("Điều chỉnh"))
                {
                    e.Appearance.ForeColor = Color.Red; // Tô màu chữ đỏ
                    return;
                }
            }
            if (e.Column.FieldName == "Ten" && hienthimau)
            {

                // Kiểm tra xem ô đã được tô màu chưa   
                //if (cellColors.TryGetValue((rowHandle, e.Column.FieldName), out Color color))
                //{
                //    e.Appearance.ForeColor = color; // Áp dụng màu đã lưu
                //    return; // Nếu đã tô màu, không làm gì thêm
                //}

                var cellValue = grid.GetRowCellValue(rowHandle, "ID");
                if (cellValue == null)
                    return;
                var filteredRows = tbImportDt.AsEnumerable()
           .Where(m => m.Field<string>("ParentId") == cellValue.ToString());

                DataTable resultKm;

                if (filteredRows.Any())
                {
                    resultKm = filteredRows.CopyToDataTable();
                }
                else
                {
                    resultKm = tbImportDt.Clone(); // Hoặc tạo DataTable rỗng với cấu trúc tương tự
                }
                bool hashh = false;
                foreach (DataRow item in resultKm.Rows)
                {
                    string getSoHieu = item["sohieu"].ToString();
                    string getName = item["Ten"].ToString();
                    var checkVt = lstvt.FirstOrDefault(m => m.SoHieu.ToLower() == getSoHieu.ToLower());

                    if (checkVt == null && !getName.ToLower().Contains("chieát khaáu"))
                    {
                        //Kiểm tra mật định danh mục có nó không
                        foreach(DataRow dt in ListPhanloaiVattu.Rows)
                        {
                            if (!string.IsNullOrEmpty(dt.Field<string>("GhiChu")))
                            {
                                //dt.Field<string>("GhiChu").ToLower().Contains(getName.ToLower())
                                var getlistSplit = dt.Field<string>("GhiChu").Split(',').ToList();
                                foreach(var it in getlistSplit)
                                {
                                    if (getName.ToLower().Contains(it.ToLower()))
                                    {
                                        //Kiểm tra có phải thành phẩm
                                        var ffindmpl = ListPhanloaiVattu.AsEnumerable().Where(m => m.Field<string>("SoHieu") == "TP").FirstOrDefault();
                                        int findmpl = 0;
                                        if (ffindmpl != null)
                                        {
                                            findmpl= ffindmpl.Field<int>("MaSo");
                                        }
                                        if(dt.Field<int>("MaSo")!= findmpl)
                                        {
                                            e.Appearance.ForeColor = Color.Blue; // Tô màu chữ đỏ
                                            cellColors[(rowHandle, e.Column.FieldName)] = Color.Blue; // Lưu màu
                                            return;
                                        }
                                      
                                    }
                                }
                               
                            }
                        }
                        e.Appearance.ForeColor = Color.Red; // Tô màu chữ đỏ
                        cellColors[(rowHandle, e.Column.FieldName)] = Color.Red; // Lưu màu 
                        return;
                    }
                     
                        // Trường hợp hàng có sl <=0
                        var findVt = lstvt.FirstOrDefault(m => m.SoHieu.ToString().ToLower() == item["SoHieu"].ToString().ToLower());
                    if (findVt != null && findVt.SoLuong <= 0 && type == 2)
                    {
                        //Tìm mã phân loại tp 
                        var foundItem = ListPhanloaiVattu.AsEnumerable()
    .FirstOrDefault(m => m.Field<string>("SoHieu") == "TP");

                        int findmpl = foundItem != null ? foundItem.Field<int>("MaSo") : -1; // Hoặc giá trị mặc định khác
                        if (findVt.MaPhanLoai!=findmpl)
                        {  //if(findVt.MaPhanLoai)
                          
                            hashh = true;
                        }
                        if(hashh==true)
                        {
                            e.Appearance.ForeColor = Color.Blue; // Tô màu chữ đỏ
                            cellColors[(rowHandle, e.Column.FieldName)] = Color.Blue; // Lưu màu
                            return; // Trả về sau khi tô màu
                        }
                        else
                        {
                            //if(findVt.MaPhanLoai)
                            e.Appearance.ForeColor = Color.Red; // Tô màu chữ đỏ
                            cellColors[(rowHandle, e.Column.FieldName)] = Color.Red; // Lưu màu
                           // return; // Trả về sau khi tô màu
                        }
                    }
                   
                }
            }

            if (e.Column.FieldName == "Mst" && hienthimau)
            {
                try
                {
                    var cellValue = grid.GetRowCellValue(rowHandle, "Mst").ToString();
                    if (tbDinhDanhtaikhoan.AsEnumerable().Where(m => m.Field<string>("Loai") == type.ToString()).Any(m => m.Field<string>("KeyValue").Contains(cellValue)))
                    {
                        // e.Appearance.Font = new Font(e.Appearance.Font, FontStyle.Bold);
                        e.Appearance.ForeColor = Color.DeepPink; // Tô màu chữ đỏ
                    }
                }
                catch(Exception ex)
                {

                }
            }
            if (e.Column.FieldName == "Noidung" && hienthimau)
            {
                try
                {
                    var cellValue = grid.GetRowCellValue(rowHandle, "Noidung").ToString();
                    if (tbDinhDanhtaikhoan.AsEnumerable().Where(m => m.Field<string>("Loai") == type.ToString()).Any(m => m.Field<string>("Type").Contains(cellValue)))
                    {
                        //  e.Appearance.Font = new Font(e.Appearance.Font, FontStyle.Bold);
                        e.Appearance.ForeColor = Color.DeepPink; // Tô màu chữ đỏ
                    }
                }
                catch(Exception ex)
                {

                }
               
            }
            if(e.Column.FieldName== "Vat2" && hienthimau)
            {
                var cellValue = grid.GetRowCellValue(rowHandle, "Vat2").ToString();
                if (cellValue!="0")
                {
                    e.Appearance.Font = new Font(e.Appearance.Font, FontStyle.Bold);
                    e.Appearance.ForeColor = Color.Red; // Tô màu chữ đỏ
                }
            }
            if ((e.Column.FieldName.Contains("TKNo") || e.Column.FieldName.Contains("TKCo")) && hienthimau)
            {
                var cellValue = grid.GetRowCellValue(rowHandle, e.Column.FieldName).ToString();

                if (cellValue.Contains("|"))
                {
                    e.Appearance.Font = new Font(e.Appearance.Font, FontStyle.Bold);
                    e.Appearance.ForeColor = Color.Blue; // Tô màu chữ xanh
                }



                //FileImport rowData = grid.GetRow(rowHandle) as FileImport;
                //if (e.Column.FieldName.Contains("TKNo"))
                //{
                //    if (Kiemtrataikhoancon(rowData.TKNo))
                //    {
                //        e.Appearance.ForeColor = Color.Red; // Tô màu chữ đỏ
                //        cellColors2[(rowHandle, e.Column.FieldName)] = Color.Red; // Lưu màu
                //    }
                //}
                   
            }
            if(e.Column.FieldName== "InvoiceType" && hienthimau)
            {
                //var cellValue = grid.GetRowCellValue(rowHandle, "InvoiceType").ToString();
                //if (cellValue == "6")
                //{
                //    e.Appearance.BackColor = Color.Green; 
                //    e.Appearance.ForeColor = Color.Green; 
                //}
                //if (cellValue == "8")
                //{
                //    e.Appearance.BackColor = Color.Yellow;
                //    e.Appearance.ForeColor = Color.Yellow;
                //}
                //if (cellValue == "10")
                //{
                //    e.Appearance.BackColor = Color.Blue;
                //    e.Appearance.ForeColor = Color.Blue;
                //}
            }
        }
