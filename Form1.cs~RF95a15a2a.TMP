        private void SafeAlterColumn(string table, string column, string newType)
        {
            try
            {
                string sql = string.Format(
                    "ALTER TABLE {0} ALTER COLUMN {1} {2}",
                    table, column, newType
                );

                ExecuteQueryResult(sql);
            }
            catch (Exception ex)
            {
                // GHI LOG, KHÔNG NUỐT
                Console.WriteLine(
                    "Không alter được {0}.{1}: {2}",
                    table, column, ex.Message
                );
            }
        }
                    private bool IsSameAccessType(string accessType, string expectedType)
                    {
                        // DATA_TYPE trong schema là số (OleDbType)
                        // nhưng thường trả về string số → map đơn giản

                        switch (expectedType.ToUpper())
                        {
                            case "DATETIME":
                                return accessType == "7";   // DBTYPE_DATE

                            case "DOUBLE":
                                return accessType == "5";   // DBTYPE_R8

                            case "TEXT":
                                return accessType == "130"; // DBTYPE_WSTR

                            default:
                                return false;
                        }
                    }

                    private void EnsureColumnType(
                 OleDbConnection conn,
                 DataTable schemaColumns,
                 string table,
                 string column,
                 string expectedType)
                    {
                        foreach (DataRow row in schemaColumns.Rows)
                        {
                            if (!row["TABLE_NAME"].ToString()
                                .Equals(table, StringComparison.OrdinalIgnoreCase))
                                continue;

                            if (!row["COLUMN_NAME"].ToString()
                                .Equals(column, StringComparison.OrdinalIgnoreCase))
                                continue;

                            string dataType = row["DATA_TYPE"].ToString();

                            if (IsSameAccessType(dataType, expectedType))
                                return; // ✅ ĐÃ ĐÚNG → KHÔNG LÀM GÌ

                            string sql = $"ALTER TABLE {table} ALTER COLUMN {column} {expectedType}";
                            ExecuteQueryResult(sql, null);
                            return;
                        }
                    }
        private void EnsureColumnTypes(
    OleDbConnection conn,
    DataTable schemaColumns)
        {
            EnsureColumnType(conn, schemaColumns, "tbimport", "NLap", "DATETIME");
            EnsureColumnType(conn, schemaColumns, "tbimportdetail", "SoLuong", "DOUBLE");
            EnsureColumnType(conn, schemaColumns, "tbimportdetail", "DonGia", "DOUBLE");
        }
        private void EnsureDbVersionTable(OleDbConnection conn)
        {
            // Kiểm tra bảng DbVersion đã tồn tại chưa
            if (!TableExists(conn, "DbVersion"))
            {
                // Tạo bảng
                ExecuteQueryResult(
                    "CREATE TABLE DbVersion (VersionNumber NUMBER)",
                    null
                );

                // Insert version mặc định = 0
                ExecuteQueryResult(
                    "INSERT INTO DbVersion (VersionNumber) VALUES (0)",
                    null
                );
            }
        }
        private void UpdateDbVersion(OleDbConnection conn, int newVersion)
        {
            OleDbCommand cmd = null;
            try
            {
                cmd = new OleDbCommand(
                    "UPDATE DbVersion SET VersionNumber = ?",
                    conn
                );

                cmd.Parameters.AddWithValue("?", newVersion);
                cmd.ExecuteNonQuery();
            }
            finally
            {
                if (cmd != null)
                    cmd.Dispose();
            }
        }

        private void MigrateDatabase()
        {
            OleDbConnection conn = null;
            try
            {
                conn = new OleDbConnection(connectionString);
                conn.Open();

                EnsureTables(conn);
                EnsureColumns(conn);
                DataTable schemaColumns = conn.GetOleDbSchemaTable(
     OleDbSchemaGuid.Columns, null);
                EnsureColumnTypes(conn, schemaColumns);

            }
            catch (Exception ex)
            {
                throw new Exception("Lỗi migrate database: " + ex.Message);
            }
            finally
            {
                if (conn != null)
                    conn.Close();
            }
        }
        private void InitDatanew()
        {
            string query = "SELECT * FROM tbRegister";

            DataTable tb;
            try
            {
                tb = ExecuteQuery(query, null);
            }
            catch (Exception ex)
            {
                XtraMessageBox.Show("Lỗi đọc tbRegister: " + ex.Message);
                return;
            }

            if (tb == null || tb.Rows.Count == 0)
                return;

            DataRow row = tb.Rows[0];

            // Đường dẫn hóa đơn
            savedPath = row["Hoadonpath"] == DBNull.Value
                ? ""
                : row["Hoadonpath"].ToString();

            // User / pass
            txtuser.Text = row["Username"] == DBNull.Value
                ? ""
                : row["Username"].ToString();

            txtpass.Text = row["Password"] == DBNull.Value
                ? ""
                : row["Password"].ToString();
        }
