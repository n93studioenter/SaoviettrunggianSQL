                                        fileip2.TongTien = TT;
                                        string query = @"
            INSERT INTO tbImport (SHDon, KHHDon, NLap, Ten, Noidung, TKCo, TKNo, TkThue, Mst, Status,Type, Ngaytao, TongTien, Vat, SohieuTP,TPhi,TgTCThue,TgTThue,Path)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?,?, ?, ?, ?,?,?,?,?)";

                                        string newTen = fileip2.Ten;
