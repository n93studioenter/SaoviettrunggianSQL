                        return;
                    }
                }
            }

            //Cho tất cả hóa đơn dạng ko dc check, trừ nhung hoa don =1 hoặc bằng 2
           
             if (chkDauvao.Checked)
            {
                //Xử lý 6422
                foreach (var item in lstImportVao)
                {
                    if (item.TKNo.Contains("642"))
                    {
                        if (item.fileImportDetails.Any(m => !m.TKNo.Contains("642")))
                        {
                            string query = @"UPDATE tbimport SET IsHaschild= ? WHERE   ID = ?";

                            var parameters = new OleDbParameter[]
                     {
                                new OleDbParameter("?","1"),
                                    new OleDbParameter("?",item.ID),
                     };
                            int rowsAffected = ExecuteQueryResult(query, parameters);
                            item.isHaschild = true;
                        }
                        else
                        {
                            string query = @"UPDATE tbimport SET IsHaschild= ? WHERE   ID = ?";

                            var parameters = new OleDbParameter[]
                     {
                                new OleDbParameter("?","0"),
                                    new OleDbParameter("?",item.ID),
                     };
                            int rowsAffected = ExecuteQueryResult(query, parameters);
                            item.isHaschild = false;
                        }
                    }
                    //Thực hiện sum 6422 lại
                    if (item.fileImportDetails.Where(m=>m.TKNo.Contains("642")).Count() > 0)
                    {
                                var getfirst = item.fileImportDetails.Where(m => m.TKNo.Contains("642")).FirstOrDefault();
                                var remain = item.fileImportDetails.Where(m => m.TKNo.Contains("642") && m.ID != getfirst.ID);
                                getfirst.TTien += remain.Sum(m => m.TTien);
                                var query = @"UPDATE tbimportdetail SET TTien= ? WHERE   ID = ?";

                                var parameters = new OleDbParameter[]
                                {
                                    new OleDbParameter("?",getfirst.TTien),
                                    new OleDbParameter("?",getfirst.ID),
                                 };
                                int rowsAffected = ExecuteQueryResult(query, parameters);
                                item.isHaschild = true;

                        //Xoá remain
                        foreach(var dl in remain)
                        {
                            var queryDelete = @"delete from tbimportdetail  WHERE   ID = ?";
                            var parametersDelete = new OleDbParameter[]
                        {
          new OleDbParameter("?",dl.ID.ToString())
                        };
                            var result = ExecuteQueryResult(queryDelete, parametersDelete); // Xóa trong database
                        }
                     }
                }

                progressPanel1.Caption = "Thiết lập status";
                Application.DoEvents();
                UpdateStatusImportVao_Safe(lstImportVao);
                using (OleDbConnection conn = new OleDbConnection(connectionString))
                {
                    conn.Open();
                    using (OleDbTransaction tran = conn.BeginTransaction())
                    {
                        try
                        {
                            // ================= PREPARE COMMAND =================

                            OleDbCommand cmdUpdateImport = new OleDbCommand(
                                "UPDATE tbimport SET Status = 0, TKNo = ?, SohieuTP = ? WHERE ID = ?",
                                conn, tran);
                            cmdUpdateImport.Parameters.Add("?", OleDbType.VarWChar);
                            cmdUpdateImport.Parameters.Add("?", OleDbType.VarWChar);
                            cmdUpdateImport.Parameters.Add("?", OleDbType.Integer);

                            OleDbCommand cmdUpdateDetail154 = new OleDbCommand(
                                "UPDATE tbimportdetail SET SoLuong=?, Dongia=?, TTien=? WHERE ID=?",
                                conn, tran);
                            cmdUpdateDetail154.Parameters.Add("?", OleDbType.Double);
                            cmdUpdateDetail154.Parameters.Add("?", OleDbType.Double);
                            cmdUpdateDetail154.Parameters.Add("?", OleDbType.Double);
                            cmdUpdateDetail154.Parameters.Add("?", OleDbType.Integer);

                            OleDbCommand cmdUpdateDetailTK = new OleDbCommand(
                                "UPDATE tbimportdetail SET TKNo=?, MaCT=? WHERE ID=?",
                                conn, tran);
                            cmdUpdateDetailTK.Parameters.Add("?", OleDbType.VarWChar);
                            cmdUpdateDetailTK.Parameters.Add("?", OleDbType.VarWChar);
                            cmdUpdateDetailTK.Parameters.Add("?", OleDbType.Integer);

                            OleDbCommand cmdDeleteDetail = new OleDbCommand();
                            cmdDeleteDetail.Connection = conn;
                            cmdDeleteDetail.Transaction = tran;

                            // ================= PROCESS =================

                            int total = lstImportVao.Count;
                            int index = 0;

                            foreach (var item in lstImportVao)
                            {
                                index++;

                                // Update progress mỗi 10 dòng
                                if (index % 10 == 0)
                                {
                                    progressPanel1.Caption =
                                        $"Đang xử lý file thứ {index} / {total}";
                                    Application.DoEvents();
                                }

                                if (!item.Checked) continue;

                                // ================= XỬ LÝ TK 15 / 154 =================
                                if (item.TKNo.Contains("15"))
                                {
                                    var items154 = item.fileImportDetails
                                        .Where(x => x.TKNo.Contains("154") && !x.TKNo.Contains("|"))
                                        .ToList();

                                    if (items154.Count > 1)
                                    {
                                        var first154 = items154.First();

                                        first154.Soluong = items154.Sum(x => x.Soluong);
                                        first154.TTien = items154.Sum(x => x.TTien);
                                        first154.Dongia = Math.Round(first154.TTien / first154.Soluong);

                                        // Update dòng 154 đầu
                                        cmdUpdateDetail154.Parameters[0].Value = first154.Soluong;
                                        cmdUpdateDetail154.Parameters[1].Value = first154.Dongia;
                                        cmdUpdateDetail154.Parameters[2].Value = first154.TTien;
                                        cmdUpdateDetail154.Parameters[3].Value = first154.ID;
                                        cmdUpdateDetail154.ExecuteNonQuery();

                                        // Delete các dòng 154 dư
                                        var deleteIds = items154
                                            .Skip(1)
                                            .Select(x => x.ID)
                                            .ToList();

                                        if (deleteIds.Count > 0)
                                        {
                                            cmdDeleteDetail.CommandText =
                                                $"DELETE FROM tbimportdetail WHERE ID IN ({string.Join(",", deleteIds)})";
                                            cmdDeleteDetail.ExecuteNonQuery();

                                            item.fileImportDetails.RemoveAll(x => deleteIds.Contains(x.ID));
                                        }
                                    }

                                    // Split TKNo | SoHieuTP
                                    if (item.TKNo.Contains("|"))
                                    {
                                        var split = item.TKNo.Split('|');
                                        item.TKNo = split[0];
                                        item.SoHieuTP = split[1];

                                        cmdUpdateImport.Parameters[0].Value = item.TKNo;
                                        cmdUpdateImport.Parameters[1].Value = item.SoHieuTP;
                                        cmdUpdateImport.Parameters[2].Value = item.ID;
                                        cmdUpdateImport.ExecuteNonQuery();
                                    }
                                }

                                // ================= UPDATE STATUS =================
                                //using (OleDbCommand cmdStatus = new OleDbCommand(
                                //    "UPDATE tbimport SET Status = 0 WHERE ID = ?",
                                //    conn, tran))
                                //{
                                //    cmdStatus.Parameters.Add("?", OleDbType.Integer).Value = item.ID;
                                //    cmdStatus.ExecuteNonQuery();
                                //}

                                // ================= DETAIL =================
                                    foreach (var it in item.fileImportDetails)
                                {
                                    // Split TKNo | MaCT
                                    if (it.TKNo.Contains("|"))
                                    {
                                        var split = it.TKNo.Split('|');
                                        it.TKNo = split[0];
                                        it.MaCT = split[1];

                                        cmdUpdateDetailTK.Parameters[0].Value = it.TKNo;
                                        cmdUpdateDetailTK.Parameters[1].Value = it.MaCT;
                                        cmdUpdateDetailTK.Parameters[2].Value = it.ID;
                                        cmdUpdateDetailTK.ExecuteNonQuery();
                                    }

                                    // Insert hàng hóa
                                    if (item.TKNo.Contains("15") || (item.TKNo.Contains("642") && item.isHaschild))
                                    {
                                        if (string.IsNullOrEmpty(it.SoHieu))
                                        {
                                            XtraMessageBox.Show(
                                                $"Hóa đơn {item.SHDon}, Có sản phẩm chưa nhập Mã!");
                                            throw new Exception("Thiếu mã hàng");
                                        }

                                        if (!it.TKNo.Contains("154") && !it.TKNo.Contains("642"))
                                        {
                                            InsertHangHoa2(
                                                Helpers.ConvertUnicodeToVni(it.DVT),
                                                it.SoHieu,
                                                Helpers.ConvertUnicodeToVni(it.Ten),
                                                it.TKNo);
                                        }
                                    }
                                }
                            }

                            tran.Commit();
                        }
                        catch
                        {
                            tran.Rollback();
                            throw;
                        }
                    }
                }


                
            }
            else
            {
              
                UpdateStatusImportVao_Safe(lstImportRa); 

                string querys = "SELECT * FROM License";
                var getLc = ExecuteQuery(querys, null);

                // int findmpl = ListPhanloaiVattu.AsEnumerable().Where(m => m.Field<string>("SoHieu") == "TP").FirstOrDefault().Field<int>("MaSo");
                using (OleDbConnection conn = new OleDbConnection(connectionString))
                {
                    conn.Open();
                    using (OleDbTransaction tran = conn.BeginTransaction())
                    {
                        try
                        {
                            // ================= PREPARE COMMAND =================

                            OleDbCommand cmdUpdateImport = new OleDbCommand(
                                "UPDATE tbimport SET TKCo = ?, SohieuTP = ? WHERE ID = ?",
                                conn, tran);
                            cmdUpdateImport.Parameters.Add("?", OleDbType.VarWChar);
                            cmdUpdateImport.Parameters.Add("?", OleDbType.VarWChar);
                            cmdUpdateImport.Parameters.Add("?", OleDbType.Integer);

                            OleDbCommand cmdDeleteDetailByParent = new OleDbCommand(
                                "DELETE FROM tbimportdetail WHERE ParentId = ?",
                                conn, tran);
                            cmdDeleteDetailByParent.Parameters.Add("?", OleDbType.Integer);

                            OleDbCommand cmdUpdateDetail = new OleDbCommand(
                                "UPDATE tbimportdetail SET TKCo = ?, MaCT = ? WHERE ID = ?",
                                conn, tran);
                            cmdUpdateDetail.Parameters.Add("?", OleDbType.VarWChar);
                            cmdUpdateDetail.Parameters.Add("?", OleDbType.VarWChar);
                            cmdUpdateDetail.Parameters.Add("?", OleDbType.Integer);

                            // ================= PROCESS =================

                            int total = lstImportRa.Count;
                            int index = 0;

                            foreach (var item in lstImportRa)
                            {
                                index++;

                                if (!item.Checked) continue;

                                // Progress (giảm DoEvents)
                                if (index % 10 == 0)
                                {
                                    progressPanel2.Caption =
                                        $"Đang xử lý file thứ {index} / {total}";
                                    Application.DoEvents();
                                }

                                // ================= KIỂM TRA TÀI KHOẢN CON =================
                                if (Kiemtrataikhoancon(item.TKNo))
                                {
                                    XtraMessageBox.Show($"Tài khoản {item.TKNo} có chi tiết");
                                    throw new Exception("TK có tài khoản con");
                                }

                                // ================= SPLIT TKCo | SohieuTP =================
                                if (item.TKCo.Contains("|"))
                                {
                                    var split = item.TKCo.Split('|');
                                    item.TKCo = split[0];
                                    item.SoHieuTP = split[1];

                                    cmdUpdateImport.Parameters[0].Value = item.TKCo;
                                    cmdUpdateImport.Parameters[1].Value = item.SoHieuTP;
                                    cmdUpdateImport.Parameters[2].Value = item.ID;
                                    cmdUpdateImport.ExecuteNonQuery();

                                    // Xóa toàn bộ detail
                                    cmdDeleteDetailByParent.Parameters[0].Value = item.ID;
                                    cmdDeleteDetailByParent.ExecuteNonQuery();

                                    item.fileImportDetails.Clear();
                                }

                                // ================= DELETE DETAIL KHÔNG CẦN =================
                                if (!item.isHaschild &&
                                    !item.fileImportDetails.Any(x => x.TKCo.Contains("5111")))
                                {
                                    cmdDeleteDetailByParent.Parameters[0].Value = item.ID;
                                    cmdDeleteDetailByParent.ExecuteNonQuery();
                                }

                                // ================= DETAIL =================
                                foreach (var it in item.fileImportDetails)
                                {
                                    // Split TKCo | MaCT
                                    if (it.TKCo.Contains("|"))
                                    {
                                        var split = it.TKCo.Split('|');
                                        it.TKCo = split[0];
                                        it.MaCT = split[1];

                                        cmdUpdateDetail.Parameters[0].Value = it.TKCo;
                                        cmdUpdateDetail.Parameters[1].Value = it.MaCT;
                                        cmdUpdateDetail.Parameters[2].Value = it.ID;
                                        cmdUpdateDetail.ExecuteNonQuery();
                                    }

                                    // Insert hàng hóa
                                    if (!it.TKCo.Contains("5113"))
                                    {
                                        InsertHangHoa2(
                                            Helpers.ConvertUnicodeToVni(it.DVT),
                                            it.SoHieu,
                                            Helpers.ConvertUnicodeToVni(it.Ten),
                                            it.TKCo);
                                    }
                                }
                            }

                            tran.Commit();
                        }
                        catch
                        {
                            tran.Rollback();
                            throw;
                        }
                    }
                }

            }
            //Nếu isHAschild


            isClick = true;
           
            this.Close();
        } 
        private void simpleButton7_Click(object sender, EventArgs e)
        {
            progressPanel1.Visible = true;
            Application.DoEvents();
            string query = "SELECT * FROM tbimport where Type=?";
            var parameters = new OleDbParameter[]
                     {
            new OleDbParameter("?", "3"),
                     };
            var kq = ExecuteQuery(query, parameters);
            if (kq.Rows.Count > 0)
            {
                foreach (DataRow item in kq.Rows)
