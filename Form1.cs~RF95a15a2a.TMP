        System.Data.DataTable tbDinhDanhtaikhoanUuTien;
        private async Task LoadDataGridviewAsync(int type)
        {
            try
            {
                //string quer = "SELECT * FROM License";
                var getLcv = tbLicense;

                //string query = "SELECT * FROM tbRegister";
                var kq2 = tbRegister;
                if (string.IsNullOrEmpty(tokken))
                {
                    tokken = kq2.Rows[0]["tokken"].ToString();
                }
                mstcty = kq2.Rows[0]["Username"].ToString();
                tbDinhDanhtaikhoan = LoadDinhDanhTaiKhoan();
             

                string queryCheckVatTu = @"SELECT * FROM tbimport 
           WHERE Status <> 1 and Status <> 2 
           AND Type = ?
           AND NLap >= ? AND NLap <= ?";
                var parameterss = new OleDbParameter[]
                   {
    new OleDbParameter("?", type), // Ensure 'type' is correctly defined
    new OleDbParameter("?", dtTungay.DateTime.Date), // Start date
    new OleDbParameter("?", dtDenngay.DateTime.Date) // End date
                   };

                // Execute the query with the parameters
                var kq = ExecuteQuery(queryCheckVatTu, parameterss);

                //Duyệt trong hoa don chung tu
                var joinedLookup = existingTbHoadon.AsEnumerable()
                    .Join(existingTbChungtu.AsEnumerable(),
                          h => RemoveLeadingZeros(h.Field<string>("SoHD")),           
                          c => RemoveLeadingZeros(c.Field<string>("SoHieu")),       
                          (h, c) => new {     
                              HoaDon = h,
                              ChungTu = c
                          })
                    .ToLookup(x => new {                       
                        SoHD = RemoveLeadingZeros(x.ChungTu.Field<string>("SoHieu")).TrimEnd('.'),
                        NgayCT = x.ChungTu.Field<DateTime>("NgayCT"),
                        MaKH = x.HoaDon.Field<int>("MaKhachHang")
                    });

                // Duyệt và kiểm tra
                foreach (DataRow l in kq.Rows)
                {
                    try
                    {
                        if (l["SHDon"].ToString() == "100")
                        {
                            int check = 10;
                        }
                        //Lấy Ma so thue
                        var getkh = tbKhachhang.AsEnumerable().Where(m => m.Field<string>("MST") == l.Field<string>("Mst")).FirstOrDefault();
                        string getmst = "";
                        if (getkh != null)
                        {
                            getmst = getkh.Field<string>("MST");
                        }
                        if (chkDauvao.Checked)
                        {
                            var key = new
                            {
                                SoHD = RemoveLeadingZeros(l["SHDon"].ToString()),
                                NgayCT = l.Field<DateTime>("NLap"),
                                MaKH = getkh.Field<int>("MaSo")
                            };

                            // Kiểm tra tồn tại trong kết quả JOIN - O(1)
                            if (joinedLookup[key].Any())
                                l.Delete();
                        }
                        else
                        {
                            if (getkh != null)
                            {
                                var key = new
                                {
                                    SoHD = RemoveLeadingZeros(l["SHDon"].ToString()),
                                    NgayCT = l.Field<DateTime>("NLap"),
                                    MaKH = getkh.Field<int>("MaSo")
                                };

