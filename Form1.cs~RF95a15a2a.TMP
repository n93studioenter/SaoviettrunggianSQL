            }
            if (xtraTabControl2.SelectedTabPageIndex == 3)
            {
                existingTbChungtu = await Task.Run(() =>
               ExecuteQuery("SELECT * FROM ChungTu", null)
           );

                _chungtuLookup = existingTbChungtu.AsEnumerable()
                    .ToLookup(r => (
