        private void SaveHoadonexcel()
        {
            //Kiểm tra dữ liệu đã đươc thêm chưa
            string qr = "SELECT * FROM tbimport";
            var kq2 = ExecuteQuery(qr, null);

            foreach (var item in lstFileImporthd)
            {
                //Cập nhật lại nội dung
                item.Noidung = "Nhập kho ";
                foreach (var it in item.fileImportDetails)
                {
                    var index = item.fileImportDetails.IndexOf(it);
                    if (index < item.fileImportDetails.Count() - 1)
                        item.Noidung += it.Ten + ", ";
                    else
                        item.Noidung += it.Ten;
                }
                item.TongTien = item.fileImportDetails.Sum(m => m.TTien);
                var check = kq2.AsEnumerable().ToList().Where(m => m.Field<double>("TongTien") == item.TongTien && m.Field<string>("Ten") == Helpers.ConvertUnicodeToVni(item.Ten)).FirstOrDefault();
                if (check != null)
                {
                    XtraMessageBox.Show("Hóa đơn " + item.Ten + " đã tồn tại trong hệ thống.", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                    progressPanel1.Visible = false;
                    break;
                }
                //Cập nhật lại tổng tiền
                item.TongTien = item.fileImportDetails.Sum(m => m.TTien);
                string query = @"INSERT INTO tbImport (SHDon, KHHDon, NLap, Ten, Noidung,TKNo,TKCo, TkThue, Mst, Status, Ngaytao, TongTien,Type,TPhi,TgTCThue,TgTThue,TVat3,TVat2,TVat,Vat3,Vat2)
                VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)";

                OleDbParameter[] parameters = new OleDbParameter[]
         {
                 new OleDbParameter("?", item.SHDon),
                 new OleDbParameter("?", item.KHHDon),
                 new OleDbParameter("?", item.NLap),
                 new OleDbParameter("?", Helpers.ConvertUnicodeToVni(item.Ten)),
                 new OleDbParameter("?", Helpers.ConvertUnicodeToVni(item.Noidung)),
                 new OleDbParameter("?",item.TKNo),
                 new OleDbParameter("?",item.TKCo),
                 new OleDbParameter("?",item.TkThue),
                 new OleDbParameter("?", item.Mst),
                 new OleDbParameter("?", "0"),
                 new OleDbParameter("?", DateTime.Now.ToShortDateString()),
                 new OleDbParameter("?", item.TongTien),
                 new OleDbParameter("?","3"),
                 new OleDbParameter("?","0"),
                 new OleDbParameter("?","0"),
                 new OleDbParameter("?","0"),
                 new OleDbParameter("?","0"),
                 new OleDbParameter("?","0"),
                 new OleDbParameter("?","0"),
                 new OleDbParameter("?","0"),
                 new OleDbParameter("?","0"),

         };

                try
                {
                    int a = ExecuteQueryResult(query, parameters);
                    var idQuery = "SELECT TOP 1 ID FROM tbimport ORDER BY ID DESC";

                    var data = ExecuteQuery(idQuery, null);
                    SaveHoadonexcelDetail(int.Parse(data.Rows[0]["ID"].ToString()), item.fileImportDetails);
                }
                catch (Exception ex)
                {
                    XtraMessageBox.Show("Lỗi khi lưu hóa đơn: " + ex.Message, "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Error);
                }
            }
        }
        private void SaveHoadonexcelDetail(int idparent, List<FileImportDetail2> lstdetail)
        {

            foreach (var it in lstdetail)
            {
                if (it.SoHieu == null)
                {
                    it.SoHieu = "";
                }
                string query = @"
                    INSERT INTO tbimportdetail (ParentId, SoHieu, SoLuong, DonGia, DVT, Ten, MaCT, TKNo, TKCo, TTien)
                    VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)";

                var parameters = new OleDbParameter[]
                {
                        new OleDbParameter("?", idparent),
                        new OleDbParameter("?", it.SoHieu),
                        new OleDbParameter("?", it.Soluong),
                        new OleDbParameter("?",it.Dongia),
                        new OleDbParameter("?", ""),
                        new OleDbParameter("?", it.Ten!=null?Helpers.ConvertUnicodeToVni(it.Ten):""),
                        new OleDbParameter("?", ""),
                        new OleDbParameter("?", it.TKNo),
                        new OleDbParameter("?", it.TKCo),
                        new OleDbParameter("?", it.TTien),
                };
                try
                {
                    ExecuteQueryResult(query, parameters);
                }
                catch (Exception ex)
                {
                    var aa = ex.Message;
                }
            }

            progressPanel1.Visible = false;
        }

        private void simpleButton6_Click(object sender, EventArgs e)
        {
            lstImportVao = new BindingList<FileImport>();
            string queryCheckVatTu = @"SELECT * FROM tbimport   WHERE   Type = ? and Status <> ?";

            var parameterss = new OleDbParameter[]
            {
                 new OleDbParameter("?", "3"),
                 new OleDbParameter("?", "1")
            };
            var kq = ExecuteQuery(queryCheckVatTu, parameterss);
            FileImport fileImport = null;
            foreach (DataRow item in kq.Rows)
            {
                try
                {
                    if (item["SHDon"].ToString()== "NKPVP1/2")
                    {
                        int a = 10;
                    }
                    //Kiểm tra đã có trong phần mềm chưa
                    var check = tbKhachhang.AsEnumerable().Where(m => Helpers.RemoveVietnameseDiacritics(Helpers.ConvertVniToUnicode(m["Ten"].ToString())).ToLower().Contains(Helpers.RemoveVietnameseDiacritics(Helpers.ConvertVniToUnicode(item.Field<string>("Ten").Trim().ToLower())))).FirstOrDefault();
                    //Tìm hoá đơn của khách gần nhất để lấy mã
                    var joinlist = (from c in existingTbChungtu.AsEnumerable()
                                    join h in existingTbHoadon.AsEnumerable()
                                    on c.Field<int>("MaSo") equals h.Field<int>("MaSo")
                                    where c.Field<DateTime>("NgayCT").Date == item.Field<DateTime>("NLap").Date
                                    && h.Field<int>("MaKhachHang") == check.Field<int>("MaSo")
                                    && h.Field<string>("SoHD").Contains("NK")
                                    select new
                                    {
                                        h,
                                        c
                                    }).Distinct().ToList();
                    if (joinlist.Count > 0)
                    {
                        var grcheck = joinlist
                      .GroupBy(h => new { SoHD = h.h.Field<string>("SoHD"), MaKH = h.h.Field<int>("MaKhachHang"), Ngay = h.c.Field<DateTime>("NgayCT") })
                      .Select(g => new
                      {
                          SoHD = g.Key.SoHD,
                          MaKH = g.Key.MaKH,
                          TongTien = g.Sum(x => x.h.Field<double>("ThanhTien")),
                          Ngay = g.Key.Ngay
                      }).FirstOrDefault();
                        if (grcheck.MaKH == check.Field<int>("MaSo") && grcheck.TongTien == item.Field<double>("TongTien") && grcheck.Ngay.Date == DateTime.Parse(item["NLap"].ToString()))
                        {
                            string query = @"update   tbimport set Status=1  WHERE ID=?";
                            var parameters = new OleDbParameter[]
                             {
                      new OleDbParameter("?", item.Field<int>("ID"))
                             };
                            int rowsAffecteds = ExecuteQueryResult(query, parameters);
                            continue;
                            
                        }
                    }
              

                  
                    // if (findhd != null)
                    //     continue;
                    // Tạo các biến tạm cho từng tham số
                    string path = item["Path"].ToString();
                    string shDon = item["SHDon"].ToString();
                    string khhDon = item["KHHDon"].ToString();
                    DateTime nLap = item.Field<DateTime>("NLap");
                    string ten = Helpers.ConvertVniToUnicode(item["Ten"].ToString());
                    string noidung = Helpers.ConvertVniToUnicode(item["Noidung"].ToString());
                    string tkNo = item["TKNo"].ToString();
                    string tkCo = item["TKCo"].ToString();
                    int tkThue = int.Parse(item["TKThue"].ToString());
                    string mst = item["Mst"].ToString();
                    double tongTien = double.Parse(item["TongTien"].ToString());
                    int vat = int.Parse(item["Vat"].ToString());
                    int vat2 = !string.IsNullOrEmpty(item["Vat2"].ToString()) ? int.Parse(item["Vat2"].ToString()) : 0;
                    double Tvat = !string.IsNullOrEmpty(item["TVat"].ToString()) ? double.Parse(item["TVat"].ToString()) : 0;
                    double Tvat2 = !string.IsNullOrEmpty(item["TVat2"].ToString()) ? double.Parse(item["TVat2"].ToString()) : 0;
                    int vat3 = !string.IsNullOrEmpty(item["Vat3"].ToString()) ? int.Parse(item["Vat3"].ToString()) : 0;
                    double Tvat3 = !string.IsNullOrEmpty(item["TVat3"].ToString()) ? double.Parse(item["TVat3"].ToString()) : 0;
                    string Macdinhstatus = item["Macdinhstatus"].ToString();
                    string soHieuTP = item["SohieuTP"].ToString();
                    bool hasChild = true; // Giá trị mặc định
                    double tpHi = 0;
                    double tgTCThue = 0;
                    double tgTThue = 0;
                    int invoiceType = 0;

                    // Khởi tạo đối tượng FileImport
                    fileImport = new FileImport(true,path, shDon, khhDon, nLap, nLap, ten, noidung, tkNo, tkCo, tkThue, mst, tongTien, vat, 3, soHieuTP, hasChild, tpHi, tgTCThue, tgTThue, true, invoiceType, Tvat, vat2, Tvat2, vat3, Tvat3, Macdinhstatus);
                    fileImport.ID = int.Parse(item["ID"].ToString());
                    queryCheckVatTu = @"SELECT * FROM tbimportdetail WHERE   ParentId= ?";
                    parameterss = new OleDbParameter[]
                    {
                            new OleDbParameter("?",int.Parse(item["ID"].ToString()))
                    };
                    var kq2 = ExecuteQuery(queryCheckVatTu, parameterss);
                    foreach (DataRow it in kq2.Rows)
                    {
                        FileImportDetail fileImportDetail = new FileImportDetail(int.Parse(it["ID"].ToString()), Helpers.ConvertVniToUnicode(it["Ten"].ToString()), int.Parse(it["ParentId"].ToString()), (string)it["SoHieu"], double.Parse(it["SoLuong"].ToString()), double.Parse(it["DonGia"].ToString()), "", "", it["TKNo"].ToString(), it["TKCo"].ToString(), double.Parse(it["TTien"].ToString()), it["Percent"].ToString(), int.Parse(it["Tchat"].ToString()));
                        fileImport.fileImportDetails.Add(fileImportDetail);
                    }
                    lstImportVao.Add(fileImport);
                }
                catch (Exception ex)
                {
                    // Xử lý lỗi ở đây, ví dụ như ghi log hoặc thông báo cho người dùng
                    XtraMessageBox.Show("Hóa đơn " + item["SHDon"].ToString() + " không thể đọc dữ liệu. Vui lòng kiểm tra lại.");
                    continue;
                }
            }
            if (lstImportVao.Count == 0)
                XtraMessageBox.Show("Đã hết hoá đơn để import");
            bindingSource.DataSource = lstImportVao;
            gridControl1.DataSource = bindingSource;
            gridControl1.RefreshDataSource();
            gridView1.OptionsDetail.EnableMasterViewMode = true;
        }

