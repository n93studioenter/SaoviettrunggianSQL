        int tongsohodadon = 0;
        public void DocfileExcelVao()
        {
            string directoryPath = Path.Combine(savedPath, "HDVao", dtTungay.DateTime.Month.ToString());

            var excelFiles = Directory.EnumerateFiles(directoryPath, "*.xlsx", SearchOption.AllDirectories).Where(m=>m.Contains(mstcongty)).ToList();
            tongsohodadon = excelFiles.Count;
            int i = 1;
            foreach (var excelFile in excelFiles)
            {
                using (var workbook = new XLWorkbook(excelFile))

                {
                    var worksheet = workbook.Worksheet(1); // Lấy sheet đầu tiên
                    foreach (var row in worksheet.RowsUsed().Skip(3)) // Bỏ qua 6 hàng đầu tiên
                    {
                        string khhd = row.Cell("B").Value.ToString(); // Lấy giá trị của cột A trong hàng hiện tại
                        string getSHHD = row.Cell("C").Value.ToString(); // Lấy giá trị của cột A trong hàng hiện tại
                        string getSohd =Helpers.RemoveLeadingZeros(row.Cell("D").Value.ToString()); // Lấy giá trị của cột C trong hàng hiện tại 
                        string GetNLap = row.Cell("E").Value.ToString();
                        string mstnb= row.Cell("F").Value.ToString();

                        //Kiểm tra từ ngày đến ngày
                        DateTime getdate = DateTime.Parse(GetNLap);
                        if (getdate < dtTungay.DateTime || getdate > dtDenngay.DateTime)
                            continue;

                        //Kiểm tra xem hoá đơn đã có trong bảng tbimport chưa
                        //var checkFile=tbimport.AsEnumerable().Where()
                        //Tải file xml
                        string url = "";
                        if (i == 1 || i==2)
                            url = $"https://hoadondientu.gdt.gov.vn:30000/query/invoices/export-xml?nbmst={mstnb}&khhdon={getSHHD}&shdon={getSohd}&khmshdon={khhd}";
                        if (i == 3)
                        {
                            url = $"https://hoadondientu.gdt.gov.vn:30000/sco-query/invoices/export-xml?nbmst={mstnb}&khhdon={getSHHD}&shdon={getSohd}&khmshdon={khhd}";
                            //https://hoadondientu.gdt.gov.vn:30000/sco-query/invoices/export-xml?nbmst=0316158113-006&khhdon=C25MVX&shdon=660264&khmshdon=1

                        }
                        string pathravao = "HDVao";
                        string filename = $"{mstnb}_{getSohd}_{getSHHD}.zip";
                        string filenameCheck= $"{mstnb}_{getSohd}_{getSHHD}.html";
                        string path = Path.Combine(savedPath, pathravao, dtTungay.DateTime.Month.ToString(), filename);
                        string pathcheck = Path.Combine(savedPath, pathravao, dtTungay.DateTime.Month.ToString(), filenameCheck);

                        //Kiểm tra nếu hoá đơn chưa dc tải thì tải về
                        if (!File.Exists(pathcheck))
                        {
                            using (var client = new HttpClient())
                            {
                                client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", tokken);
                                client.DefaultRequestHeaders.Accept.Add(new MediaTypeWithQualityHeaderValue("application/octet-stream"));

                                try
                                {
                                    HttpResponseMessage response = client.GetAsync(url).Result; // Sử dụng .Result
                                    response.EnsureSuccessStatusCode(); // Ném ngoại lệ nếu không thành công

                                    // Đọc nội dung phản hồi dưới dạng byte
                                    var fileBytes = response.Content.ReadAsByteArrayAsync().Result;

                                    // Lưu file ZIP bằng FileStream
                                    using (var fileStream = new FileStream(path, FileMode.Create, FileAccess.Write, FileShare.None, bufferSize: 4096))
                                    {
                                        fileStream.Write(fileBytes, 0, fileBytes.Length);
                                    }

                                    Console.WriteLine($"File ZIP đã được lưu tại: {path}");
                                    ExtractZipXML(path); // Giải nén file ZIP
                                    //progressPanel1.Caption = $"Đang đọc hoá đơn";
                                    //Application.DoEvents();
                                }
                                catch (Exception ex)
                                {
                                    //Trường hợp nếu ko tải được thì phải tải từ nguổn
                                    //GetKNMXML(mstnb, getSHHD, getSohd, tokken, getdate);
                                }
                            }
                        } 
                    }
                }
                i++;
            }
        }
        static int totalInvoices = 0;
        static int currentProgress = 0;
        public async Task DocfileExcelVaoAsync()
        {
            taihoddon = true;
            totalInvoices = 0;
            currentProgress = 0;
            GDTClient.UpdateToken(tokken);
            string directoryPath = Path.Combine(savedPath, "HDVao", dtTungay.DateTime.Month.ToString());

            var excelFiles = Directory.EnumerateFiles(directoryPath, "*.xlsx", SearchOption.AllDirectories).Where(m => m.Contains(mstcongty)).ToList();
             

            // Đếm tổng số hóa đơn cần xử lý (để hiển thị tiến độ chính xác)
            foreach (var excelFile in excelFiles)
            {
                using (var workbook = new XLWorkbook(excelFile))
                {
                    var worksheet = workbook.Worksheet(1);
                    foreach (var row in worksheet.RowsUsed().Skip(3))
                    {
                        string GetNLap = row.Cell("E").Value.ToString();
                        string getSohd = Helpers.RemoveLeadingZeros(row.Cell("D").Value.ToString()); // Lấy giá trị của cột C trong hàng hiện tại 
                        string mstnb = row.Cell("F").Value.ToString();
                        if (DateTime.TryParse(GetNLap, out DateTime getdate))
                        {
                            DateTime gd = DateTime.Parse(GetNLap);
                            bool daTonTai = lookupHoaDonCT.Contains((mstnb, getSohd, gd.Date));
                            bool daTonTaiimport=lookupTbImport.Contains((mstnb, getSohd, gd.Date));
                            if (getdate < dtTungay.DateTime || getdate > dtDenngay.DateTime || daTonTai || daTonTaiimport)
                            {
                                continue;
                            }
                            totalInvoices++;
                        }
                    }
                }
            }
            if (totalInvoices == 0)
            {
                btnChonthang.PerformClick();
            }
            progressPanel1.Caption = $"Đang đọc file thứ {currentProgress} / {totalInvoices}";
            tongsohodadon = excelFiles.Count;
            int i = 1;
            int invoiceType = 0;
            foreach (var excelFile in excelFiles)
            {
                using (var workbook = new XLWorkbook(excelFile))

                {
                    var worksheet = workbook.Worksheet(1); // Lấy sheet đầu tiên
                    foreach (var row in worksheet.RowsUsed().Skip(3)) // Bỏ qua 6 hàng đầu tiên
                    {
                        string khhd = row.Cell("B").Value.ToString(); // Lấy giá trị của cột A trong hàng hiện tại
                        string getSHHD = row.Cell("C").Value.ToString(); // Lấy giá trị của cột A trong hàng hiện tại
                        string getSohd = Helpers.RemoveLeadingZeros(row.Cell("D").Value.ToString()); // Lấy giá trị của cột C trong hàng hiện tại 
                        string GetNLap = row.Cell("E").Value.ToString();
                        string mstnb = row.Cell("F").Value.ToString();

                        //Kiểm tra từ ngày đến ngày
                        DateTime getdate = DateTime.Parse(GetNLap);
                        bool daTonTai = lookupHoaDonCT.Contains((mstnb, getSohd, getdate.Date));
                        bool daTonTaiimport = lookupTbImport.Contains((mstnb, getSohd, getdate.Date));
                        if (getdate < dtTungay.DateTime || getdate > dtDenngay.DateTime || daTonTai || daTonTaiimport)
                        {
                            continue;
                        }

                        //Kiểm tra xem hoá đơn đã có trong bảng tbimport chưa
                        //var checkFile=tbimport.AsEnumerable().Where()
                        //Tải file xml
                        invoiceType = i;

                        string url = "";
                        if (i == 1 || i == 2)
                            url = $"https://hoadondientu.gdt.gov.vn:30000/query/invoices/export-xml?nbmst={mstnb}&khhdon={getSHHD}&shdon={getSohd}&khmshdon={khhd}";
                        if (i == 3)
                        {
                            url = $"https://hoadondientu.gdt.gov.vn:30000/sco-query/invoices/export-xml?nbmst={mstnb}&khhdon={getSHHD}&shdon={getSohd}&khmshdon={khhd}";
                            //https://hoadondientu.gdt.gov.vn:30000/sco-query/invoices/export-xml?nbmst=0316158113-006&khhdon=C25MVX&shdon=660264&khmshdon=1

                        }
                        string pathravao = "HDVao";
                        string filename = $"{mstnb}_{getSohd}_{getSHHD}.zip";
                        string filenameCheck = $"{mstnb}_{getSohd}_{getSHHD}.xml";
                        string path = Path.Combine(savedPath, pathravao, dtTungay.DateTime.Month.ToString(), filename);
                        string pathcheck = Path.Combine(savedPath, pathravao, dtTungay.DateTime.Month.ToString(), filenameCheck);
                        string folderpath= Path.Combine(savedPath, pathravao, dtTungay.DateTime.Month.ToString());

                        string filenameCheckknm = $"{mstnb}_{getSohd}_{getSHHD}_KNM.xml";
                        string knmPath= Path.Combine(savedPath, pathravao, dtTungay.DateTime.Month.ToString(), filenameCheckknm);
                        if (getSohd== "26216991")
                        {
                            int a = 10;
                        }
                        //Kiểm tra nếu hoá đơn chưa dc tải thì tải về
                        if (!File.Exists(pathcheck) && !File.Exists(knmPath))
                        {
                            try
                            {
                                // Tối ưu: Bỏ Thread.Sleep không cần thiết 
                                await GDTClient.DownloadFileAsync(
                                url: url,
                                savePath: path,
                                token: tokken,
                                dt: getdate,
                                completionCallback: (success, message, progressCount) =>  // THÊM CALLBACK
                                {
                                    // CHỈ CHẠY KHI FILE TẢI XONG THẬT SỰ
                                    if (success)
                                    {
                                        // Cập nhật UI
                                        progressPanel1.Invoke(new Action(async () =>
                                        {
                                           // progressPanel1.Caption = $"Đang đọc file thứ {currentProgress} / {totalInvoices}";
                                            string ph = Path.Combine(savedPath, pathravao, dtTungay.DateTime.Month.ToString(), filenameCheck); ;
                                            if (File.Exists(ph))
                                            {
                                                // Kiểm tra xem có phải đuôi .xml không (không phân biệt hoa thường)
                                                if (Path.GetExtension(ph).Equals(".xml", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    await DocfileXmlOne(ph, currentIndex);
                                                }
                                                else
                                                {
                                                    // Có thể là file .pdf hoặc file đính kèm khác, ta bỏ qua
                                                    Debug.WriteLine($"Bỏ qua file không phải XML: {filenameCheck}");
                                                }
                                            }

                                            if (currentProgress== totalInvoices)
                                            {
                                               btnChonthang.PerformClick();
                                            }
                                          
                                        }));

                                        Console.WriteLine($"✅ Đã tải xong: {message}");
                                    }
                                    else
                                    {
                                        Console.WriteLine($"❌ Lỗi: {message}");
                                    }
                                }
                            );
                            }
                            catch (Exception ex)
                            {
                                Console.WriteLine($"Đã xảy ra lỗi: {ex.Message}");
                                if (i != 2)
                                {
                                    richTextBox1.Text += $"Đã xảy ra lỗi: {ex.Message}  hoá đơn {getSohd} \r\n";
                                    currentProgress += 1;
                                }
                                if (i == 2)
                                    GetKNMXML(mstnb, getSHHD, getSohd, tokken, getdate, folderpath, filename);

                            }
                            //await Task.Delay(10);  // Đây chính là delay 1000ms trong async
                        }
                        else
                        {
                            //Trường hợp file đã tải vào rồi cũng cập nhật
                            currentProgress += 1;
                           // progressPanel1.Caption = $"Đang đọc file thứ {currentProgress} / {totalInvoices}";
                           
                            if (!string.IsNullOrEmpty(knmPath) && File.Exists(knmPath))
                            {
                                await DocfileXmlOne(knmPath, currentIndex);
                            }
                            else
                            {
                                string ph = Path.Combine(savedPath, pathravao, dtTungay.DateTime.Month.ToString(), filenameCheck);
                                await  DocfileXmlOne(ph, currentIndex);
                            }
                               
                            if (currentProgress == totalInvoices)
                            {
                               btnChonthang.PerformClick();
                            }
                        }
                        
                    }
                }
                i++;
            }
        }
        XmlDocument xmlDoc = new XmlDocument();
        public int sothutu = 1;
        // Phiên bản tương thích .NET Framework cũ (ví dụ .NET 4.5 trở lên, không dùng C# 8+ features như using var)
        private async Task DocfileXmlOneGoc(string pathXml, int stt)
        {
            if (pathXml == "D:\\DA3\\DA3\\Hoadon\\HDRa\\12\\3502550210_3001_C25MTD.xml")
            {
                int test = 10;
            }
            type = chkDauvao.Checked ? 1 : 2;
            if (type == 1)
            {
                progressPanel1.Caption = $"Đang đọc file {pathXml} {sothutu}/{tongfile}";
                Application.DoEvents();
            }
            try
            {
                // Sử dụng XmlReader thay vì XmlDocument
                using (var xmlReader = XmlReader.Create(pathXml, new XmlReaderSettings { Async = true }))
                {
                    // Tải toàn bộ XML vào memory document nhưng vẫn dùng XmlReader để parse
                    var xmlDoc = new XmlDocument();
                    xmlDoc.Load(xmlReader);

                    TbImport TbImport = new TbImport();
                    XmlNode root = xmlDoc.DocumentElement;
                    XmlNode TTChung = root.SelectSingleNode("//TTChung");
                    DateTime NLap = DateTime.Parse(TTChung.SelectSingleNode("NLap")?.InnerText);
                    TbImport.NLap = NLap;

                    //Kiểm tra điều chỉnh
                    XmlNodeList TTKhac = root.SelectNodes("//TTChung//TTKhac//TTin");
                    foreach (XmlNode node in TTKhac)
                    {
                        var tt = node.SelectSingleNode("DLieu")?.InnerText;
                        if (tt.ToLower().Contains("điều chỉnh"))
                        {
                            int dc = 10;
                            TbImport.Noidung = Helpers.ConvertUnicodeToVni(tt);
                        }
                    }

                    //Kiểm tra lấy trong ngày
                    if (NLap >= dtTungay.DateTime && NLap <= dtDenngay.DateTime)
                    {
                        TbImport.SHDon = Helpers.RemoveLeadingZeros(TTChung.SelectSingleNode("SHDon")?.InnerText);
                        if (TbImport.SHDon == "6015")
                        {
                            int test = 10;
                        }
                        TbImport.KHHDon = TTChung.SelectSingleNode("KHHDon")?.InnerText;
                        TbImport.Path = pathXml;
                        if (type == 1)
                        {
                            TbImport.Ten = Helpers.ConvertUnicodeToVni(root.SelectSingleNode("//NBan//Ten").InnerText);
                            TbImport.Mst = root.SelectSingleNode("//NBan//MST").InnerText;
                            //Kiểm tra file xml hợp lệ thuộc công ty
                            string mstnguoimua = root.SelectSingleNode("//NMua//MST").InnerText;
                            if (mstcongty != mstnguoimua)
                                return;
                        }
                        else
                        {
                            //Kiểm tra file xml hợp lệ thuộc công ty
                            string mstnguoiban = root.SelectSingleNode("//NBan//MST").InnerText;
                            if (mstcongty != mstnguoiban)
                                return;

                            TbImport.Mst = root.SelectSingleNode("//NMua//MST") != null ? root.SelectSingleNode("//NMua//MST").InnerText : "";
                            //Kiểm tra tên KH
                            if (root.SelectSingleNode("//NMua//Ten") != null)
                            {
                                TbImport.Ten = Helpers.ConvertUnicodeToVni(root.SelectSingleNode("//NMua//Ten").InnerText);
                            }
                            //Trường hợp không có tên thì lấy khách lẻ
                            else
                            {
                                if (root.SelectSingleNode("//NMua//HVTNMHang") != null)
                                {
                                    TbImport.Ten = Helpers.ConvertUnicodeToVni(root.SelectSingleNode("//NMua//HVTNMHang").InnerText);
                                }
                                if (TbImport.Ten == "Baùn leû khaùch khoâng laáy hoùa ñôn" || string.IsNullOrEmpty(TbImport.Ten) || TbImport.Ten == "Ngöôøi mua khoâng laáy hoùa ñôn")
                                {
                                    //Tìm khách lẻ
                                    var findKL = tbKhachhang.AsEnumerable().Where(m => m.Field<string>("SoHieu") == "KL").FirstOrDefault();
                                    if (findKL != null)
                                    {
                                        TbImport.Ten = findKL.Field<string>("Ten");
                                        TbImport.Mst = findKL.Field<string>("SoHieu");
                                    }
                                }
                            }
                        }

                        //Nếu không có MST thì thay thế = CCCD
                        string Sohieu = "";
                        if (string.IsNullOrEmpty(TbImport.Mst))
                        {
                            if (root.SelectSingleNode("//NMua//CCCDan") != null)
                            {
                                TbImport.Mst = root.SelectSingleNode("//NMua//CCCDan") != null ? root.SelectSingleNode("//NMua//CCCDan").InnerText : "";
                            }
                            if (string.IsNullOrEmpty(TbImport.Mst))
                            {
                                //Nếu không có MST, CCCD thì kiểm tra tên
                                if (!string.IsNullOrEmpty(TbImport.Ten))
                                {
                                    //Kiểm tra tên có trùng chưa
                                    var findcus = tbKhachhang.AsEnumerable().Where(m => m.Field<string>("Ten") == TbImport.Ten).FirstOrDefault();
                                    if (findcus == null)
                                    {
                                        Sohieu = GenerateAbbreviation(Helpers.ConvertVniToUnicode(TbImport.Ten), tbKhachhang.AsEnumerable().Select(row => row.Field<string>("SoHieu")).ToList()).ToUpper();
                                        //Xử lý khi số hiệu bị trùng
                                        int suffix = 1;
                                        string originalSohieu = Sohieu;

                                        while (tbKhachhang.AsEnumerable().Any(row => row.Field<string>("SoHieu") == Sohieu))
                                        {
                                            Sohieu = $"{originalSohieu}_{suffix}";
                                            suffix++;
                                        }
                                        TbImport.Mst = Sohieu;
                                    }
                                    else
                                    {
                                        TbImport.Mst = findcus.Field<string>("SoHieu");
                                    }
                                }
                                else
                                {
                                    var findKL = tbKhachhang.AsEnumerable().Where(m => m.Field<string>("SoHieu") == "KL").FirstOrDefault();
                                    if (findKL != null)
                                    {
                                        TbImport.Ten = findKL.Field<string>("Ten");
                                        TbImport.Mst = findKL.Field<string>("SoHieu");
                                    }
                                }
                            }
                        }

                        //Chặn hoá đơn dc tải từ bước tải cơ quan thuế
                        if (chkDauvao.Checked)
                        {
                            if (lstdsVao.Any(m => m.SHDon == TbImport.SHDon && m.NLap.Date == TbImport.NLap.Date && m.Mst == TbImport.Mst))
                                return;
                        }
                        else
                        {
                            if (lstdsRa.Any(m => m.SHDon == TbImport.SHDon && m.NLap.Date == TbImport.NLap.Date && m.Mst == TbImport.Mst))
                                return;
                        }

                        //Kiểm tra hoá đon 
                        if (Kiemtrahoadon(TbImport.SHDon, TbImport.NLap, TbImport.Mst))
                            return;
                        if (KiemtrahoadonCT(TbImport.SHDon, TbImport.NLap, TbImport.Mst))
                            return;

                        //Kiểm tra khách hàng có tạo chưa
                        if (TbImport.Mst != "KL")
                        {
                            if (CheckExistKH(TbImport.Mst) == false)
                            {
                                int maphanloai = 0;
                                maphanloai = type == 1 ? 2 : 3; //1 là mua, 2 là bán  
                                string diachi = "";
                                if (type == 1)
                                    diachi = root.SelectSingleNode("//NBan//DChi") != null ? root.SelectSingleNode("//NBan//DChi").InnerText : "";
                                else
                                    diachi = root.SelectSingleNode("//NMua//DChi") != null ? root.SelectSingleNode("//NMua//DChi").InnerText : "";

                                string sdt = "";
                                if (type == 1)
                                    sdt = root.SelectSingleNode("//NBan//SDThoai") != null ? root.SelectSingleNode("//NBan//SDThoai").InnerText : "";
                                else
                                    sdt = root.SelectSingleNode("//NMua//SDThoai") != null ? root.SelectSingleNode("//NMua//SDThoai").InnerText : "";
                                InitCustomer(maphanloai, Sohieu, TbImport.Ten, diachi, TbImport.Mst, "", sdt);
                            }
                        }

                        //Kiểm tra có tạo chưa
                        if (chkDauvao.Checked)
                        {
                            if (lstImportVao.Any(m => m.SHDon == TbImport.SHDon && m.NLap.Date == NLap.Date))
                            {
                                return;
                            }
                        }
                        else
                        {
                            if (lstImportRa.Any(m => m.SHDon == TbImport.SHDon && m.NLap.Date == NLap.Date))
                            {
                                return;
                            }
                        }

                        //Load mặc định
                        if (tbDinhDanhtaikhoan.Rows.Count > 0)
                        {
                            string keyword = chkDauvao.Checked ? "Ưu tiên vào" : "Ưu tiên ra";

                            if (keyword != null)
                            {
                                DataRow foundRow = tbDinhDanhtaikhoan.AsEnumerable()
                                    .FirstOrDefault(row => row.Field<string>("KeyValue")?.Contains(keyword) == true);

                                if (foundRow != null)
                                {
                                    TbImport.TKNo = foundRow["TKNo"].ToString();
                                    TbImport.TKCo = foundRow["TKCo"].ToString();
                                    TbImport.TkThue = foundRow["TKThue"].ToString();
                                }
                            }
                        }
                        TbImport.Status = 0;
                        TbImport.Ngaytao = DateTime.Now.ToShortDateString();

                        //Thông tin thanh toán
                        TbImport.TongTien = double.Parse(root.SelectSingleNode("//TgTTTBSo").InnerText);
                        TbImport.TgTCThue = root.SelectSingleNode("//TgTCThue") != null ? double.Parse(root.SelectSingleNode("//TgTCThue").InnerText) : 0;
                        TbImport.TgTThue = root.SelectSingleNode("//TgTThue") != null ? double.Parse(root.SelectSingleNode("//TgTThue").InnerText) : 0;

                        // Xử lý thuế suất với XmlReader cho hiệu quả
                        XmlNodeList nodeList = xmlDoc.SelectNodes("//LTSuat");
                        int index = 0;
                        foreach (XmlNode node in nodeList)
                        {
                            var suat = new SuatThue
                            {
                                TSuat = node.SelectSingleNode("TSuat")?.InnerText,
                                ThTien = double.Parse(node.SelectSingleNode("ThTien")?.InnerText ?? "0"),
                                TThue = double.Parse(node.SelectSingleNode("TThue")?.InnerText ?? "0")
                            };
                            if (suat != null)
                            {
                                if (!string.IsNullOrEmpty(suat.TSuat))
                                {
                                    if (index == 0)
                                    {
                                        TbImport.TgTCThue1 = suat.ThTien;
                                        TbImport.TVat = suat.TThue;

                                        //KKKNT KCT
                                        if (suat.TSuat == "KCT" || suat.TSuat == "KKKNT")
                                        {
                                            TbImport.Vat = 0;
                                        }
                                        else
                                        {
                                            TbImport.Vat = double.Parse(suat.TSuat.Replace("%", ""));
                                        }
                                    }
                                    if (index == 1)
                                    {
                                        TbImport.TgTCThue2 = suat.ThTien;
                                        TbImport.TVat2 = suat.TThue;
                                        if (suat.TSuat == "KCT" || suat.TSuat == "KKKNT")
                                        {
                                            TbImport.Vat2 = "0";
                                        }
                                        else
                                        {
                                            TbImport.Vat2 = suat.TSuat.Replace("%", "");
                                        }
                                    }
                                    if (index == 2)
                                    {
                                        TbImport.TgTCThue3 = suat.ThTien;
                                        TbImport.TVat3 = suat.TThue;

                                        if (suat.TSuat == "KCT" || suat.TSuat == "KKKNT")
                                        {
                                            TbImport.Vat3 = "0";
                                        }
                                        else
                                        {
                                            TbImport.Vat3 = suat.TSuat.Replace("%", "");
                                        }
                                    }
                                }
                            }
                            index += 1;
                        }

                        //KHMSHDon
                        TbImport.Khmshdon = root.SelectSingleNode("//KHMSHDon").InnerText;
                        string THDon = root.SelectSingleNode("//THDon").InnerText;
                        TbImport.hdon = "01";
                        if (Helpers.NormalizeVietnameseString(THDon.ToLower()).Contains("hóa đơn giá trị gia tăng") || Helpers.NormalizeVietnameseString(THDon.ToLower()).Contains("hóa đơn điện tử giá trị gia tăng"))
                        {
                            TbImport.hdon = "01";
                        }
                        if (Helpers.NormalizeVietnameseString(THDon.ToLower()).Contains("hóa đơn bán hàng"))
                        {
                            TbImport.hdon = "02";
                        }

                        // Xử lý danh sách sản phẩm với XmlReader cho hiệu quả
                        XmlNodeList nodeListHHDVu = xmlDoc.SelectNodes("//HHDVu");
                        cacheMatHangTrongHoaDon = new Dictionary<string, TbImportDetail>(StringComparer.OrdinalIgnoreCase);

                        foreach (XmlNode node in nodeListHHDVu)
                        {
                            try
                            {
                                if (node.SelectSingleNode("THHDVu")?.InnerText == "Mì Cung Đình Koolspaghetti thố khuyến mãi")
                                {
                                    int tets = 10;
                                }
                                TbImportDetail tbImportDetail = new TbImportDetail();
                                if (Loaiborow(node.SelectSingleNode("THHDVu")?.InnerText))
                                    continue;
                                tbImportDetail.Tchat = int.Parse(node.SelectSingleNode("TChat")?.InnerText);
                                tbImportDetail.Ten = node.SelectSingleNode("THHDVu")?.InnerText;
                                bool dagiam = false;
                                if (tbImportDetail.Ten.Contains("Đã giảm"))
                                {
                                    dagiam = true;
                                    string pattern = @"\d{1,3}(?:\.\d{3})*(?:,\d+)?";
                                    Match match = Regex.Match(tbImportDetail.Ten, pattern);

                                    if (match.Success)
                                    {
                                        tbImportDetail.TTien = double.Parse(match.Value.Replace(".", ""));
                                    }
                                }
                                //Loại bỏ
                                if (tbImportDetail.Tchat == 4 && dagiam == false)
                                    continue;

                                var dvtNode = node.SelectSingleNode("DVTinh");
                                tbImportDetail.DVT = CapitalizeFirstLetter(
                                    Helpers.ConvertUnicodeToVni(dvtNode?.InnerText));

                                var slNode = node.SelectSingleNode("SLuong");
                                tbImportDetail.Soluong = slNode != null && double.TryParse(slNode.InnerText, out var qty) ? qty : 0;

                                var nodeGia = node.SelectSingleNode("DGia");
                                tbImportDetail.Dongia = nodeGia != null && double.TryParse(nodeGia.InnerText, out double value) ? value : 0;
                                if (tbImportDetail.TTien == 0)
                                    tbImportDetail.TTien = node.SelectSingleNode("ThTien") != null ? double.Parse(node.SelectSingleNode("ThTien")?.InnerText) : 0;

                                string keyCache = NormalizeVietnameseString(tbImportDetail.Ten);
                                if (node.SelectSingleNode("THHDVu")?.InnerText == "Xăng RON 95 Mức 3")
                                {
                                    int a = 10;
                                }
                                if (cacheMatHangTrongHoaDon.TryGetValue(keyCache, out TbImportDetail daXuLy))
                                {
                                    tbImportDetail.SoHieu = daXuLy.SoHieu;
                                    tbImportDetail.Percent = daXuLy.Percent;
                                }
                                else
                                {
                                    Xulysohieuvattu(tbImportDetail);
                                    cacheMatHangTrongHoaDon[keyCache] = tbImportDetail;
                                }

                                tbImportDetail.Ten = Helpers.ConvertUnicodeToVni(tbImportDetail.Ten);
                                tbImportDetail.TKNo = TbImport.TKNo;
                                tbImportDetail.TKCo = TbImport.TKCo;
                                if (chkDauvao.Checked)
                                {
                                    if (tbImportDetail.Tchat == 3 || dagiam == true)
                                    {
                                        tbImportDetail.TKCo = "711";
                                    }
                                }
                                tbImportDetail.Percent = Math.Round(double.Parse(tbImportDetail.Percent.ToString()));
                                TbImport.tbImportDetails.Add(tbImportDetail);
                            }
                            catch (Exception ex)
                            {
                                XtraMessageBox.Show(node.SelectSingleNode("THHDVu")?.InnerText + "   " + TbImport.SHDon);
                            }
                        }

                        //Cập nhật nội dung cho Parent
                        if (string.IsNullOrEmpty(TbImport.Noidung))
                        {
                            if (TbImport.tbImportDetails.Count > 0)
                            {
                                TbImport.Noidung = TbImport.tbImportDetails.FirstOrDefault().Ten;
                            }
                        }

                        if (chkDauvao.Checked)
                        {
                            Xuly711(TbImport);
                            lstdsVao.Add(TbImport);
                            await SaveDataXmlOne(TbImport, chkDauvao.Checked ? 1 : 2);
                        }
                        else
                        {
                            Xuly5211(TbImport);
                            lstdsRa.Add(TbImport);
                            await SaveDataXmlOne(TbImport, chkDauvao.Checked ? 1 : 2);
                        }

                        stt += 1;
                    }
                }
            }
            catch (Exception ex)
            {
                XtraMessageBox.Show(pathXml);
            }
            sothutu += 1;
        }
        private async Task<TbImport> DocfileXmlOne(string pathXml, int stt)
        {

            if (pathXml.Contains("html"))
                return null;
            if(pathXml== "D:\\DA3\\DA3\\Hoadon\\HDRa\\12\\3502550210_2994_C25MTD.html")
            {
                int kiemtra = 10;
            }
            // Cập nhật trạng thái UI
            type = chkDauvao.Checked ? 1 : 2;
            if (type == 1)
            {
                progressPanel1.Caption = $"Đang đọc file {Path.GetFileName(pathXml)} {sothutu}/{tongfile}";
                Application.DoEvents();
            }
            else
            {
                progressPanel2.Caption = $"Đang đọc file {Path.GetFileName(pathXml)} {sothutu}/{tongfile}";
                Application.DoEvents();
            }
            TbImport tbImport = null;
            try
                {
                    XmlReaderSettings settings = new XmlReaderSettings();
                    settings.DtdProcessing = DtdProcessing.Parse; // Cho phép phân tích DTD
                    settings.XmlResolver = null; // Ngăn chặn việc tải DTD từ bên ngoài để bảo mật và tốc độ
                    settings.Async = true;
                    using (var xmlReader = XmlReader.Create(pathXml, new XmlReaderSettings { Async = true }))
                    {
                        var xmlDoc = new XmlDocument();
                        xmlDoc.Load(xmlReader);
                        XmlNode root = xmlDoc.DocumentElement;
                        if (root == null) return null;

                        // 1. Khai báo các Node cha để tối ưu truy vấn (tránh dùng // liên tục)
                        XmlNode ttChung = root.SelectSingleNode("//TTChung");
                        XmlNode nBan = root.SelectSingleNode("//NBan");
                        XmlNode nMua = root.SelectSingleNode("//NMua");
                        XmlNode ttToan = root.SelectSingleNode("//TToan");
                        XmlNode THDon = root.SelectSingleNode("//THDon");
                    if (ttChung == null || ttToan == null) return null;

                         tbImport = new TbImport { Path = pathXml };


                    if (Helpers.NormalizeVietnameseString(THDon.InnerText.ToLower()).Contains("hóa đơn giá trị gia tăng") || Helpers.NormalizeVietnameseString(THDon.InnerText.ToLower()).Contains("hóa đơn điện tử giá trị gia tăng"))
                    {
                        tbImport.hdon = "01";
                    }
                    if (Helpers.NormalizeVietnameseString(THDon.InnerText.ToLower()).Contains("hóa đơn bán hàng"))
                    {
                        tbImport.hdon = "02";
                    }

                    // 2. Xử lý NLap và nội dung điều chỉnh
                    if (DateTime.TryParse(ttChung.SelectSingleNode("NLap")?.InnerText, out DateTime nLap))
                            tbImport.NLap = nLap;

                        // Kiểm tra trong khoảng ngày
                        if (tbImport.NLap < dtTungay.DateTime || tbImport.NLap > dtDenngay.DateTime) return null;

                        // Nội dung điều chỉnh từ TTKhac
                        var ttKhacNodes = ttChung.SelectNodes("TTKhac/TTin");
                        if (ttKhacNodes != null)
                        {
                            foreach (XmlNode node in ttKhacNodes)
                            {
                                string dLieu = node.SelectSingleNode("DLieu")?.InnerText;
                                if (!string.IsNullOrEmpty(dLieu) && dLieu.IndexOf("điều chỉnh", StringComparison.OrdinalIgnoreCase) >= 0)
                                {
                                    tbImport.Noidung = Helpers.ConvertUnicodeToVni(dLieu);
                                    break;
                                }
                            }
                        }

                        // 3. Thông tin số hóa đơn & Ký hiệu
                        tbImport.SHDon = Helpers.RemoveLeadingZeros(ttChung.SelectSingleNode("SHDon")?.InnerText);
                        tbImport.KHHDon = ttChung.SelectSingleNode("KHHDon")?.InnerText;

                        string TPhi = ttToan.SelectSingleNode("//TPhi")?.InnerText;
                    if (!string.IsNullOrEmpty(TPhi))
                    {
                        tbImport.TPhi = double.Parse(TPhi).ToString() ;
                    }
                        // 4. Phân loại Mua/Bán và Kiểm tra MST công ty
                        if (type == 1) // Hóa đơn đầu vào
                        {
                            if (mstcongty != nMua?.SelectSingleNode("MST")?.InnerText) return null;
                            tbImport.Ten = Helpers.ConvertUnicodeToVni(nBan?.SelectSingleNode("Ten")?.InnerText ?? "");
                            tbImport.Mst = nBan?.SelectSingleNode("MST")?.InnerText ?? "";
                        }
                        else // Hóa đơn đầu ra
                        {
                            if (mstcongty != nBan?.SelectSingleNode("MST")?.InnerText) return null;

                                                string tenDoiTac =
                          !string.IsNullOrWhiteSpace(nMua?.SelectSingleNode("Ten")?.InnerText)
                              ? nMua.SelectSingleNode("Ten").InnerText
                              : nMua?.SelectSingleNode("HVTNMHang")?.InnerText;

                        tbImport.Ten = !string.IsNullOrEmpty(tenDoiTac) ? Helpers.ConvertUnicodeToVni(tenDoiTac) : "";
                            tbImport.Mst = nMua?.SelectSingleNode("MST")?.InnerText ?? nMua?.SelectSingleNode("CCCDan")?.InnerText ?? "";

                            // Xử lý khách lẻ
                            if (string.IsNullOrEmpty(tbImport.Ten) || tbImport.Ten.Contains("khaùch khoâng laáy hoùa ñôn") || tbImport.Ten.Contains("Ngöôøi mua khoâng laáy hoùa ñôn") || tbImport.Ten.Contains("Khaùch leû"))
                            {
                                var kl = tbKhachhang.AsEnumerable().FirstOrDefault(m => m.Field<string>("SoHieu") == "KL");
                                if (kl != null) { tbImport.Ten = kl.Field<string>("Ten"); tbImport.Mst = "KL"; }
                            }
                        }

                    // 5. Tạo Số hiệu tự động nếu không có MST

                    //Kiểm tra tồn tại khách hàng
                    

                    if (string.IsNullOrEmpty(tbImport.Mst) && !string.IsNullOrEmpty(tbImport.Ten))
                    {
                        var existingSoHieus = tbKhachhang.AsEnumerable().Where(m=>m.Field<string>("Ten").ToLower()== tbImport.Ten.ToLower()).Select(r => r.Field<string>("SoHieu")).ToList();
                        if (existingSoHieus == null || existingSoHieus.Count==0)
                        {
                            string sohieuBase = GenerateAbbreviation(Helpers.ConvertVniToUnicode(tbImport.Ten), existingSoHieus).ToUpper();
                            string finalSH = sohieuBase;
                            int suffix = 1;
                            while (tbKhachhang.AsEnumerable().Any(r => r.Field<string>("SoHieu") == finalSH))
                                finalSH = $"{sohieuBase}_{suffix++}";
                            tbImport.Mst = finalSH;
                        }
                        else
                        {
                            tbImport.Mst = existingSoHieus.FirstOrDefault();
                        }

                    }

                    // 6. Kiểm tra trùng hóa đơn (Cache & Database)
                    var currentList = chkDauvao.Checked ? lstdsVao : lstdsRa;
                        var importList = chkDauvao.Checked ? lstImportVao : lstImportRa;
                        if (currentList.Any(m => m.SHDon == tbImport.SHDon && m.NLap.Date == tbImport.NLap.Date && m.Mst == tbImport.Mst)) return null;
                        if (importList.Any(m => m.SHDon == tbImport.SHDon && m.NLap.Date == tbImport.NLap.Date)) return null;
                        if (Kiemtrahoadon(tbImport.SHDon, tbImport.NLap, tbImport.Mst) || KiemtrahoadonCT(tbImport.SHDon, tbImport.NLap, tbImport.Mst)) return null;

                    // 7. Khởi tạo khách hàng mới
                    if (tbImport.Mst != "KL" && !CheckExistKH(tbImport.Mst))
                    {
                        XmlNode doiTacNode = (type == 1) ? nBan : nMua;
                        string dChi = doiTacNode?.SelectSingleNode("DChi")?.InnerText ?? "";
                        string sdt = doiTacNode?.SelectSingleNode("SDThoai")?.InnerText ?? "";
                        if (!string.IsNullOrEmpty(tbImport.Mst) && !string.IsNullOrEmpty(tbImport.Ten) && !CheckExistKH(tbImport.Mst))
                            InitCustomer(type == 1 ? 2 : 3, tbImport.Mst, tbImport.Ten, dChi, tbImport.Mst, "", sdt);
                        else
                        {
                            var kl = tbKhachhang.AsEnumerable().FirstOrDefault(m => m.Field<string>("SoHieu") == "KL");
                            if (kl != null) { tbImport.Ten = kl.Field<string>("Ten"); tbImport.Mst = "KL"; }
                        }
                    }

                    // 8. Định danh tài khoản
                    string kw = chkDauvao.Checked ? "Ưu tiên vào" : "Ưu tiên ra";
                        var authRow = tbDinhDanhtaikhoan.AsEnumerable().FirstOrDefault(r => r.Field<string>("KeyValue")?.Contains(kw) == true);
                        if (authRow != null)
                        {
                            tbImport.TKNo = authRow["TKNo"]?.ToString();
                            tbImport.TKCo = authRow["TKCo"]?.ToString();
                            tbImport.TkThue = authRow["TKThue"]?.ToString();
                        }
                        tbImport.Status = 0;
                        tbImport.Ngaytao = DateTime.Now.ToShortDateString();

                        // 9. Tiền thanh toán và Thuế suất
                        tbImport.TongTien = double.Parse(ttToan.SelectSingleNode("TgTTTBSo")?.InnerText ?? "0");
                        tbImport.TgTCThue = double.Parse(ttToan.SelectSingleNode("TgTCThue")?.InnerText ?? "0");
                        tbImport.TgTThue = double.Parse(ttToan.SelectSingleNode("TgTThue")?.InnerText ?? "0");

                        var thueNodes = ttToan.SelectNodes("THTTLTSuat//LTSuat");
                        if (thueNodes != null)
                        {
                            for (int i = 0; i < Math.Min(thueNodes.Count, 3); i++)
                            {
                                XmlNode n = thueNodes[i];
                                string tsStr = n.SelectSingleNode("TSuat")?.InnerText ?? "";
                                double ttien = double.Parse(n.SelectSingleNode("ThTien")?.InnerText ?? "0");
                                double tthue = double.Parse(n.SelectSingleNode("TThue")?.InnerText ?? "0");
                                double vVal = (tsStr == "KCT" || tsStr == "KKKNT") ? 0 : double.Parse(tsStr.Replace("%", ""));

                                if (i == 0) { tbImport.TgTCThue1 = ttien; tbImport.TVat = tthue; tbImport.Vat = vVal; }
                                else if (i == 1) { tbImport.TgTCThue2 = ttien; tbImport.TVat2 = tthue; tbImport.Vat2 = vVal.ToString(); }
                                else if (i == 2) { tbImport.TgTCThue3 = ttien; tbImport.TVat3 = tthue; tbImport.Vat3 = vVal.ToString(); }
                            }
                        }
                    //Xử lý dong thuế thưa
                    if (tbImport.Vat2 != "0" && !string.IsNullOrEmpty(tbImport.Vat2) && tbImport.Vat == 0)
                    {
                        tbImport.Vat = double.Parse(tbImport.Vat2);
                        tbImport.TVat = tbImport.TVat2;
                        tbImport.Vat2 = "0";
                        tbImport.TVat2 = 0;
                    }
                    // 10. Loại hóa đơn (01: GTGT, 02: Bán hàng)
                    tbImport.Khmshdon = root.SelectSingleNode("//KHMSHDon")?.InnerText;
                        string thDon = Helpers.NormalizeVietnameseString(root.SelectSingleNode("//THDon")?.InnerText?.ToLower() ?? "");
                         //      tbImport.hdon = thDon.Contains("ban hang") ? "02" : "01";

                        // 11. Chi tiết hàng hóa (HHDVu)
                        var hhdNodes = root.SelectNodes("//HHDVu");
                        cacheMatHangTrongHoaDon = new Dictionary<string, TbImportDetail>(StringComparer.OrdinalIgnoreCase);
                         double finalTotal = 0;
                        foreach (XmlNode node in hhdNodes)
                        {
                            string ten = "";
                            try
                            {
                                string tenGoc = node.SelectSingleNode("THHDVu")?.InnerText;
                                ten = tenGoc;
                                if (ten == "BỘT CHIÊN GIÒN ĐỎ 150GX48 GÓI")
                                {
                                    int test = 10;
                                }
                                if (Loaiborow(tenGoc)) continue;

                                int tchat = int.Parse(node.SelectSingleNode("TChat")?.InnerText ?? "0");
                                bool daGiam = tenGoc.Contains("Đã giảm");
                                if (tchat == 4 && !daGiam) continue;

                            TbImportDetail dt = new TbImportDetail
                            {
                                Tchat = tchat,
                                Ten = tenGoc,
                                TKNo = tbImport.TKNo,
                                TKCo = tbImport.TKCo,
                                // Thêm kiểm tra null cho DVTinh
                                DVT = CapitalizeFirstLetter(Helpers.ConvertUnicodeToVni(node.SelectSingleNode("DVTinh")?.InnerText ?? "")),
                                // Sử dụng SafeParse để không bao giờ bị văng lỗi
                                Soluong = SafeParse(node.SelectSingleNode("SLuong")?.InnerText),
                                Dongia = SafeParse(node.SelectSingleNode("DGia")?.InnerText),
                                TTien = SafeParse(node.SelectSingleNode("ThTien")?.InnerText)
                            };
                            finalTotal += dt.TTien;
                            if (daGiam)
                                {
                                    Match m = Regex.Match(tenGoc, @"\d{1,3}(?:\.\d{3})*(?:,\d+)?");
                                    if (m.Success) dt.TTien = double.Parse(m.Value.Replace(".", ""));
                                }

                                // Fuzzy Match & Cache
                                string keyCache = NormalizeVietnameseString(dt.Ten);
                                if (cacheMatHangTrongHoaDon.TryGetValue(keyCache, out var cached))
                                {
                                    dt.SoHieu = cached.SoHieu; dt.Percent = cached.Percent;
                                }
                                else
                                {
                                    Xulysohieuvattu(dt);
                                    cacheMatHangTrongHoaDon[keyCache] = dt;
                                }

                                if (chkDauvao.Checked && (tchat == 3 || daGiam)) dt.TKCo = "711";
                                dt.Ten = Helpers.ConvertUnicodeToVni(dt.Ten);
                                dt.Percent = Math.Round(dt.Percent);
                                tbImport.tbImportDetails.Add(dt);
                            }
                            catch (Exception ex)
                            {
                                XtraMessageBox.Show(ten);
                            }

                        }
                    //Tiến hành làm tròn và phân bổ thằng cuối cùng
                    foreach (var lt in tbImport.tbImportDetails)
                    {
                        lt.TTien = Math.Round(lt.TTien);
                    }
                    double sodu = Math.Round(finalTotal) - tbImport.tbImportDetails.Sum(m => m.TTien);
                    if (sodu > 0 && sodu <= 1)
                    {
                        tbImport.tbImportDetails.LastOrDefault().TTien += sodu;
                    }
                       

                    //Thưc hiện thiếu tiền so với trc thuế
                    if(tbImport.TgTCThue!= finalTotal)
                    {
                        sodu = tbImport.TgTCThue - finalTotal;
                        if(sodu>0 && sodu <= 1)
                        {
                            tbImport.tbImportDetails.LastOrDefault().TTien += sodu;
                            if (tbImport.TgTCThue1 + sodu == tbImport.TgTCThue)
                            {
                                tbImport.TgTCThue1 += sodu;
                            }
                        }
                    }
                    // 12. Hoàn tất & Lưu
                    if (string.IsNullOrEmpty(tbImport.Noidung) && tbImport.tbImportDetails.Count > 0)
                            tbImport.Noidung = tbImport.tbImportDetails[0].Ten;

                        if (chkDauvao.Checked) { Xuly711(tbImport); }
                        else { Xuly5211(tbImport); }
                  
                    //await SaveDataXmlOne(tbImport, type);
                    stt++;
                    }
                }
                catch (Exception ex) { XtraMessageBox.Show($"Lỗi xử lý file {pathXml}: {ex.Message}"); }
                finally { sothutu++; }
            return tbImport;
        }
        public static double SafeParse(string value)
        {
            if (string.IsNullOrWhiteSpace(value)) return 0;
            // Thay thế dấu phẩy thành dấu chấm để đồng nhất định dạng chuẩn C#
            value = value.Replace(",", ".");
            if (double.TryParse(value, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out double result))
            {
                return result;
            }
            return 0;
        }
        private async Task DocfileXmlOne1(string pathXml,int stt)
        {
            if(pathXml== "D:\\DA3\\DA3\\Hoadon\\HDRa\\12\\3502550210_3001_C25MTD.xml")
            {
                int test = 10;
            }
            type = chkDauvao.Checked ? 1 : 2;
            try
            {
                using (StreamReader reader = new StreamReader(pathXml, Encoding.UTF8,true))
                {

                    try
                    {
                        xmlDoc.Load(reader); // Tải file XML
                    }
                    catch (XmlException ex)
                    {
                        Console.WriteLine($"Lỗi khi tải file XML: {ex.Message}");
                        return;
                    }
                    TbImport TbImport = new TbImport();
                    XmlNode root = xmlDoc.DocumentElement;
                    XmlNode TTChung = root.SelectSingleNode("//TTChung");
                    DateTime NLap = DateTime.Parse(TTChung.SelectSingleNode("NLap")?.InnerText);
                    TbImport.NLap = NLap;

                    //Kiểm tra điều chỉnh
                    XmlNodeList TTKhac = root.SelectNodes("//TTChung//TTKhac//TTin");
                    foreach (XmlNode node in TTKhac)
                    {
                        var tt = node.SelectSingleNode("DLieu")?.InnerText;
                        if(tt.ToLower().Contains("điều chỉnh"))
                        {
                            int dc = 10;
                            TbImport.Noidung = Helpers.ConvertUnicodeToVni(tt);
                        }
                    }
                        //Kiểm tra lấy trong ngày
                        if (NLap >= dtTungay.DateTime && NLap <= dtDenngay.DateTime)
                    {
                       
                        TbImport.SHDon = Helpers.RemoveLeadingZeros(TTChung.SelectSingleNode("SHDon")?.InnerText);
                        if (TbImport.SHDon == "6015")
                        {
                            int test = 10;
                        }
                        TbImport.KHHDon = TTChung.SelectSingleNode("KHHDon")?.InnerText;
                        TbImport.Path = pathXml;
                        if (type == 1)
                        {
                            TbImport.Ten = Helpers.ConvertUnicodeToVni(root.SelectSingleNode("//NBan//Ten").InnerText);
                            TbImport.Mst = root.SelectSingleNode("//NBan//MST").InnerText;
                            //Kiểm tra file xml hợp lệ thuộc công ty
                            string mstnguoimua = root.SelectSingleNode("//NMua//MST").InnerText;
                            if (mstcongty != mstnguoimua)
                                return;

                        }
                        else
                        {
                            //Kiểm tra file xml hợp lệ thuộc công ty
                            string mstnguoiban = root.SelectSingleNode("//NBan//MST").InnerText;
                            if (mstcongty != mstnguoiban)
                                return;



                            TbImport.Mst = root.SelectSingleNode("//NMua//MST") != null ? root.SelectSingleNode("//NMua//MST").InnerText : "";
                            //Kiểm tra tên KH
                            if (root.SelectSingleNode("//NMua//Ten") != null)
                            {
                                TbImport.Ten = Helpers.ConvertUnicodeToVni(root.SelectSingleNode("//NMua//Ten").InnerText);
                            }
                            //Trường hợp không có tên thì lấy khách lẻ
                            else
                            {
                                if (root.SelectSingleNode("//NMua//HVTNMHang") != null)
                                {
                                    TbImport.Ten = Helpers.ConvertUnicodeToVni(root.SelectSingleNode("//NMua//HVTNMHang").InnerText);
                                }
                                if (TbImport.Ten == "Baùn leû khaùch khoâng laáy hoùa ñôn" || string.IsNullOrEmpty(TbImport.Ten) || TbImport.Ten == "Ngöôøi mua khoâng laáy hoùa ñôn")
                                {
                                    //Tìm khách lẻ
                                    var findKL = tbKhachhang.AsEnumerable().Where(m => m.Field<string>("SoHieu") == "KL").FirstOrDefault();
                                    if (findKL != null)
                                    {
                                        TbImport.Ten = findKL.Field<string>("Ten");
                                        TbImport.Mst = findKL.Field<string>("SoHieu");
                                    }
                                }
                            }
                        }
                        //Nếu không có MST thì thay thế = CCCD
                        string Sohieu = "";
                        if (string.IsNullOrEmpty(TbImport.Mst))
                        {
                            if (root.SelectSingleNode("//NMua//CCCDan") != null)
                            {
                                TbImport.Mst = root.SelectSingleNode("//NMua//CCCDan") != null ? root.SelectSingleNode("//NMua//CCCDan").InnerText : "";
                            }
                            if (string.IsNullOrEmpty(TbImport.Mst))
                            {
                                //Nếu không có MST, CCCD thì kiểm tra tên

                                if (!string.IsNullOrEmpty(TbImport.Ten))
                                {
                                    //Kiểm tra tên có trùng chưa
                                    var findcus = tbKhachhang.AsEnumerable().Where(m => m.Field<string>("Ten") == TbImport.Ten).FirstOrDefault();
                                    if (findcus == null)
                                    {
                                        Sohieu = GenerateAbbreviation(Helpers.ConvertVniToUnicode(TbImport.Ten), tbKhachhang.AsEnumerable().Select(row => row.Field<string>("SoHieu")).ToList()).ToUpper();
                                        //Xử lý khi số hiệu bị trùng
                                        int suffix = 1;
                                        string originalSohieu = Sohieu;

                                        while (tbKhachhang.AsEnumerable().Any(row => row.Field<string>("SoHieu") == Sohieu))
                                        {
                                            Sohieu = $"{originalSohieu}_{suffix}";
                                            suffix++;
                                        }
                                        TbImport.Mst = Sohieu;
                                    }
                                    else
                                    {
                                        TbImport.Mst = findcus.Field<string>("SoHieu");
                                    }
                                }
                                else
                                {
                                    var findKL = tbKhachhang.AsEnumerable().Where(m => m.Field<string>("SoHieu") == "KL").FirstOrDefault();
                                    if (findKL != null)
                                    {
                                        TbImport.Ten = findKL.Field<string>("Ten");
                                        TbImport.Mst = findKL.Field<string>("SoHieu");
                                    }
                                }


                            }
                        }


                        //Chặn hoá đơn dc tải từ bước tải cơ quan thuế
                        if (chkDauvao.Checked)
                        {
                            if (lstdsVao.Any(m => m.SHDon == TbImport.SHDon && m.NLap.Date == TbImport.NLap.Date && m.Mst == TbImport.Mst))
                                return;
                        }
                        else
                        {
                            if (lstdsRa.Any(m => m.SHDon == TbImport.SHDon && m.NLap.Date == TbImport.NLap.Date && m.Mst == TbImport.Mst))
                                return;
                        }
                        //Kiểm tra hoá đon 
                        if (Kiemtrahoadon(TbImport.SHDon, TbImport.NLap, TbImport.Mst))
                            return;
                        if (KiemtrahoadonCT(TbImport.SHDon, TbImport.NLap, TbImport.Mst))
                            return;

                        //if (chkDauvao.Checked)
                        //{
                        //    progressPanel1.Caption = $"Đang đọc file {stt}";
                        //    Application.DoEvents();
                        //}
                        //else
                        //{
                        //    progressPanel2.Caption = $"Đang đọc file {stt}";
                        //    Application.DoEvents();
                        //}
                        //Kiểm tra khách hàng có tạo chưa

                        if (TbImport.Mst != "KL")
                        {
                            if (CheckExistKH(TbImport.Mst) == false)
                            {
                                int maphanloai = 0;
                                maphanloai = type == 1 ? 2 : 3; //1 là mua, 2 là bán  
                                string diachi = "";
                                if (type == 1)
                                    diachi = root.SelectSingleNode("//NBan//DChi") != null ? root.SelectSingleNode("//NBan//DChi").InnerText : "";
                                else
                                    diachi = root.SelectSingleNode("//NMua//DChi") != null ? root.SelectSingleNode("//NMua//DChi").InnerText : "";

                                string sdt = "";
                                if (type == 1)
                                    sdt = root.SelectSingleNode("//NBan//SDThoai") != null ? root.SelectSingleNode("//NBan//SDThoai").InnerText : "";
                                else
                                    sdt = root.SelectSingleNode("//NMua//SDThoai") != null ? root.SelectSingleNode("//NMua//SDThoai").InnerText : "";
                                InitCustomer(maphanloai, Sohieu, TbImport.Ten, diachi, TbImport.Mst, "", sdt);
                            }
                        }
                        //Kiểm tra có tạo chưa
                        if (chkDauvao.Checked)
                        {
                            if (lstImportVao.Any(m => m.SHDon == TbImport.SHDon && m.NLap.Date == NLap.Date))
                            {
                                return;
                            }
                        }
                        else
                        {
                            if (lstImportRa.Any(m => m.SHDon == TbImport.SHDon && m.NLap.Date == NLap.Date))
                            {
                                return;
                            }
                        }


                        //Load mặc định
                        if (tbDinhDanhtaikhoan.Rows.Count > 0)
                        {
                            string keyword = chkDauvao.Checked ? "Ưu tiên vào" : "Ưu tiên ra";

                            if (keyword != null)
                            {
                                DataRow foundRow = tbDinhDanhtaikhoan.AsEnumerable()
                                    .FirstOrDefault(row => row.Field<string>("KeyValue")?.Contains(keyword) == true);

                                if (foundRow != null)
                                {
                                    TbImport.TKNo = foundRow["TKNo"].ToString();
                                    TbImport.TKCo = foundRow["TKCo"].ToString();
                                    TbImport.TkThue = foundRow["TKThue"].ToString();
                                }
                            }
                        }
                        TbImport.Status = 0;
                        TbImport.Ngaytao = DateTime.Now.ToShortDateString();


                        //Thông tin thanh toán
                        TbImport.TongTien = double.Parse(root.SelectSingleNode("//TgTTTBSo").InnerText);
                        TbImport.TgTCThue = root.SelectSingleNode("//TgTCThue") != null ? double.Parse(root.SelectSingleNode("//TgTCThue").InnerText) : 0;
                        TbImport.TgTThue = root.SelectSingleNode("//TgTThue") != null ? double.Parse(root.SelectSingleNode("//TgTThue").InnerText) : 0;
                        // TbImport.Vat = double.Parse(root.SelectSingleNode("//TSuat").InnerText.Replace("%",""));
                        //
                        XmlNodeList nodeList = xmlDoc.SelectNodes("//LTSuat");
                        int index = 0;
                        foreach (XmlNode node in nodeList)
                        {
                            var suat = new SuatThue
                            {
                                TSuat = node.SelectSingleNode("TSuat")?.InnerText,
                                ThTien = double.Parse(node.SelectSingleNode("ThTien")?.InnerText ?? "0"),
                                TThue = double.Parse(node.SelectSingleNode("TThue")?.InnerText ?? "0")
                            };
                            if (suat != null)
                            {
                                if (!string.IsNullOrEmpty(suat.TSuat))
                                {
                                    if (index == 0)
                                    {
                                        TbImport.TgTCThue1 = suat.ThTien;
                                        TbImport.TVat = suat.TThue;

                                        //KKKNT KCT
                                        if (suat.TSuat == "KCT" || suat.TSuat == "KKKNT")
                                        {
                                            TbImport.Vat = 0;
                                        }
                                        else
                                        {
                                            TbImport.Vat = double.Parse(suat.TSuat.Replace("%", ""));
                                        }
                                    }
                                    if (index == 1)
                                    {
                                        TbImport.TgTCThue2 = suat.ThTien;
                                        TbImport.TVat2 = suat.TThue;
                                        if (suat.TSuat == "KCT" || suat.TSuat == "KKKNT")
                                        {
                                            TbImport.Vat2 = "0";
                                        }
                                        else
                                        {
                                            TbImport.Vat2 = suat.TSuat.Replace("%", "");
                                        }
                                    }
                                    if (index == 2)
                                    {
                                        TbImport.TgTCThue3 = suat.ThTien;
                                        TbImport.TVat3 = suat.TThue;

                                        if (suat.TSuat == "KCT" || suat.TSuat == "KKKNT")
                                        {
                                            TbImport.Vat3 = "0";
                                        }
                                        else
                                        {
                                            TbImport.Vat3 = suat.TSuat.Replace("%", "");
                                        }
                                    }
                                }
                            }
                            index += 1;
                        }



                        //Trường hợp không chịu thuế
                        //if (vat == "KCT" || vat == "KKKNT")
                        //{
                        //    vat = "0";
                        //}

                        //KHMSHDon
                        TbImport.Khmshdon = root.SelectSingleNode("//KHMSHDon").InnerText;
                        string THDon = root.SelectSingleNode("//THDon").InnerText;
                         TbImport.hdon = "01";
                        if (Helpers.NormalizeVietnameseString(THDon.ToLower()).Contains("hóa đơn giá trị gia tăng") || Helpers.NormalizeVietnameseString(THDon.ToLower()).Contains("hóa đơn điện tử giá trị gia tăng"))
                        {
                            TbImport.hdon = "01";
                        }
                        if(Helpers.NormalizeVietnameseString(THDon.ToLower()).Contains("hóa đơn bán hàng"))
                        {
                            TbImport.hdon = "02";
                        }
                        XmlNodeList nodeListHHDVu = xmlDoc.SelectNodes("//HHDVu");
                        cacheMatHangTrongHoaDon = new Dictionary<string, TbImportDetail>(StringComparer.OrdinalIgnoreCase);

                        foreach (XmlNode node in nodeListHHDVu)
                        {
                            try
                            {
                                if (node.SelectSingleNode("THHDVu")?.InnerText == "Mì Cung Đình Koolspaghetti thố khuyến mãi")
                                {
                                    int tets = 10;
                                }
                                TbImportDetail tbImportDetail = new TbImportDetail();
                                if (Loaiborow(node.SelectSingleNode("THHDVu")?.InnerText))
                                    continue;
                                tbImportDetail.Tchat = int.Parse(node.SelectSingleNode("TChat")?.InnerText);
                                tbImportDetail.Ten = node.SelectSingleNode("THHDVu")?.InnerText;
                                bool dagiam = false;
                                if (tbImportDetail.Ten.Contains("Đã giảm"))
                                {
                                    dagiam = true;
                                    string pattern = @"\d{1,3}(?:\.\d{3})*(?:,\d+)?"; // Hỗ trợ cả định dạng số với dấu phẩy và dấu chấm
                                    Match match = Regex.Match(tbImportDetail.Ten, pattern);

                                    if (match.Success)
                                    {
                                        tbImportDetail.TTien = double.Parse(match.Value.Replace(".", ""));
                                    }
                                }
                                //Loại bỏ
                                if (tbImportDetail.Tchat == 4 && dagiam == false)
                                    continue;

                                var dvtNode = node.SelectSingleNode("DVTinh");
                                tbImportDetail.DVT = CapitalizeFirstLetter(
                                    Helpers.ConvertUnicodeToVni(dvtNode?.InnerText));

                                var slNode = node.SelectSingleNode("SLuong");
                                tbImportDetail.Soluong = slNode != null && double.TryParse(slNode.InnerText, out var qty) ? qty : 0;

                                var nodeGia = node.SelectSingleNode("DGia");
                                tbImportDetail.Dongia = nodeGia != null && double.TryParse(nodeGia.InnerText, out double value) ? value : 0;
                                if (tbImportDetail.TTien == 0)
                                    tbImportDetail.TTien = node.SelectSingleNode("ThTien") != null ? double.Parse(node.SelectSingleNode("ThTien")?.InnerText) : 0;


                                // —————— SIÊU TỐI ƯU TẠI ĐÂY (thay toàn bộ đoạn cũ) ——————
                                string keyCache = NormalizeVietnameseString(tbImportDetail.Ten); // dùng hàm chuẩn hóa của bạn
                                if (node.SelectSingleNode("THHDVu")?.InnerText == "Xăng RON 95 Mức 3")
                                {
                                    int a = 10;
                                }
                                if (cacheMatHangTrongHoaDon.TryGetValue(keyCache, out TbImportDetail daXuLy))
                                {
                                    // Đã xử lý rồi → copy kết quả
                                    tbImportDetail.SoHieu = daXuLy.SoHieu;
                                    tbImportDetail.Percent = daXuLy.Percent;
                                }
                                else
                                {
                                    // Chưa xử lý → gọi hàm gán mã (chỉ chạy 1 lần!)
                                    Xulysohieuvattu(tbImportDetail);

                                    // Lưu vào cache
                                    cacheMatHangTrongHoaDon[keyCache] = tbImportDetail;
                                }

                                //Kiem tra xem sản phẩm này đã xử lý chưa
                                //var checkExist = TbImport.tbImportDetails.Where(m => m.Ten == tbImportDetail.Ten).FirstOrDefault();
                                //if (checkExist == null)
                                //    Xulysohieuvattu(tbImportDetail);
                                //else
                                //{
                                //    tbImportDetail.SoHieu = checkExist.SoHieu;
                                //    tbImportDetail.Percent = checkExist.Percent;
                                //}
                                //Chuyển lại unicode sang vni cho tên
                                tbImportDetail.Ten = Helpers.ConvertUnicodeToVni(tbImportDetail.Ten);

                                //Điền tk nợ có
                                tbImportDetail.TKNo = TbImport.TKNo;
                                tbImportDetail.TKCo = TbImport.TKCo;
                                if (chkDauvao.Checked)
                                {
                                    if (tbImportDetail.Tchat == 3 || dagiam == true)
                                    {
                                        tbImportDetail.TKCo = "711";
                                    }
                                }
                                tbImportDetail.Percent = Math.Round(double.Parse(tbImportDetail.Percent.ToString()));
                                TbImport.tbImportDetails.Add(tbImportDetail);
                            }
                            catch (Exception ex)
                            {
                                XtraMessageBox.Show(node.SelectSingleNode("THHDVu")?.InnerText + "   " + TbImport.SHDon);
                            }

                        }

                        //Cập nhật nội dung cho Parent
                        if (string.IsNullOrEmpty(TbImport.Noidung))
                        {
                            if (TbImport.tbImportDetails.Count > 0)
                            {
                                TbImport.Noidung = TbImport.tbImportDetails.FirstOrDefault().Ten;
                            }

                        }

                        if (chkDauvao.Checked)
                        {
                            Xuly711(TbImport);
                            lstdsVao.Add(TbImport);
                            await SaveDataXmlOne(TbImport, chkDauvao.Checked ? 1 : 2);
                        }
                        else
                        {
                            //Xử lý 5211 trước
                            Xuly5211(TbImport);
                            lstdsRa.Add(TbImport);
                            await SaveDataXmlOne(TbImport, chkDauvao.Checked ? 1 : 2);
                        }

                        //Load chi tiết
                        stt += 1;
                    }
                }
            }
            catch (Exception ex)
            {
                XtraMessageBox.Show(pathXml);
            }
        }
        private async Task DocfileXmlOne2(string pathXml, int stt)
        {
            if (string.IsNullOrEmpty(pathXml)) return;

            string type = chkDauvao.Checked ? "1" : "2";
            TbImport tbImport = new TbImport { Type = type, Path = pathXml };

            try
            {
                // Sử dụng XmlReader để đọc nhanh, stream
                using (var reader = XmlReader.Create(pathXml, new XmlReaderSettings { IgnoreWhitespace = true }))
                {
                    // Cache các giá trị quan trọng
                    string nLapStr = null, shDon = null, khhDon = null, mstNban = null, mstNmua = null;
                    string tenNban = null, tenNmua = null, hvtNmua = null, cccd = null;
                    string tongTien = null, tgTCThue = null, tgTThue = null;
                    string khmshdon = null, thDon = null;
                    string noiDungDC = null;

                    var listSuatThue = new List<SuatThue>();
                    var listHHDVu = new List<HHDVuInfo>();

                    while (reader.Read())
                    {
                        if (reader.NodeType != XmlNodeType.Element) continue;

                        string localName = reader.LocalName;

                        if (localName == "NLap")
                        {
                            nLapStr = reader.ReadElementContentAsString();
                            tbImport.NLap = DateTime.Parse(nLapStr);
                        }
                        else if (localName == "SHDon")
                        {
                            shDon = reader.ReadElementContentAsString();
                            tbImport.SHDon = Helpers.RemoveLeadingZeros(shDon);
                        }
                        else if (localName == "KHHDon")
                        {
                            tbImport.KHHDon = reader.ReadElementContentAsString();
                        }
                        else if (localName == "MST")
                        {
                            string id = reader.GetAttribute("id");
                            if (id == "NBan") mstNban = reader.ReadElementContentAsString();
                            else if (id == "NMua") mstNmua = reader.ReadElementContentAsString();
                        }
                        else if (localName == "Ten")
                        {
                            string id = reader.GetAttribute("id");
                            if (id == "NBan") tenNban = reader.ReadElementContentAsString();
                            else if (id == "NMua") tenNmua = reader.ReadElementContentAsString();
                        }
                        else if (localName == "HVTNMHang")
                        {
                            hvtNmua = reader.ReadElementContentAsString();
                        }
                        else if (localName == "CCCDan")
                        {
                            cccd = reader.ReadElementContentAsString();
                        }
                        else if (localName == "TgTTTBSo")
                        {
                            tongTien = reader.ReadElementContentAsString();
                            tbImport.TongTien = double.Parse(tongTien);
                        }
                        else if (localName == "TgTCThue")
                        {
                            tgTCThue = reader.ReadElementContentAsString();
                            tbImport.TgTCThue = double.Parse(tgTCThue);
                        }
                        else if (localName == "TgTThue")
                        {
                            tgTThue = reader.ReadElementContentAsString();
                            tbImport.TgTThue = double.Parse(tgTThue);
                        }
                        else if (localName == "KHMSHDon")
                        {
                            tbImport.Khmshdon = reader.ReadElementContentAsString();
                        }
                        else if (localName == "THDon")
                        {
                            thDon = reader.ReadElementContentAsString();
                        }
                        else if (localName == "DLieu" && reader.ReadElementContentAsString().ToLower().Contains("điều chỉnh"))
                        {
                            noiDungDC = reader.ReadElementContentAsString();
                            tbImport.Noidung = Helpers.ConvertUnicodeToVni(noiDungDC);
                        }
                        // Suất thuế (giả sử cấu trúc LTSuat)
                        else if (localName == "TSuat" && reader.Depth == 4) // Trong LTSuat
                        {
                            string tSuat = reader.ReadElementContentAsString();
                            reader.ReadToNextSibling("ThTien");
                            double thTien = double.TryParse(reader.ReadElementContentAsString(), out double tt) ? tt : 0;
                            reader.ReadToNextSibling("TThue");
                            double tThue = double.TryParse(reader.ReadElementContentAsString(), out double tt2) ? tt2 : 0;
                            listSuatThue.Add(new SuatThue { TSuat = tSuat, ThTien = thTien, TThue = tThue });
                        }
                        // Hàng hóa dịch vụ
                        else if (localName == "HHDVu")
                        {
                            var hh = new HHDVuInfo();
                            while (reader.Read() && !(reader.NodeType == XmlNodeType.EndElement && reader.LocalName == "HHDVu"))
                            {
                                if (reader.NodeType != XmlNodeType.Element) continue;
                                string name = reader.LocalName;
                                if (name == "THHDVu") hh.Ten = reader.ReadElementContentAsString();
                                else if (name == "TChat") hh.TChat = int.Parse(reader.ReadElementContentAsString() ?? "0");
                                else if (name == "DVTinh") hh.DVT = reader.ReadElementContentAsString();
                                else if (name == "SLuong") hh.SoLuong = double.TryParse(reader.ReadElementContentAsString(), out double sl) ? sl : 0;
                                else if (name == "DGia") hh.DonGia = double.TryParse(reader.ReadElementContentAsString(), out double dg) ? dg : 0;
                                else if (name == "ThTien") hh.ThTien = double.TryParse(reader.ReadElementContentAsString() ?? "0", out double tt) ? tt : 0;
                            }
                            if (!string.IsNullOrEmpty(hh.Ten)) listHHDVu.Add(hh);
                        }
                    }

                    // Kiểm tra ngày sớm nhất
                    if (tbImport.NLap < dtTungay.DateTime || tbImport.NLap > dtDenngay.DateTime)
                        return;

                    // Kiểm tra trùng (dùng List.Any thay vì LINQ phức tạp)
                    var checkList = chkDauvao.Checked ? lstdsVao : lstdsRa;
                    if (checkList.Any(m => string.Equals(m.SHDon, tbImport.SHDon) && m.NLap.Date == tbImport.NLap.Date && string.Equals(m.Mst, tbImport.Mst)))
                        return;

                    if (Kiemtrahoadon(tbImport.SHDon, tbImport.NLap, tbImport.Mst) || KiemtrahoadonCT(tbImport.SHDon, tbImport.NLap, tbImport.Mst))
                        return;

                    // Xử lý MST/Tên KH
                    if (type == "1") // Đầu vào
                    {
                        if (!string.Equals(mstcongty, mstNmua)) return;
                        tbImport.Ten = Helpers.ConvertUnicodeToVni(tenNban ?? "");
                        tbImport.Mst = mstNban ?? "";
                    }
                    else // Đầu ra
                    {
                        if (!string.Equals(mstcongty, mstNban)) return;
                        tbImport.Mst = mstNmua ?? "";
                        tbImport.Ten = !string.IsNullOrEmpty(tenNmua)
                            ? Helpers.ConvertUnicodeToVni(tenNmua)
                            : Helpers.ConvertUnicodeToVni(hvtNmua ?? "");

                        if (string.IsNullOrEmpty(tbImport.Ten) ||
                            tbImport.Ten.IndexOf("khách lẻ", StringComparison.OrdinalIgnoreCase) >= 0 ||
                            tbImport.Ten.IndexOf("không lấy hóa đơn", StringComparison.OrdinalIgnoreCase) >= 0)
                        {
                            foreach (DataRow row in tbKhachhang.Rows)
                            {
                                if (string.Equals(row["SoHieu"] as string, "KL"))
                                {
                                    tbImport.Ten = row["Ten"] as string;
                                    tbImport.Mst = row["SoHieu"] as string;
                                    break;
                                }
                            }
                        }
                    }

                    // Xử lý MST rỗng
                    if (string.IsNullOrEmpty(tbImport.Mst))
                    {
                        tbImport.Mst = cccd ?? "";
                        if (string.IsNullOrEmpty(tbImport.Mst) && !string.IsNullOrEmpty(tbImport.Ten))
                        {
                            bool found = false;
                            foreach (DataRow row in tbKhachhang.Rows)
                            {
                                if (string.Equals(row["Ten"] as string, tbImport.Ten))
                                {
                                    tbImport.Mst = row["SoHieu"] as string;
                                    found = true;
                                    break;
                                }
                            }
                            if (!found)
                            {
                                string baseCode = GenerateAbbreviation(Helpers.ConvertVniToUnicode(tbImport.Ten), tbKhachhang.AsEnumerable().Select(r => r.Field<string>("SoHieu")).ToList()).ToUpper();
                                string finalCode = baseCode;
                                int suffix = 1;
                                while (tbKhachhang.AsEnumerable().Any(r => string.Equals(r.Field<string>("SoHieu"), finalCode)))
                                    finalCode = baseCode + "_" + suffix++;
                                tbImport.Mst = finalCode;
                            }
                        }
                    }

                    // Loại hóa đơn
                    string thDonNorm = Helpers.NormalizeVietnameseString(thDon?.ToLower() ?? "");
                    if (thDonNorm.Contains("giá trị gia tăng"))
                        tbImport.hdon = "01";
                    else if (thDonNorm.Contains("bán hàng"))
                        tbImport.hdon = "02";
                    else
                        tbImport.hdon = "01";

                    // Suất thuế
                    for (int i = 0; i < listSuatThue.Count && i < 3; i++)
                    {
                        var s = listSuatThue[i];
                        if (i == 0)
                        {
                            tbImport.TgTCThue1 = s.ThTien;
                            tbImport.TVat = s.TThue;
                            tbImport.Vat = (s.TSuat == "KCT" || s.TSuat == "KKKNT") ? 0 : double.Parse(s.TSuat.Replace("%", ""));
                        }
                        else if (i == 1)
                        {
                            tbImport.TgTCThue2 = s.ThTien;
                            tbImport.TVat2 = s.TThue;
                            tbImport.Vat2 = (s.TSuat == "KCT" || s.TSuat == "KKKNT") ? "0" : s.TSuat.Replace("%", "");
                        }
                        else if (i == 2)
                        {
                            tbImport.TgTCThue3 = s.ThTien;
                            tbImport.TVat3 = s.TThue;
                            tbImport.Vat3 = (s.TSuat == "KCT" || s.TSuat == "KKKNT") ? "0" : s.TSuat.Replace("%", "");
                        }
                    }

                    // Tài khoản mặc định
                    if (tbDinhDanhtaikhoan.Rows.Count > 0)
                    {
                        string keyword = chkDauvao.Checked ? "Ưu tiên vào" : "Ưu tiên ra";
                        foreach (DataRow row in tbDinhDanhtaikhoan.Rows)
                        {
                            string key = row["KeyValue"] as string;
                            if (key != null && key.IndexOf(keyword) >= 0)
                            {
                                tbImport.TKNo = row["TKNo"].ToString();
                                tbImport.TKCo = row["TKCo"].ToString();
                                tbImport.TkThue = row["TKThue"].ToString();
                                break;
                            }
                        }
                    }

                    tbImport.Status = 0;
                    tbImport.Ngaytao = DateTime.Now.ToShortDateString();

                    // Cache vật tư trong hóa đơn
                    var cacheMatHang = new Dictionary<string, TbImportDetail>(StringComparer.OrdinalIgnoreCase);

                    foreach (var hh in listHHDVu)
                    {
                        if (Loaiborow(hh.Ten)) continue;

                        var detail = new TbImportDetail
                        {
                            Tchat = hh.TChat,
                            Ten = hh.Ten,
                            DVT = CapitalizeFirstLetter(Helpers.ConvertUnicodeToVni(hh.DVT)),
                            Soluong = hh.SoLuong,
                            Dongia = hh.DonGia,
                            TTien = hh.ThTien
                        };

                        bool daGiam = detail.Ten.IndexOf("Đã giảm") >= 0;
                        if (daGiam && detail.TTien == 0)
                        {
                            var match = Regex.Match(detail.Ten, @"\d{1,3}(?:\.\d{3})*(?:,\d+)?");
                            if (match.Success)
                                detail.TTien = double.Parse(match.Value.Replace(".", "").Replace(",", ""));
                        }

                        if (detail.Tchat == 4 && !daGiam) continue;

                        string cacheKey = Helpers.NormalizeVietnameseString(detail.Ten);
                        if (cacheMatHang.TryGetValue(cacheKey, out var cached))
                        {
                            detail.SoHieu = cached.SoHieu;
                            detail.Percent = cached.Percent;
                        }
                        else
                        {
                            Xulysohieuvattu(detail);
                            cacheMatHang[cacheKey] = detail;
                        }

                        detail.Ten = Helpers.ConvertUnicodeToVni(detail.Ten);
                        detail.TKNo = tbImport.TKNo;
                        detail.TKCo = tbImport.TKCo;

                        if (chkDauvao.Checked && (detail.Tchat == 3 || daGiam))
                            detail.TKCo = "711";

                        detail.Percent = Math.Round(detail.Percent);

                        tbImport.tbImportDetails.Add(detail);
                    }

                    // Nội dung mặc định
                    if (string.IsNullOrEmpty(tbImport.Noidung) && tbImport.tbImportDetails.Count > 0)
                        tbImport.Noidung = tbImport.tbImportDetails[0].Ten;

                    // Lưu
                    if (chkDauvao.Checked)
                    {
                        Xuly711(tbImport);
                        lstdsVao.Add(tbImport);
                    }
                    else
                    {
                        Xuly5211(tbImport);
                        lstdsRa.Add(tbImport);
                    }

                    await SaveDataXmlOne(tbImport, int.Parse(type));
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Lỗi đọc file {pathXml}: {ex.Message}");
                // Nếu cần UI, dùng Invoke để tránh deadlock
                // this.Invoke(new Action(() => XtraMessageBox.Show($"Lỗi: {ex.Message}")));
            }
        }
        private class HHDVuInfo
        {
            public string Ten { get; set; }
            public int TChat { get; set; }
            public string DVT { get; set; }
            public double SoLuong { get; set; }
            public double DonGia { get; set; }
            public double ThTien { get; set; }
        }
        List<string> accountCodes = new List<string>(new[] { "5113", "5112", "5111" });

        public void Xuly711(TbImport fileImport)
        {
            var getlist711 = fileImport.tbImportDetails.Where(m => m.TKCo == "711").ToList();

            if (getlist711.Count > 0 && tbLicense.Rows[0].Field<string>("col711") == "1")
            {
                List<TbImportDetail> listdathuchien = new List<TbImportDetail>();

                //Trường hợp chỉ có 1 dòng 711
                //Lấy ra dòng 711;
                if (getlist711.Count == 1)
                {
                    var get711 = getlist711.Where(m => m.TKCo == "711").FirstOrDefault();
                    if (get711 != null)
                    {
                        string pattern = @"\d+"; // Tìm một hoặc nhiều chữ số

                        Match match = Regex.Match(get711.Ten, pattern);
                        double percent = 0;
                        //Kiển tra xem có phải chiết khấu có % không
                        if (match.Success && get711.Ten.Contains("%"))
                        {
                            percent = double.Parse(match.Value);

                        }
                        //Phải tự tính %
                        else
                        {
                            percent = Math.Round(get711.TTien / (fileImport.TgTCThue) * 100, 2);
                        }
                        double fnpercent = 1 - percent / 100;
                        //Tính lại giá tiền cho các dòng
                        var remainlist = fileImport.tbImportDetails.Where(m => m != get711 && !string.IsNullOrEmpty(m.DVT) && m.Dongia != 0).ToList();
                        int index = 0;
                        double sumtotal = 0;

                        double totalth = remainlist.Sum(m => m.TTien);
                        double total711 = get711.TTien;
                        foreach (var it2 in remainlist)
                        {
                            if (index < remainlist.Count - 1)
                            {
                                it2.TTien = Math.Round(it2.TTien - (total711 * it2.TTien / totalth));
                            }
                            else
                            {
                                it2.TTien = Math.Round(it2.TTien - (total711 * it2.TTien / totalth));
                                double reTotal = Math.Round(fileImport.TgTCThue - remainlist.Sum(m => m.TTien));
                                it2.TTien += reTotal;
                            }
                            //Cập nhật vô database
                           
                            index += 1;
                        }
                        //Xoá đi dòng 711
                        fileImport.tbImportDetails.Remove(get711);
                    }

                }
                //Trường hợp có nhiều 711
                else
                {
                    var get771s = getlist711.Where(m => m.TKCo == "711").ToList();
                    int finddata = 0;
                    foreach (var i7 in get771s)
                    {
                        //string pattern = @"(\d+[,.]?\d*)%|chiết khấu\s*(\d+)";


                        //var match = Regex.Match(i7.Ten, pattern);
                        //double percent = 0;
                        //if (match.Success)
                        //{
                        //    string soChietKhau = match.Groups[1].Value;
                        //    if (string.IsNullOrEmpty(soChietKhau))
                        //    {
                        //        soChietKhau = match.Groups[2].Value;
                        //    }
                        //    soChietKhau = soChietKhau.Replace(",", ".");
                        //    percent = double.Parse(soChietKhau);
                        //    foreach (var ftt in fileImport.tbImportDetails.Where(m => m.TKCo != "711"))
                        //    {
                        //        var sodu = Math.Round(ftt.TTien * percent / 100) - i7.TTien;
                        //        if (sodu >= 0 && sodu <= 1)
                        //        {
                        //            finddata += 1;
                        //            ftt.TTien = ftt.TTien - i7.TTien;
                        //            listdathuchien.Add(i7);
                        //        }
                        //    }

                        //}
                        fileImport.tbImportDetails.Remove(i7);
                    }
                    //Trường hợp ko tìm dc thì buộc phải tìm % để phân bổ



                    //if (finddata != get771s.Count)
                    if (1<2)
                    {

                        //Tính lại giá tiền cho các dòng
                        var remainlist = fileImport.tbImportDetails.Where(m => m.TKCo != "711" && !string.IsNullOrEmpty(m.DVT) && m.Dongia != 0).ToList();
                        double totalth = remainlist.Sum(m => m.TTien);
                        double total711 = get771s.Sum(m => m.TTien);
                        int index = 0;
                        foreach (var it2 in remainlist)
                        {
                            if (remainlist.Count > 1)
                            {
                                if (index < remainlist.Count - 1)
                                {
                                    it2.TTien = Math.Round(it2.TTien - (total711 * it2.TTien / totalth));
                                }
                                else
                                {
                                    it2.TTien = Math.Round(it2.TTien - (total711 * it2.TTien / totalth));
                                    double reTotal = Math.Round(fileImport.TgTCThue - remainlist.Sum(m => m.TTien));
                                    it2.TTien += reTotal;
                                }
                            }
                            else
                            {
                                it2.TTien = Math.Round(it2.TTien - (total711 * it2.TTien / totalth));
                            }
                            index += 1;
                        }
                       
                    }
                }

            }
            else
            {
                if (getlist711.Count > 1)
                {
                    var getfirst = getlist711.FirstOrDefault();
                    var lstremain = getlist711.Skip(1).ToList();
                    //Cập nhật lại tổng tiền cho first
                    getfirst.TTien = getfirst.TTien + lstremain.Sum(m => m.TTien);

                    //Xoá các dòng thừa
                    foreach (var it in lstremain)
                    {
                        fileImport.tbImportDetails.Remove(it);
                    }
                }
            }
        }
        public void Xuly5211(TbImport fileImport)
        {
            if (tbLicense.Rows[0].Field<string>("col711ra") == "1")
            {
                //Trường hợp có 5113
                var kiemtra5113 = fileImport.tbImportDetails.Where(m => m.TKCo.Contains("5113")).FirstOrDefault();
                if (kiemtra5113 != null)
                {
                    var find5211 = fileImport.tbImportDetails.Where(m => m.Tchat == 3).ToList();
                    if (find5211 != null && find5211.Count > 0)
                    {
                        //Cập nhật giảm trừ cho tk 5113 đầu tiên
                        kiemtra5113.TTien -= find5211.Sum(m => m.TTien);
                        //Cập nhật trong database 
                        //Thực hiện xoá dòng 5211
                        foreach (var r52 in find5211)
                        { 
                            fileImport.tbImportDetails.Remove(r52);
                        } 
                        return;
                    }
                }
            }
            foreach (var code in accountCodes)
            {
                if (fileImport.tbImportDetails.Any(m => m.TKCo.Contains(code)))
                {
                    var find5211 = fileImport.tbImportDetails.Where(m => m.Tchat == 3).ToList();
                    //Xoá và gộp 5211
                    var first5211 = find5211.FirstOrDefault();
                    var lst5211remain = find5211.Where(m => m != first5211).ToList();
                    if (first5211 != null)
                    {
                        first5211.TTien += lst5211remain.Sum(m => m.TTien);
                        first5211.TKNo = fileImport.tbImportDetails
                            .FirstOrDefault(m => m.TKCo.Contains(code))?.TKCo;
                        first5211.TKCo = "";
                    }
                    //Xoá remain
                    foreach (var it in lst5211remain)
                    { 
                        fileImport.tbImportDetails.Remove(it);
                    }
                    return;
                }
            }
        }
        public void GetKNMXML(string nbmst, string khhdon, string shdon, string tokken,DateTime GetNLap,string path,string filename)
        {
            GDTClient.UpdateToken(tokken);
            string url = $"https://hoadondientu.gdt.gov.vn:30000/query/invoices/detail?nbmst={nbmst}&khhdon={khhdon}&shdon={shdon}&khmshdon=1";
             
            using (var client = new HttpClient())
            {
                //client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", tokken);
                //client.DefaultRequestHeaders.Accept.Add(new MediaTypeWithQualityHeaderValue("application/json"));

                try
                {
                    // Gửi yêu cầu GET đồng bộ
                    string responseBody = Task.Run(async () => await GDTClient.GetJsonAsync(url)).Result;
                    var rootObject = JsonConvert.DeserializeObject<Invoice>(responseBody);
                    // Tạo phần tử gốc <HDon>
                    TaoFileXmlChiCoDLHDon(path, filename.Replace(".zip",""), rootObject,GetNLap);
                    currentProgress += 1;

                   string ph = Path.Combine( path, filename.Replace(".zip","_KNM.xml"));
                    DocfileXmlOne(ph, currentIndex);
                    progressPanel1.Caption = $"Đang đọc file thứ {currentProgress} / {totalInvoices}";
                }
                catch (HttpRequestException e)
                {
                    Console.WriteLine($"Request error: {e.Message}");
                }
            }
        }
        public static string TaoFileXmlChiCoDLHDon(string folderPath, string fileName = "HDon_44020.xml", Invoice Invoice=default,DateTime NLap=default)
        {
            // Tạo thư mục nếu chưa có
            if (!Directory.Exists(folderPath))
                Directory.CreateDirectory(folderPath); 
            fileName = $"{fileName}_KNM.xml";
            string fullPath = Path.Combine(folderPath, fileName);

            XmlDocument doc = new XmlDocument();
            XmlElement root = doc.CreateElement("HDon");
            doc.AppendChild(root);

            // ==================== <DLHDon> ====================
            XmlElement dlHDon = doc.CreateElement("DLHDon");
            dlHDon.SetAttribute("Id", "DuLieuKy");
            root.AppendChild(dlHDon);

            // ---- TTChung ----
            XmlElement ttChung = doc.CreateElement("TTChung");
            dlHDon.AppendChild(ttChung);

            ThemPhanTu(doc, ttChung, "PBan", $"{Invoice.Pban}");
            ThemPhanTu(doc, ttChung, "THDon", $"Hóa đơn GTGT");
            ThemPhanTu(doc, ttChung, "KHMSHDon", $"{Invoice.Khmshdon}");
            ThemPhanTu(doc, ttChung, "KHHDon", $"{Invoice.Khhdon}");
            ThemPhanTu(doc, ttChung, "SHDon", $"{Invoice.Shdon}");
            ThemPhanTu(doc, ttChung, "NLap", $"{NLap}");
            ThemPhanTu(doc, ttChung, "HDCTTChinh", "0");
            ThemPhanTu(doc, ttChung, "DVTTe", $"{Invoice.Dvtte}");
            ThemPhanTu(doc, ttChung, "TGia", $"{Invoice.Tgia}");
            ThemPhanTu(doc, ttChung, "HTTToan", $"{Invoice.Thtttoan}");
            ThemPhanTu(doc, ttChung, "MSTTCGP", $"{Invoice.Msttcgp}");

            // TTKhac trong TTChung
            XmlElement ttKhacChung = doc.CreateElement("TTKhac");
            XmlElement tTin1 = TaoTTin(doc, "Extra", "string", "ThuyUyen.Nguyen@britishcouncil.org");
            ttKhacChung.AppendChild(tTin1);
            ttChung.AppendChild(ttKhacChung);

            // ---- NDHDon ----
            XmlElement ndHDon = doc.CreateElement("NDHDon");
            dlHDon.AppendChild(ndHDon);

            // NBan
            XmlElement nBan = doc.CreateElement("NBan");
            ThemPhanTu(doc, nBan, "Ten", $"{Invoice.Nbten}");
            ThemPhanTu(doc, nBan, "MST", $"{Invoice.Nbmst}");
            ThemPhanTu(doc, nBan, "DChi", $"{Invoice.Nbdchi}");
            ThemPhanTu(doc, nBan, "SDThoai", $"{Invoice.Nbsdthoai}");
            ndHDon.AppendChild(nBan);

            // NMua
            XmlElement nMua = doc.CreateElement("NMua");
            ThemPhanTu(doc, nMua, "Ten", $"{Invoice.Nmten}");
            ThemPhanTu(doc, nMua, "MST", $"{Invoice.Nmmst}");
            ThemPhanTu(doc, nMua, "DChi", $"{Invoice.Nmdchi}");
            ThemPhanTu(doc, nMua, "MKHang", $"{Invoice.Mkhang}");
            ThemPhanTu(doc, nMua, "HVTNMHang", "");
            ndHDon.AppendChild(nMua);

            // DSHHDVu
            XmlElement dsHHDVu = doc.CreateElement("DSHHDVu");
            ndHDon.AppendChild(dsHHDVu);

            // Hàng hóa dịch vụ 1
            int stt = 1;
            foreach(var dt in Invoice.Hdhhdvu.ToList())
            {
                TaoHangHoa(doc, dsHHDVu, "0", $"{stt}",!string.IsNullOrEmpty(dt.Ten)? $"{dt.Ten}":"Hoá đơn không nhận mã", $"{dt.Dvtinh}", $"{dt.Sluong}", $"{dt.Dgia}", $"{dt.Tsuat.Value*100}", $"{dt.Thtien}",
              new[] { ("Amount", "numeric", $"{dt.Thtien}"), ("VATAmount", "numeric", "0") });
                stt++;
            }
          
 
            // TToan
            XmlElement tToan = doc.CreateElement("TToan");
            ndHDon.AppendChild(tToan);

            // TTKhac trong TToan
            XmlElement ttKhacToan = doc.CreateElement("TTKhac");
            ttKhacToan.AppendChild(TaoTTin(doc, "ServiceProvided", "String", "Le phi thi"));
            ttKhacToan.AppendChild(TaoTTin(doc, "Location", "String", "British Council Ho Chi Minh City"));
            ttKhacToan.AppendChild(TaoTTin(doc, "Datasource", "String", "ORS2"));
            tToan.AppendChild(ttKhacToan);

            // Tổng hợp thuế suất
            XmlElement tHTTLTSuat = doc.CreateElement("THTTLTSuat");
            XmlElement lTSuat = doc.CreateElement("LTSuat");
            ThemPhanTu(doc, lTSuat, "TSuat", $"{Invoice.Hdhhdvu.FirstOrDefault()?.Tsuat.Value*100}");
            ThemPhanTu(doc, lTSuat, "TThue", $"{Invoice.Tgtthue}");
            ThemPhanTu(doc, lTSuat, "ThTien", $"{Invoice.Tgtttbso}");
            tHTTLTSuat.AppendChild(lTSuat);
            tToan.AppendChild(tHTTLTSuat);

            ThemPhanTu(doc, tToan, "TgTCThue", $"{Invoice.Tgtcthue}");
            ThemPhanTu(doc, tToan, "TgTThue", $"{Invoice.Tgtthue}");
            ThemPhanTu(doc, tToan, "TTCKTMai", $"{Invoice.Ttcktmai}");
            ThemPhanTu(doc, tToan, "TgTTTBSo", $"{Invoice.Tgtttbso}");
            ThemPhanTu(doc, tToan, "TgTTTBChu", $"{Invoice.Tgtttbchu}");

            // Lưu file đẹp
            XmlWriterSettings settings = new XmlWriterSettings
            {
                Indent = true,
                IndentChars = "  ",
                NewLineChars = "\r\n",
                Encoding = System.Text.Encoding.UTF8
            };

            using (XmlWriter writer = XmlWriter.Create(fullPath, settings))
            {
                doc.Save(writer);
            }

            return fullPath;
        }

        // Hàm phụ trợ
        static void ThemPhanTu(XmlDocument doc, XmlElement parent, string ten, string giaTri)
        {
            XmlElement e = doc.CreateElement(ten);
            e.InnerText = giaTri;
            parent.AppendChild(e);
        }

        static XmlElement TaoTTin(XmlDocument doc, string tTruong, string kDLieu, string dLieu)
        {
            XmlElement ttin = doc.CreateElement("TTin");
            ThemPhanTu(doc, ttin, "TTruong", tTruong);
            ThemPhanTu(doc, ttin, "KDLieu", kDLieu);
            ThemPhanTu(doc, ttin, "DLieu", dLieu);
            return ttin;
        }

        static void TaoHangHoa(XmlDocument doc, XmlElement ds, string tChat, string stt, string tenHang, string dvTinh,
            string sl, string dGia, string tSuat, string thTien, (string truong, string kieu, string giaTri)[] extra)
        {
            XmlElement hh = doc.CreateElement("HHDVu");
            ThemPhanTu(doc, hh, "TChat", tChat);
            ThemPhanTu(doc, hh, "STT", stt);
            ThemPhanTu(doc, hh, "THHDVu", tenHang);
            if (!string.IsNullOrEmpty(dvTinh)) ThemPhanTu(doc, hh, "DVTinh", dvTinh);
            ThemPhanTu(doc, hh, "SLuong", sl);
            ThemPhanTu(doc, hh, "DGia", dGia);
            ThemPhanTu(doc, hh, "TSuat", tSuat);
            ThemPhanTu(doc, hh, "ThTien", thTien);

            XmlElement ttKhac = doc.CreateElement("TTKhac");
            foreach (var item in extra)
                ttKhac.AppendChild(TaoTTin(doc, item.truong, item.kieu, item.giaTri));

            hh.AppendChild(ttKhac);
            ds.AppendChild(hh);
        }
        public void DocfileExcelRa()
        {
            
            string directoryPath = Path.Combine(savedPath, "HDRa", dtTungay.DateTime.Month.ToString());

            var excelFiles = Directory.EnumerateFiles(directoryPath, "*.xlsx", SearchOption.AllDirectories).Where(m => m.Contains(mstcongty)).ToList();
            tongsohodadon = excelFiles.Count;
            int i = 1;
            foreach (var excelFile in excelFiles)
            {
                using (var workbook = new XLWorkbook(excelFile))

                {
                    var worksheet = workbook.Worksheet(1); // Lấy sheet đầu tiên
                    foreach (var row in worksheet.RowsUsed().Skip(3)) // Bỏ qua 6 hàng đầu tiên
                    {
                        string khhd = row.Cell("B").Value.ToString(); // Lấy giá trị của cột A trong hàng hiện tại
                        string getSHHD = row.Cell("C").Value.ToString(); // Lấy giá trị của cột A trong hàng hiện tại
                        string getSohd = Helpers.RemoveLeadingZeros(row.Cell("D").Value.ToString()); // Lấy giá trị của cột C trong hàng hiện tại 
                        string GetNLap = row.Cell("E").Value.ToString();
                        string mstnb = row.Cell("F").Value.ToString();

                        //Kiểm tra từ ngày đến ngày
                        DateTime getdate = DateTime.Parse(GetNLap);
                        if (getdate < dtTungay.DateTime || getdate > dtDenngay.DateTime)
                            continue;

                        //Kiểm tra xem hoá đơn đã có trong bảng tbimport chưa
                        //var checkFile=tbimport.AsEnumerable().Where()
                        //Tải file xml
                        string url = "";
                        if (i == 1)
                            url = $"https://hoadondientu.gdt.gov.vn:30000/sco-query/invoices/export-xml?nbmst={mstcongty}&khhdon={getSHHD}&shdon={getSohd}&khmshdon={khhd}";
                        if (i ==2)
                        {
                            url = $"https://hoadondientu.gdt.gov.vn:30000/query/invoices/export-xml?nbmst={mstcongty}&khhdon={getSHHD}&shdon={getSohd}&khmshdon={khhd}";
                            //https://hoadondientu.gdt.gov.vn:30000/sco-query/invoices/export-xml?nbmst=0316158113-006&khhdon=C25MVX&shdon=660264&khmshdon=1

                        }
                        string pathravao = "HDRa";
                        string filename = $"{mstcongty}_{getSohd}_{getSHHD}.zip";
                        string filenameCheck = $"{mstcongty}_{getSohd}_{getSHHD}.html";
                        string path = Path.Combine(savedPath, pathravao, dtTungay.DateTime.Month.ToString(), filename);
                        string pathcheck = Path.Combine(savedPath, pathravao, dtTungay.DateTime.Month.ToString(), filenameCheck);

                        //Kiểm tra nếu hoá đơn chưa dc tải thì tải về
                        if (!File.Exists(pathcheck))
                        {
                            using (var client = new HttpClient())
                            {
                                client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", tokken);
                                client.DefaultRequestHeaders.Accept.Add(new MediaTypeWithQualityHeaderValue("application/octet-stream"));

                                try
                                {
                                    HttpResponseMessage response = client.GetAsync(url).Result; // Sử dụng .Result
                                    response.EnsureSuccessStatusCode(); // Ném ngoại lệ nếu không thành công

                                    // Đọc nội dung phản hồi dưới dạng byte
                                    var fileBytes = response.Content.ReadAsByteArrayAsync().Result;

                                    // Lưu file ZIP bằng FileStream
                                    using (var fileStream = new FileStream(path, FileMode.Create, FileAccess.Write, FileShare.None, bufferSize: 4096))
                                    {
                                        fileStream.Write(fileBytes, 0, fileBytes.Length);
                                    }

                                    Console.WriteLine($"File ZIP đã được lưu tại: {path}");
                                    ExtractZipXML(path); // Giải nén file ZIP
                                    //progressPanel1.Caption = $"Đang đọc hoá đơn";
                                    //Application.DoEvents();
                                }
                                catch (Exception ex)
                                {
                                    Console.WriteLine($"Đã xảy ra lỗi: {ex.Message}");
                                }
                            }
                        }
                    }
                }
                i++;
            }
        }
        public async Task DocfileExcelRaAsync()
        {
            totalInvoices = 0;
            currentProgress = 0;
            GDTClient.UpdateToken(tokken);
            string directoryPath = Path.Combine(savedPath, "HDRa", dtTungay.DateTime.Month.ToString());

            var excelFiles = Directory.EnumerateFiles(directoryPath, "*.xlsx", SearchOption.AllDirectories).Where(m => m.Contains(mstcongty)).ToList();
            // Đếm tổng số hóa đơn cần xử lý (để hiển thị tiến độ chính xác)
            foreach (var excelFile in excelFiles)
            {
                using (var workbook = new XLWorkbook(excelFile))
                {
                    var worksheet = workbook.Worksheet(1);
                    foreach (var row in worksheet.RowsUsed().Skip(3))
                    {
                        string GetNLap = row.Cell("E").Value.ToString();
                        string getSohd = Helpers.RemoveLeadingZeros(row.Cell("D").Value.ToString()); // Lấy giá trị của cột C trong hàng hiện tại 
                        string mstnm = row.Cell("H").Value.ToString();
                        if (DateTime.TryParse(GetNLap, out DateTime getdate))
                        {
                            DateTime gd = DateTime.Parse(GetNLap);
                            bool daTonTai = false;
                            bool daTonTaiimport = false;
                            if (!string.IsNullOrEmpty(mstnm))
                            {
                                daTonTai = lookupHoaDonCT.Contains((mstnm, getSohd, gd.Date));
                                daTonTaiimport = lookupTbImport.Contains((mstnm, getSohd, getdate.Date));
                            }
                            else
                            {
                                daTonTai = lookupHoaDonCT.Any(x => x.NLap == gd.Date && x.SoHD == getSohd);
                                daTonTaiimport= lookupTbImport.Any(x=>x.NLap==getdate.Date && x.SHDon==getSohd);
                            }
                            
                            if (getdate < dtTungay.DateTime || getdate > dtDenngay.DateTime || daTonTai || daTonTaiimport)
                            {
                                continue;
                            }
                            totalInvoices++;
                        }
                    }
                }
            }
            
            //Nếu tổng =0 thì dừng luôn
                if(totalInvoices==0)
            {
                //XtraMessageBox.Show("Không còn hoá đơn nào xử lý");
