                    ));
                tbNhapkhonguyenlieu = await Task.Run(() =>
             ExecuteQuery("SELECT * FROM tbNhapkhonguyenlieu", null)
         );

                // 8. Hóa đơn (DÙNG TUPLE)
                existingTbHoadon = await Task.Run(() =>
                    ExecuteQuery("SELECT * FROM HoaDon", null)
                );

                _hoadonLookup = existingTbHoadon.AsEnumerable()
                    .ToLookup(r => (
                        SoHD: r.Field<string>("SoHD"),
                        KyHieu: r.Field<string>("KyHieu")
                    ));

                // 9. Tồn kho
                tbTonkho = await Task.Run(() =>
                    ExecuteQuery("SELECT * FROM TonKho", null)
                );

                // 10. Nhập kho thành phẩm
                tbNhapkhotp = await Task.Run(() =>
                    ExecuteQuery("SELECT * FROM tbNhapkhotp", null)
                );



                _lookupBySoHieu = lstvt
            .Where(v => !string.IsNullOrEmpty(v.SoHieu))
            .ToDictionary(
                v => v.SoHieu,               // Key
                v => v,                      // Value
                StringComparer.OrdinalIgnoreCase  // Comparer
            );
            }
            if(xtraTabControl2.SelectedTabPageIndex == 4)
            {
                simpleButton11.PerformClick();
            }
        }

